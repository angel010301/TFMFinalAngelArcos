@prefix : <http://www.semanticweb.org/ontologies/2026/bibliomaker#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/ontologies/2026/bibliomaker#> .

<http://www.semanticweb.org/ontologies/2026/bibliomaker> rdf:type owl:Ontology ;
                                                          <http://purl.org/dc/elements/1.1/contributor> "Martín Vega, Consuelo"@es ,
                                                                                                        "Morales del Castillo, José Manuel"@es ;
                                                          <http://purl.org/dc/elements/1.1/creator> "Arcos Sánchez, Ángel"@es ;
                                                          <http://purl.org/dc/elements/1.1/date> "2026-06-01T16:00:00"@es ;
                                                          <http://purl.org/dc/elements/1.1/description> "El vocabulario articula cuatro superclases principales para estructurar el dominio (Equipamiento, Consumible, Usuario y Gestión). El diseño lógico establece propiedades de datos para registrar los atributos inmutables del hardware y propiedades de objeto direccionales que resuelven las tripletas lógicas entre la maquinaria tecnológica, el material fungible dependiente y la interacción administrativa humana dentro del recinto."@es ,
                                                                                                        "La instanciación de este esquema semántico responde a la necesidad institucional y operativa de estandarizar los procesos internos de un laboratorio de fabricación digital. Mediante la aplicación de principios de ingeniería ontológica, se persigue mitigar la ambigüedad documental en el inventario y garantizar la interoperabilidad y reutilización de los datos de soporte logístico a largo plazo."@es ;
                                                          <http://purl.org/dc/elements/1.1/identifier> "http://www.semanticweb.org/ontologies/2026/bibliomaker"@es ;
                                                          <http://purl.org/dc/elements/1.1/title> "Ontología para la Gestión Integral de espacios Maker en Bibliotecas Universitarias."@es ;
                                                          <http://purl.org/dc/terms/abstract> "El presente modelo semántico establece la estructura lógica conceptual para la gestión integral de espacios maker en Bibliotecas Universitarias. Su diseño abarca la categorización jerárquica del equipamiento de fabricación digital, el control logístico de los materiales consumibles y la trazabilidad de los flujos burocráticos, incluyendo reservas, capacitación técnica y reportes de mantenimiento por parte de la comunidad universitaria."@es ;
                                                          <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by-nc-sa/4.0/"@es ;
                                                          owl:versionInfo "1.0.3"@es .

