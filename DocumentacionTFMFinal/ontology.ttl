                            [ rdf:type owl:Restriction ;
                              owl:onProperty :seccionaPlancha ;
                              owl:someValuesFrom :PlanchaRigida
                            ] ;
            rdfs:comment "Sistemas de seccionado y grabado por haz de luz concentrada. Se recomienda encarecidamente el uso de gafas de protección durante el uso de este equipo."@es ;
