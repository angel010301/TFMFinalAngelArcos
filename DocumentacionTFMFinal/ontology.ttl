#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/ontologies/2026/bibliomaker#acondiciona
:acondiciona rdf:type owl:ObjectProperty ;
             owl:inverseOf :esAcondicionadoPor ;
             rdfs:domain :SecadorFilamento ;
             rdfs:range :Filamento3D ;
             rdfs:comment "Enlace físico que vincula el dispositivo de control térmico periférico directamente con el material fungible al que le extrae la humedad, garantizando sus propiedades mecánicas antes del proceso de fabricación"@es ;
             rdfs:label "Acondiciona"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#acoplaBrazo
:acoplaBrazo rdf:type owl:ObjectProperty ;
             owl:inverseOf :brazoEsAcopladoEn ;
             rdfs:domain :HerramientaRotativa ;
             rdfs:range :AccesorioBrazoHerramientaRotativa ;
             rdfs:comment "Enlace físico que vincula una herramienta motorizada de mecanizado manual con los brazos extensores, soportes o guías de profundidad necesarios para estabilizar y controlar su trayectoria espacial"@es ;
             rdfs:label "Acopla brazo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#acoplaModuloTermico
:acoplaModuloTermico rdf:type owl:ObjectProperty ;
                     owl:inverseOf :moduloTermicoEsAcopladoEn ;
                     rdfs:domain :PrensaTermica ;
                     rdfs:range :AdaptadoresPrensa ;
                     rdfs:comment "Conexión física que asocia la base principal de presión y calor con las distintas resistencias periféricas intercambiables, necesarias para transferir diseños sobre superficies no planas"@es ;
                     rdfs:label "Acopla módulo térmico"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#avisoEsEmitidoPor
:avisoEsEmitidoPor rdf:type owl:ObjectProperty ;
                   owl:inverseOf :emiteAviso ;
                   rdfs:domain :IncidenciaTecnica ;
                   rdfs:range :Administradores ;
                   rdfs:comment "Enlace de trazabilidad que asocia a individuo registrado en el espacio como administrador con la generación de un reporte de mantenimiento, ya sea por avería de hardware o por agotamiento de consumibles, cerrando el ciclo de notificación"@es ;
                   rdfs:label "Aviso es emitido por"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#brazoEsAcopladoEn
:brazoEsAcopladoEn rdf:type owl:ObjectProperty ;
                   rdfs:domain :AccesorioBrazoHerramientaRotativa ;
                   rdfs:range :HerramientaRotativa ;
                   rdfs:comment "Enlace físico que vincula una herramienta motorizada de mecanizado manual con los brazos extensores, soportes o guías de profundidad necesarios para estabilizar y controlar su trayectoria espacial"@es ;
                   rdfs:label "Brazo es acoplado en"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#consumeMaterial
:consumeMaterial rdf:type owl:ObjectProperty ;
                 owl:inverseOf :materialEsConsumidoPor ;
                 rdfs:domain :EventoPrestamo ;
                 rdfs:range :Consumible ;
                 rdfs:comment "Enlace físico de carácter opcional que asocia directamente la maquinaria con el material fungible que necesita cargar para funcionar, aplicable exclusivamente a los dispositivos de fabricación o desgaste, permitiendo cruzar el nivel de stock con la viabilidad técnica de la máquina"@es ;
                 rdfs:label "Consume material"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#emiteAviso
:emiteAviso rdf:type owl:ObjectProperty ;
            rdfs:domain :Administradores ;
            rdfs:range :IncidenciaTecnica ;
            rdfs:comment "Enlace de trazabilidad que asocia a individuo registrado en el espacio como administrador con la generación de un reporte de mantenimiento, ya sea por avería de hardware o por agotamiento de consumibles, cerrando el ciclo de notificación"@es ;
            rdfs:label "Emite aviso"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#empleaEquipamiento
:empleaEquipamiento rdf:type owl:ObjectProperty ;
                    owl:inverseOf :equipamientoEsEmpleadoEn ;
                    rdfs:domain :EventoPrestamo ;
                    rdfs:range :Equipamiento ;
                    rdfs:comment "Enlace logístico opcional que determina qué elementos del inventario físico son susceptibles de cesión temporal"@es ;
                    rdfs:label "Emplea equipamiento"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#equipamientoEsEmpleadoEn
:equipamientoEsEmpleadoEn rdf:type owl:ObjectProperty ;
                          rdfs:domain :Equipamiento ;
                          rdfs:range :EventoPrestamo ;
                          rdfs:comment "Enlace logístico opcional que determina qué elementos del inventario físico son susceptibles de cesión temporal"@es ;
                          rdfs:label "Equipamiento es empleado en"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#esAcondicionadoPor
:esAcondicionadoPor rdf:type owl:ObjectProperty ;
                    rdfs:domain :Filamento3D ;
                    rdfs:range :SecadorFilamento ;
                    rdfs:comment "Enlace físico que vincula el dispositivo de control térmico periférico directamente con el material fungible al que le extrae la humedad, garantizando sus propiedades mecánicas antes del proceso de fabricación"@es ;
                    rdfs:label "Es acondicionado por"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#esRebobinadoPor
:esRebobinadoPor rdf:type owl:ObjectProperty ;
                 owl:inverseOf :rebobina ;
                 rdfs:domain :Filamento3D ;
                 rdfs:range :RebobinadorFilamento ;
                 rdfs:comment "Enlace físico operativo que vincula el hardware de mantenimiento con la bobina de material termoplástico que requiere corregir su alineación o distribución de espiras antes de pasar a fabricación"@es ;
                 rdfs:label "Es rebobinado por"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#esRequeridoComoSoportePor
:esRequeridoComoSoportePor rdf:type owl:ObjectProperty ;
                           owl:inverseOf :requiereSoporteObjetivo ;
                           rdfs:domain :SoporteObjetivo ;
                           rdfs:range :ViniloCorte ;
                           rdfs:comment "Enlace de dependencia logística que asocia un material de transferencia térmica, como el vinilo textil o el papel de sublimación, con la superficie física en blanco necesaria para anclar el diseño de forma permanente mediante la aplicación de calor y presión en la prensa"@es ;
                           rdfs:label "Es requerido como soporte por"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#esRequeridoPor
:esRequeridoPor rdf:type owl:ObjectProperty ;
                owl:inverseOf :requiere ;
                rdfs:domain :MedioAuxiliar ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( :CortadoraVinilo
                                           :Soldadura_y_Ensamblaje
                                           :TratamientoCromatico
                                         )
                           ] ;
                rdfs:comment "Conexión que justifica la existencia del papel transportador en el almacén al vincularlo exclusivamente con los sustratos adhesivos que exigen un traslado en bloque"@es ;
                rdfs:label "Es requerido por"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#esSupervisadoPor
:esSupervisadoPor rdf:type owl:ObjectProperty ;
                  owl:inverseOf :supervisa ;
                  rdfs:domain :EventoPrestamo ;
                  rdfs:range :Administradores ;
                  rdfs:label "Es supervisado por"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#incidenciaEsRegistradaEn
:incidenciaEsRegistradaEn rdf:type owl:ObjectProperty ;
                          owl:inverseOf :registraIncidencia ;
                          rdfs:domain :IncidenciaTecnica ;
                          rdfs:range :EventoPrestamo ;
                          rdfs:comment "Conexión de trazabilidad que vincula directamente un dispositivo físico con el parte de avería abierto en el sistema, permitiendo auditar su historial de fallos y paradas operativas"@es ;
                          rdfs:label "Incidencia es registrada en"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#materialEsConsumidoPor
:materialEsConsumidoPor rdf:type owl:ObjectProperty ;
                        rdfs:domain :Consumible ;
                        rdfs:range :EventoPrestamo ;
                        rdfs:comment "Enlace físico de carácter opcional que asocia directamente la maquinaria con el material fungible que necesita cargar para funcionar, aplicable exclusivamente a los dispositivos de fabricación o desgaste, permitiendo cruzar el nivel de stock con la viabilidad técnica de la máquina"@es ;
                        rdfs:label "Material es consumido por"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#moduloTermicoEsAcopladoEn
:moduloTermicoEsAcopladoEn rdf:type owl:ObjectProperty ;
                           rdfs:domain :AdaptadoresPrensa ;
                           rdfs:range :PrensaTermica ;
                           rdfs:comment "Conexión física que asocia la base principal de presión y calor con las distintas resistencias periféricas intercambiables, necesarias para transferir diseños sobre superficies no planas"@es ;
                           rdfs:label "Módulo térmico es acoplado en"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#operaA
:operaA rdf:type owl:ObjectProperty ;
        owl:inverseOf :seOperaMediante ;
        rdfs:domain :OrdenadorEstacionTrabajo ;
        rdfs:range :Equipamiento ;
        rdfs:comment "Enlace técnico de carácter opcional que asocia un equipo de fabricación aditiva, sustractiva o digitalización con el terminal informático dedicado a su control y envío de instrucciones). Dominio: SIN ACOTAR (Axiomatizado mediante restricciones existenciales a nivel de clase"@es ;
        rdfs:label "Opera a"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#planchaSeccionadaPor
:planchaSeccionadaPor rdf:type owl:ObjectProperty ;
                      owl:inverseOf :seccionaPlancha ;
                      rdfs:domain :PlanchaRigida ;
                      rdfs:range :CorteLaser ;
                      rdfs:comment "Enlace operativo que asocia directamente la maquinaria de corte por haz de luz, con la tipología exacta de material fungible sobre el que interviene para ejecutar su trabajo"@es ;
                      rdfs:label "Plancha seccionada por"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#prestamoEsSolicitadoPor
:prestamoEsSolicitadoPor rdf:type owl:ObjectProperty ;
                         owl:inverseOf :solicitaPrestamo ;
                         rdfs:domain :EventoPrestamo ;
                         rdfs:range :Usuario ;
                         rdfs:comment "Enlace logístico que vincula a un miembro de la comunidad académica con el registro de movimiento temporal de inventario, asociando la responsabilidad del cuidado del hardware al perfil del solicitante durante el periodo establecido"@es ;
                         rdfs:label "Préstamo es solicitado por"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#rebobina
:rebobina rdf:type owl:ObjectProperty ;
          rdfs:domain :RebobinadorFilamento ;
          rdfs:range :Filamento3D ;
          rdfs:comment "Enlace físico operativo que vincula el hardware de mantenimiento con la bobina de material termoplástico que requiere corregir su alineación o distribución de espiras antes de pasar a fabricación"@es ;
          rdfs:label "Rebobina"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#registraIncidencia
:registraIncidencia rdf:type owl:ObjectProperty ;
                    rdfs:domain :EventoPrestamo ;
                    rdfs:range :IncidenciaTecnica ;
                    rdfs:comment "Conexión de trazabilidad que vincula directamente un dispositivo físico con el parte de avería abierto en el sistema, permitiendo auditar su historial de fallos y paradas operativas"@es ;
                    rdfs:label "Registra incidencia"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#requiere
:requiere rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :CortadoraVinilo
                                      :Soldadura_y_Ensamblaje
                                      :TratamientoCromatico
                                    )
                      ] ;
          rdfs:range :MedioAuxiliar ;
          rdfs:comment "Conexión que justifica la existencia del papel transportador en el almacén al vincularlo exclusivamente con los sustratos adhesivos que exigen un traslado en bloque"@es ;
          rdfs:label "Requiere"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereSoporteObjetivo
:requiereSoporteObjetivo rdf:type owl:ObjectProperty ;
                         rdfs:domain :ViniloCorte ;
                         rdfs:range :SoporteObjetivo ;
                         rdfs:comment "Enlace de dependencia logística que asocia un material de transferencia térmica, como el vinilo textil o el papel de sublimación, con la superficie física en blanco necesaria para anclar el diseño de forma permanente mediante la aplicación de calor y presión en la prensa"@es ;
                         rdfs:label "Requiere soporte objetivo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#seOperaMediante
:seOperaMediante rdf:type owl:ObjectProperty ;
                 rdfs:domain :Equipamiento ;
                 rdfs:range :OrdenadorEstacionTrabajo ;
                 rdfs:comment "Enlace técnico de carácter opcional que asocia un equipo de fabricación aditiva, sustractiva o digitalización con el terminal informático dedicado a su control y envío de instrucciones). Dominio: SIN ACOTAR (Axiomatizado mediante restricciones existenciales a nivel de clase"@es ;
                 rdfs:label "Se opera mediante"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#seccionaPlancha
:seccionaPlancha rdf:type owl:ObjectProperty ;
                 rdfs:domain :CorteLaser ;
                 rdfs:range :PlanchaRigida ;
                 rdfs:comment "Enlace operativo que asocia directamente la maquinaria de corte por haz de luz, con la tipología exacta de material fungible sobre el que interviene para ejecutar su trabajo"@es ;
                 rdfs:label "Secciona plancha"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#seccionaVinilo
:seccionaVinilo rdf:type owl:ObjectProperty ;
                owl:inverseOf :viniloEsSeccionadoPor ;
                rdfs:domain :CortadoraVinilo ;
                rdfs:range :ViniloCorte ;
                rdfs:comment "Enlace operativo que asocia directamente la maquinaria de corte por cuchilla, con la tipología exacta de material fungible sobre el que interviene para ejecutar su trabajo"@es ;
                rdfs:label "Secciona vinilo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#solicitaPrestamo
:solicitaPrestamo rdf:type owl:ObjectProperty ;
                  rdfs:domain :Usuario ;
                  rdfs:range :EventoPrestamo ;
                  rdfs:comment "Enlace logístico que vincula a un miembro de la comunidad académica con el registro de movimiento temporal de inventario, asociando la responsabilidad del cuidado del hardware al perfil del solicitante durante el periodo establecido"@es ;
                  rdfs:label "Solicita préstamo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#superaTaller
:superaTaller rdf:type owl:ObjectProperty ;
              owl:inverseOf :tallerEsSuperadoPor ;
              rdfs:domain :ComunidadUniversitaria ;
              rdfs:range :TallerFormativo ;
              rdfs:comment "Enlace de capacitación que asocia a un perfil académico con la sesión de instrucción finalizada con éxito, actuando como llave lógica para desbloquear sus permisos de operación sobre el hardware restringido en el sistema"@es ;
              rdfs:label "Supera taller"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#supervisa
:supervisa rdf:type owl:ObjectProperty ;
           rdfs:domain :Administradores ;
           rdfs:range :EventoPrestamo ;
           rdfs:label "Supervisa"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tallerEsSuperadoPor
:tallerEsSuperadoPor rdf:type owl:ObjectProperty ;
                     rdfs:domain :TallerFormativo ;
                     rdfs:range :ComunidadUniversitaria ;
                     rdfs:comment "Enlace de capacitación que asocia a un perfil académico con la sesión de instrucción finalizada con éxito, actuando como llave lógica para desbloquear sus permisos de operación sobre el hardware restringido en el sistema"@es ;
                     rdfs:label "Taller es superado por"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#viniloEsSeccionadoPor
:viniloEsSeccionadoPor rdf:type owl:ObjectProperty ;
                       rdfs:domain :ViniloCorte ;
                       rdfs:range :CortadoraVinilo ;
                       rdfs:comment "Enlace operativo que asocia directamente la maquinaria de corte por cuchilla, con la tipología exacta de material fungible sobre el que interviene para ejecutar su trabajo"@es ;
                       rdfs:label "Vinilo es seccionado por"@es .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/ontologies/2026/bibliomaker#MaquinariaVinculada
:MaquinariaVinculada rdf:type owl:DatatypeProperty ;
                     rdfs:domain :OrdenadorEstacionTrabajo ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Referencia del equipamiento de fabricación física, como impresoras 3D, que se encuentra directamente subordinado a las instrucciones de esta terminal, condicionando la reserva del ordenador a la operación estricta de dicho hardware"@es ;
                     rdfs:label "Maquinaria vinculada"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#acabadoSuperficialVisual
:acabadoSuperficialVisual rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :Filamento3D ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Naturaleza óptica del sustrato tras su solidificación a temperatura ambiente, cualidad determinante para la asignación del recurso en proyectos de diseño de producto o maquetismo donde la refracción lumínica prima sobre la resistencia mecánica pura, ej. Mate, Sedoso, Traslúcido"@es ;
                          rdfs:label "Acabado superficial visual"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#admiteMultimaterial
:admiteMultimaterial rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Impresora_FDM ;
                     rdfs:range xsd:boolean ;
                     rdfs:comment "Indicador sobre la capacidad tecnológica del equipo para combinar múltiples filamentos distintos en una misma impresión, ya sea mediante extrusión múltiple o sistemas de cambio automático"@es ;
                     rdfs:label "Admite multimaterial"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#admitePedalExterno
:admitePedalExterno rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :InstrumentoMusical ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Disponibilidad de puertos de entrada físicos, generalmente en formato jack, destinados a la conexión de controladores de pie para la alteración del sostenido o la modulación de la expresión dinámica durante la interpretación"@es ;
                    rdfs:label "Admite pedal externo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#admiteTransmisionInalambrica
:admiteTransmisionInalambrica rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain :Presentacion_y_Difusion ;
                              rdfs:range xsd:boolean ;
                              rdfs:comment "Capacidad del hardware para recibir e interpretar flujos de datos audiovisuales mediante protocolos de red local, indispensable para habilitar el envío de señal desde portátiles de los usuarios sin depender de interfaces de cableado físico directo, ej. Miracast, AirPlay"@es ;
                              rdfs:label "Admite transmisión inalámbrica"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#alcanceMaximoTelemetria
:alcanceMaximoTelemetria rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain :Dron ;
                         rdfs:range xsd:integer ;
                         rdfs:comment "Distancia límite de cobertura radial en metros para mantener el enlace de control de radiofrecuencia y la transmisión de vídeo de retorno sin pérdida de señal, ej. 4000, 10000"@es ;
                         rdfs:label "Alcance máximo de telemetría"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#anchoMaterialAdmitido
:anchoMaterialAdmitido rdf:type owl:DatatypeProperty ;
                       rdfs:domain :CortadoraVinilo ;
                       rdfs:range xsd:integer ;
                       rdfs:comment "Distancia máxima transversal operativa entre los rodillos de arrastre del chasis, fundamental para determinar si el equipo procesa bobinas continuas de formato industrial o se limita a hojas estandarizadas de escritorio"@es ;
                       rdfs:label "Ancho de material admitido"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#anioInicioEstudios
:anioInicioEstudios rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :Estudiante ;
                    rdfs:range xsd:integer ;
                    rdfs:comment "Año natural en el que el alumno formalizó su primera matrícula en la titulación actual, un parámetro que permite al sistema identificar su nivel de veteranía académica y anticipar si va a requerir mayor supervisión técnica durante su paso por el espacio"@es ;
                    rdfs:label "Año de inicio de estudios"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#aperturaMaximaVertical
:aperturaMaximaVertical rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :PrensaManual ;
                        rdfs:range xsd:integer ;
                        rdfs:comment "Distancia máxima operativa en el eje Z entre la superficie estática de apoyo y el plato móvil superior, expresada habitualmente en milímetros, crítica para acotar el grosor límite del volumen o la cantidad de pliegos que admite el habitáculo antes de aplicar presión"@es ;
                        rdfs:label "Apertura máxima vertical"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#aptoParaCorteLaser
:aptoParaCorteLaser rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :PlanchaRigida ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Certificación de composición química que valida la viabilidad del tablero para ser sometido a estrés térmico concentrado sin emitir gases halógenos corrosivos, actuando como criba de seguridad ineludible para vetar el mecanizado de polímeros tóxicos como el PVC"@es ;
                    rdfs:label "Apto para corte láser"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#areaTrabajoEfectiva
:areaTrabajoEfectiva rdf:type owl:DatatypeProperty ;
                     rdfs:domain :CorteLaser ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Dimensiones máximas bidimensionales que el cabezal óptico puede recorrer en los ejes cartesianos, vital para acotar el tamaño de la plancha de sustrato que el usuario puede introducir en el habitáculo, ej. 600x400mm"@es ;
                     rdfs:label "Área de trabajo efectiva"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#areaTrabajoEfectivaTabletaGrafica
:areaTrabajoEfectivaTabletaGrafica rdf:type owl:DatatypeProperty ;
                                   rdfs:domain :TabletaDigitalizadora ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "Superficie física bidimensional u operativa útil, ya sea la cuadrícula sensible al lápiz o la base interior de la tienda de luz, determinante para evaluar la viabilidad de digitalizar planos extensos o fotografiar maquetas voluminosas sin exceder los límites del hardware, ej. 224x148mm, 40x40cm"@es ;
                                   rdfs:label "Área de trabajo efectiva de tableta gráfica"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#arquitecturaProcesador
:arquitecturaProcesador rdf:type owl:DatatypeProperty ;
                        rdfs:domain :OrdenadorPlacaUnica ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Conjunto de instrucciones nativo que determina el diseño lógico del silicio y condiciona de forma absoluta la compatibilidad binaria del software, determinando si el dispositivo requiere distribuciones operativas compiladas en exclusiva o admite binarios comerciales estándar, ej. ARMv8, x86_64"@es ;
                        rdfs:label "Arquitectura de procesador"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#arquitecturaProcesadorPC
:arquitecturaProcesadorPC rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Ordenador ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Especificación del conjunto de instrucciones y diseño del chip central, indispensable para determinar el tipo de binarios y dependencias lógicas que el sistema puede compilar o ejecutar nativamente, ej. x86_64, ARM64"@es ;
                          rdfs:label "Arquitectura de procesador de PC"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#autonomiaBateriaMinutos
:autonomiaBateriaMinutos rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain :OrdenadorPortatil ;
                         rdfs:range xsd:integer ;
                         rdfs:comment "Tiempo teórico de operación continua del dispositivo móvil bajo carga de trabajo estándar sin dependencia de una toma de corriente alterna, factor logístico estricto para la planificación de sesiones de estudio del alumno fuera de los puestos electrificados, ej. 240, 480"@es ;
                         rdfs:label "Autonomía de batería en minutos"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#bobinaAgotada
:bobinaAgotada rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Filamento3D ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Marcador encargado de indicar la existencia o el agotamiento de la bobina de filamento en cuestión"@es ;
               rdfs:label "Bobina agotada"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#calibreBoquillaAtomizacion
:calibreBoquillaAtomizacion rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain :SistemaAerografia ;
                            rdfs:range xsd:decimal ;
                            rdfs:comment "Diámetro del orificio de salida del obturador expresado en milímetros, factor geométrico crítico que acota el nivel de detalle del patrón de pulverización y condiciona el grosor mínimo de la línea trazable, ej. 0.2mm, 0.5mm"@es ;
                            rdfs:label "Calibre de boquilla de atomización"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#campoVisionDiagonal
:campoVisionDiagonal rdf:type owl:DatatypeProperty ;
                     rdfs:domain :CamaraWeb ;
                     rdfs:range xsd:integer ;
                     rdfs:comment "Amplitud angular máxima capturada por el grupo óptico, expresada en grados, vital para predecir si el encuadre abarca exclusivamente a un locutor o permite registrar a varios ponentes simultáneos en el set, ej. 78, 90"@es ;
                     rdfs:label "Campo de visión diagonal"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadBotonesProgramables
:cantidadBotonesProgramables rdf:type owl:DatatypeProperty ,
                                      owl:FunctionalProperty ;
                             rdfs:domain :ControladorRealizacion ;
                             rdfs:range xsd:integer ;
                             rdfs:comment "Número de interruptores físicos o matrices interactivas disponibles en la superficie para la asignación y ejecución rápida de macros, scripts o transiciones de escena en directo"@es ;
                             rdfs:label "Cantidad de botones programables"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadControlesRotatorios
:cantidadControlesRotatorios rdf:type owl:DatatypeProperty ,
                                      owl:FunctionalProperty ;
                             rdfs:domain :ControladorRealizacion ;
                             rdfs:range xsd:integer ;
                             rdfs:comment "Número de diales o perillas físicas de giro continuo integradas en el chasis, esenciales para el ajuste fino de niveles de audio, zoom o colorimetría en software de edición sin recurrir a pulsaciones reiteradas"@es ;
                             rdfs:label "Cantidad de controles rotatorios"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadElementosEjecucion
:cantidadElementosEjecucion rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain :InstrumentoMusical ;
                            rdfs:range xsd:integer ;
                            rdfs:comment "Número de superficies de interacción principal, ya sean teclas, pads de percusión o cuerdas, que delimitan la extensión musical abarcable simultáneamente sin requerir el uso de botones electrónicos de transposición de octava"@es ;
                            rdfs:label "Cantidad de elementos de ejecución"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadEntradasAnalogicas
:cantidadEntradasAnalogicas rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain :Microcontrolador ;
                            rdfs:range xsd:integer ;
                            rdfs:comment "Número de pines específicos equipados a nivel de hardware con un conversor analógico-digital interno, indispensables para la traducción directa de señales de voltaje variable provenientes de sensores pasivos a valores lógicos operables"@es ;
                            rdfs:label "Cantidad de entradas analógicas"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadEntradasSimultaneas
:cantidadEntradasSimultaneas rdf:type owl:DatatypeProperty ,
                                      owl:FunctionalProperty ;
                             rdfs:domain :InterfazAudio ;
                             rdfs:range xsd:integer ;
                             rdfs:comment "Número de canales físicos independientes disponibles en los preamplificadores del equipo para la ingesta paralela de múltiples señales sonoras"@es ;
                             rdfs:label "Cantidad de entradas simultáneas"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadMonitoresAsignados
:cantidadMonitoresAsignados rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain :Ordenador ;
                            rdfs:range xsd:integer ;
                            rdfs:comment "Cuantificación de las unidades de visualización independientes conectadas periféricamente o integradas en el chasis del sistema, factor operativo esencial para determinar la viabilidad de tareas complejas de desarrollo, diseño asistido por ordenador o monitorización simultánea de flujos de datos sin sufrir restricciones de espacio en el escritorio virtual, ej. 1, 2"@es ;
                            rdfs:label "Cantidad de monitores asignados"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadPinesGPIO
:cantidadPinesGPIO rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :PlacaDesarrollo ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "Número total de terminales físicos de entrada y salida de propósito general disponibles en la cabecera del circuito, determinante para acotar la capacidad máxima de expansión y el volumen de actuadores que el usuario puede interconectar simultáneamente"@es ;
                   rdfs:label "Cantidad de pines GPIO"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadPocillosDosificacion
:cantidadPocillosDosificacion rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain :UtillajeMezcla ;
                              rdfs:range xsd:integer ;
                              rdfs:comment "Número de concavidades físicas aisladas integradas en la estructura, esencial para calcular el volumen de mezclas de color simultáneas o diluciones independientes que el usuario puede preparar sin riesgo de contaminación cruzada"@es ;
                              rdfs:label "Cantidad de pocillos de dosificación"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadSalidasMonitorizacion
:cantidadSalidasMonitorizacion rdf:type owl:DatatypeProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain :InterfazAudio ;
                               rdfs:range xsd:integer ;
                               rdfs:comment "Número de envíos físicos independientes dedicados a la conexión de escuchas de estudio o amplificadores de auriculares"@es ;
                               rdfs:label "Cantidad de salidas de monitorización"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadAlmacenamientoInterno
:capacidadAlmacenamientoInterno rdf:type owl:DatatypeProperty ,
                                         owl:FunctionalProperty ;
                                rdfs:domain :GafasVR ;
                                rdfs:range xsd:string ;
                                rdfs:comment "Volumen de memoria no volátil embebida en la propia arquitectura del visor expresada en gigabytes, límite operativo crítico para sistemas autónomos que exigen la instalación directa de simuladores y la carga de mallas tridimensionales en local, ej. 128GB, 512GB"@es ;
                                rdfs:label "Capacidad de almacenamiento interno"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadAlmacenamientoPrincipal
:capacidadAlmacenamientoPrincipal rdf:type owl:DatatypeProperty ,
                                           owl:FunctionalProperty ;
                                  rdfs:domain :Ordenador ;
                                  rdfs:range xsd:integer ;
                                  rdfs:comment "Espacio total de memoria no volátil disponible en la unidad de disco local expresado en gigabytes, métrica indispensable para controlar la capacidad de instalación de software masivo y la persistencia de archivos locales, ej. 512, 1024"@es ;
                                  rdfs:label "Capacidad de almacenamiento principal"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadBandejaAlimentacion
:capacidadBandejaAlimentacion rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain :EscanerRodillo ;
                              rdfs:range xsd:integer ;
                              rdfs:comment "Número máximo de hojas físicas que el alimentador automático puede procesar en un único lote de escaneo ininterrumpido"@es ;
                              rdfs:label "Capacidad de bandeja de alimentación"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadBandejaCarga
:capacidadBandejaCarga rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :EscanerDiapositivas ;
                       rdfs:range xsd:integer ;
                       rdfs:comment "Número máximo de diapositivas enmarcadas que el sistema de alimentación o el chasis portador puede albergar para su digitalización secuencial por lotes sin intervención del operador"@es ;
                       rdfs:label "Capacidad de bandeja de carga"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadBobinas
:capacidadBobinas rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :SecadorFilamento ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "Número máximo de rollos de filamento estándar que el dispositivo puede alojar y deshumidificar de forma simultánea"@es ;
                  rdfs:label "Capacidad de bobinas"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadGrabacion
:capacidadGrabacion rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :LectorOptico ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Indicador técnico sobre si el periférico incluye diodo láser de escritura para la creación de discos físicos de preservación o si está limitado exclusivamente a la extracción de datos"@es ;
                    rdfs:label "Capacidad de grabación"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadMemoriaFlash
:capacidadMemoriaFlash rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :Microcontrolador ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Volumen máximo de almacenamiento no volátil disponible internamente, acotado generalmente en kilobytes, que determina el límite dimensional del código o firmware que el usuario puede cargar físicamente en la placa, ej. 32KB, 256KB"@es ;
                       rdfs:label "Capacidad de memoria flash"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadMemoriaRAM
:capacidadMemoriaRAM rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :OrdenadorPlacaUnica ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Volumen de memoria volátil integrada en la arquitectura, determinante para garantizar la estabilidad operativa de un núcleo completo y la viabilidad de ejecución simultánea de procesos de alta carga computacional, ej. 4GB, 8GB"@es ;
                     rdfs:label "Capacidad de memoria RAM"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadMemoriaRAMPC
:capacidadMemoriaRAMPC rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :Ordenador ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Volumen total de memoria de acceso aleatorio instalada en el sistema expresada en gigabytes, factor crítico que condiciona el límite de procesos simultáneos y la fluidez en la ejecución de entornos de desarrollo, ej. 16, 32"@es ;
                       rdfs:label "Capacidad de memoria RAM de PC"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadSeccionadoHojas
:capacidadSeccionadoHojas rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :Guillotina ;
                          rdfs:range xsd:integer ;
                          rdfs:comment "Volumen máximo de folios de gramaje estandarizado que la cizalla puede atravesar en un único movimiento de palanca descendente sin provocar desgarros en el borde ni bloquear la herramienta, vital para calcular la viabilidad del corte en bloques densos"@es ;
                          rdfs:label "Capacidad de seccionado de hojas"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capturaDobleCara
:capturaDobleCara rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :EscanerRodillo ;
                  rdfs:range xsd:boolean ;
                  rdfs:comment "Indicador técnico sobre la presencia de un sensor dúplex que permite la digitalización simultánea del anverso y reverso del folio"@es ;
                  rdfs:label "Captura a doble cara"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capturaEnColor
:capturaEnColor rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :EscanerDocumental ;
                rdfs:range xsd:boolean ;
                rdfs:comment "Indicador técnico sobre la capacidad del hardware para registrar el documento en espectro cromático completo, frente a limitaciones mecánicas o de software de captura exclusiva en monocromo o escala de grises"@es ;
                rdfs:label "Captura en color"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capturaPistaMagnetica
:capturaPistaMagnetica rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :LectorSuper8 ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "Indicador lógico que especifica si el hardware dispone de cabezales de audio integrados para la lectura y digitalización simultánea de la banda de sonido presente en el borde de algunos carretes cinematográficos subestándar"@es ;
                       rdfs:label "Captura de pista magnética"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#capturaTexturaColor
:capturaTexturaColor rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Escaner3D ;
                     rdfs:range xsd:boolean ;
                     rdfs:comment "Indicador técnico sobre la capacidad del hardware para registrar fotométricamente el aspecto visual y los colores de la superficie del objeto, además de su topología estructural"@es ;
                     rdfs:label "Captura de textura y color"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#cargoAdministrador
:cargoAdministrador rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Administradores ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Descripción del cargo que desempeña el profesional en el centro"@es ;
                    rdfs:label "Cargo de administrador"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#codigoInventario
:codigoInventario rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :Consumible
                                              :Equipamiento
                                            )
                              ] ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Cadena alfanumérica única para la identificación patrimonial del recurso en el catálogo"@es ;
                  rdfs:label "Código de inventario"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#codigoRegistroInterno
:codigoRegistroInterno rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :Gestion ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Identificador alfanumérico único generado por el sistema para auditar cualquier evento administrativo, garantizando la trazabilidad absoluta de todos los procesos del espacio"@es ;
                       rdfs:label "Código de registro interno"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#coeficienteReduccionRuido
:coeficienteReduccionRuido rdf:type owl:DatatypeProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:domain :PanelAcustico ;
                           rdfs:range xsd:decimal ;
                           rdfs:comment "Métrica estandarizada NRC que cuantifica el porcentaje de eficacia de absorción sonora del material, crucial para calcular el volumen de unidades requeridas según el tiempo de reverberación natural del entorno"@es ;
                           rdfs:label "Coeficiente de reducción de ruido"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#composicionPolimeroBase
:composicionPolimeroBase rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain :Filamento3D ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Naturaleza química de la matriz termoplástica que define las capacidades mecánicas de tracción o flexibilidad inherentes al material, permitiendo al sistema clasificar logísticamente la bobina y acotar su uso técnico sin necesidad de ramificar la estructura jerárquica del inventario, ej. PLA, TPU, Nylon"@es ;
                         rdfs:label "Composición de polímero base"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#controlVelocidadVariable
:controlVelocidadVariable rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :LectorCasete ;
                          rdfs:range xsd:boolean ;
                          rdfs:comment "Presencia de potenciómetro o ajuste de hardware para alterar finamente la velocidad de arrastre de la cinta magnética, indispensable para corregir grabaciones históricas con desajustes de tono o formatos de dictáfono."@es ;
                          rdfs:label "Control de velocidad variable"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#correccionCurvaturaLibros
:correccionCurvaturaLibros rdf:type owl:DatatypeProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:domain :EscanerCenital ;
                           rdfs:range xsd:boolean ;
                           rdfs:comment "Indicador sobre la capacidad del equipo o su software dedicado para aplanar digitalmente la deformación geométrica generada por el lomo de los volúmenes encuadernados"@es ;
                           rdfs:label "Corrección de curvatura de libros"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#correoInstitucionalVinculado
:correoInstitucionalVinculado rdf:type owl:DatatypeProperty ;
                              rdfs:domain :Usuario ;
                              rdfs:range xsd:string ;
                              rdfs:comment "Identificador telemático oficial proporcionado por la universidad, parámetro lógico esencial para la notificación automatizada de reservas, avisos de caducidad de préstamos y emisión de alertas por infracciones normativas en el recinto sin depender de bases de datos externas"@es ;
                              rdfs:label "Correo institucional vinculado"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#densidadesLecturaSoportadas
:densidadesLecturaSoportadas rdf:type owl:DatatypeProperty ;
                             rdfs:domain :LectorDiscosMagneticos ;
                             rdfs:range xsd:string ;
                             rdfs:comment "Compatibilidad del cabezal magnético con las diferentes codificaciones de pistas y sectores de los discos flexibles, clave para recuperar datos de distintas épocas, ej. Doble Densidad DD 720KB, Alta Densidad HD 1.44MB"@es ;
                             rdfs:label "Densidades de lectura soportadas"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#departamentoPDI
:departamentoPDI rdf:type owl:DatatypeProperty ;
                 rdfs:domain :DocenteInvestigador ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Departamento al que pertenece el Personal Docente Investigador, mayormente por cuestiones estadísticas"@es ;
                 rdfs:label "Departamento de PDI"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#descripcionSintomaFallo
:descripcionSintomaFallo rdf:type owl:DatatypeProperty ;
                         rdfs:domain :IncidenciaTecnica ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Registro de texto donde el usuario o el operador detalla el comportamiento anómalo detectado en el hardware, facilitando el diagnóstico previo"@es ;
                         rdfs:label "Descripción de síntoma de fallo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#diagonalPantallaPulgadas
:diagonalPantallaPulgadas rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :OrdenadorPortatil ;
                          rdfs:range xsd:decimal ;
                          rdfs:comment "Dimensión transversal del panel de visualización integrado, factor geométrico que determina simultáneamente el área de trabajo móvil disponible y el volumen espacial requerido para su despliegue físico en las mesas de lectura, ej. 13.3, 15.6"@es ;
                          rdfs:label "Diagonal de pantalla en pulgadas"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#diametroCalibreSeccion
:diametroCalibreSeccion rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :Filamento3D ;
                        rdfs:range xsd:decimal ;
                        rdfs:comment "Medida transversal del hilo polimérico en estado sólido expresada en milímetros, parámetro geométrico ineludible para garantizar la compatibilidad mecánica con el sistema de tracción del extrusor y la barrera térmica de la máquina asignada, ej. 1.75mm, 2.85mm"@es ;
                        rdfs:label "Diámetro y calibre de sección"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#diametroFilamento
:diametroFilamento rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Impresora_FDM ;
                   rdfs:range xsd:float ;
                   rdfs:comment "Grosor del material termoplástico compatible con el sistema de extrusión de la máquina, habitualmente 1,75mm o 2,85mm"@es ;
                   rdfs:label "Diámetro de filamento"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#diametroPinzaSoportado
:diametroPinzaSoportado rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :HerramientaRotativa ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Métrica del collarín de sujeción o portabrocas integrado, determinante para acotar la compatibilidad física de la herramienta con estandarizaciones comerciales de accesorios de terceros, ej. 3.2mm, 1/8 pulgada"@es ;
                        rdfs:label "Diámetro de pinza soportado"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#diametrosAdmitidos
:diametrosAdmitidos rdf:type owl:DatatypeProperty ;
                    rdfs:domain :LectorVinilo ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Formatos físicos estandarizados según su diámetro en pulgadas que el plato y el brazo fonocaptor pueden abarcar mecánicamente para su lectura, ej. 7\", 10\", 12\""@es ;
                    rdfs:label "Diámetros admitidos"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#dimensionesFisicasSoporte
:dimensionesFisicasSoporte rdf:type owl:DatatypeProperty ;
                           rdfs:domain :AcondicionamientoEstudio ;
                           rdfs:range xsd:string ;
                           rdfs:comment "Medidas perimetrales de la estructura o material desplegado, determinantes para calcular la viabilidad de cobertura espacial en la sala de grabación, ej. 2x3m, 50x50cm"@es ;
                           rdfs:label "Dimensiones físicas de soporte"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#dimensionesPlatoPlano
:dimensionesPlatoPlano rdf:type owl:DatatypeProperty ;
                       rdfs:domain :PrensaTermica ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Área máxima de intervención bidimensional de la resistencia principal, que acota estructuralmente el formato límite de los sustratos que pueden procesarse en un solo ciclo de cierre por presión"@es ;
                       rdfs:label "Dimensiones de plato plano"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#disenoAcustico
:disenoAcustico rdf:type owl:DatatypeProperty ;
                rdfs:domain :Monitorizacion ;
                rdfs:range xsd:string ;
                rdfs:comment "Configuración estructural de la cúpula que determina el grado de aislamiento pasivo y la fuga de audio, crítico para evitar la retroalimentación en micrófonos durante sesiones de grabación vocal, ej. Cerrado, Abierto, Semicerrado"@es ;
                rdfs:label "Diseño acústico"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#distanciaOperativaOptima
:distanciaOperativaOptima rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :SeguimientoOcular ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Rango longitudinal de separación física requerida entre el plano focal del emisor infrarrojo y el rostro del sujeto, expresado en milímetros, vital para configurar la ergonomía del entorno de pruebas de Interacción Persona-Ordenador sin perder el rastreo pupilar, ej. 500-800mm"@es ;
                          rdfs:label "Distancia operativa óptima"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#documentoIdentidad
:documentoIdentidad rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :Usuario ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Identificador oficial expedido por una autoridad gubernamental, como el DNI, NIE o pasaporte, indispensable para registrar la trazabilidad legal del usuario y auditar el préstamo de equipamiento de cierto valor económico"@es ;
                    rdfs:label "Documento de identidad"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#esAutocicatrizante
:esAutocicatrizante rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :TapeteCorte ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Propiedad estructural del polímero base que permite la restitución física de la superficie tras incisiones superficiales, vital para prolongar la vida útil del material y evitar el desvío de la herramienta en cortes sucesivos"@es ;
                    rdfs:label "Es autocicatrizante"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#esAutomatico
:esAutomatico rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :RebobinadorFilamento ;
              rdfs:range xsd:string ;
              rdfs:comment "Atributo lógico que determina si el dispositivo de rebobinado opera de forma motorizada e independiente o si requiere del accionamiento mecánico manual por parte del operador para guiar el hilo."@es ;
              rdfs:label "Es automático"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#esChasisMultifuncion
:esChasisMultifuncion rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :PrensaTermica ;
                      rdfs:range xsd:boolean ;
                      rdfs:comment "Indicador mecánico y eléctrico sobre si el bastidor de la unidad permite la extracción del bloque de calor primario para acoplar, alimentar y gestionar térmicamente resistencias periféricas con morfologías no planas"@es ;
                      rdfs:label "Es chasis multifunción"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#esEspectroRGB
:esEspectroRGB rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Iluminacion ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Indicador técnico sobre la incorporación de diodos de color dedicados que permiten la mezcla aditiva para bañar fondos o generar luz de contra en cualquier tono del espectro cromático, más allá de la escala térmica de blancos"@es ;
               rdfs:label "Es espectro RGB"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#esInstrumento
:esInstrumento rdf:type owl:DatatypeProperty ;
               rdfs:domain :InstrumentoMusical ;
               rdfs:range xsd:string ;
               rdfs:comment "Nombre del instrumento musical en cuestión"@es ;
               rdfs:label "Es instrumento"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#esPlegableTensado
:esPlegableTensado rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :FondoCromatico ;
                   rdfs:range xsd:boolean ;
                   rdfs:comment "Diseño estructural que incorpora un marco flexible perimetral para auto-tensar el material al desplegarse, evitando la formación mecánica de pliegues que generen gradientes de sombra perjudiciales para la homogeneidad del recorte"@es ;
                   rdfs:label "Es plegable y tensado"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#escalaCalibreComercial
:escalaCalibreComercial rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Pinceleria ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Identificador alfanumérico estandarizado por la industria que clasifica el volumen transversal del mechón y la longitud útil de las fibras, métrica crítica para adecuar la herramienta a la escala micrométrica del componente a detallar o a grandes superficies de imprimación, ej. 000, 2, 5/0"@es ;
                        rdfs:label "Escala de calibre comercial"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#espesorNominal
:espesorNominal rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :PlanchaRigida ;
                rdfs:range xsd:string ;
                rdfs:comment "Medida transversal de la materia prima expresada en milímetros, parámetro físico indispensable para establecer la profundidad de pasada en el mecanizado o la distancia focal de la óptica garantizando que la herramienta atraviese el sustrato sin perforar la cama de sacrificio perimetral, ej. 3, 5"@es ;
                rdfs:label "Espesor nominal"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#estadoBloqueoCautelar
:estadoBloqueoCautelar rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :ComunidadUniversitaria ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "Indicador que señala si el trabajador tiene suspendidos sus privilegios de reserva en el taller por alguna negligencia previa o retraso en las devoluciones"@es ;
                       rdfs:label "Estado de bloqueo cautelar"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#estadoOperativo
:estadoOperativo rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Equipamiento ;
                 rdfs:range xsd:boolean ;
                 rdfs:comment "Condición técnica actual de la máquina para su uso, Activo, Averiado, En Mantenimiento…"@es ;
                 rdfs:label "Estado operativo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#estadoTransaccion
:estadoTransaccion rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :EventoPrestamo ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Indicador logístico que define en tiempo real si el préstamo está activo, finalizado o en estado de morosidad. Valores: \"EXITOSO, CANCELADO, ACTIVO, INCIDENCIA\"."@es ;
                   rdfs:label "Estado de transacción"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#estandarPuntaIntercambiable
:estandarPuntaIntercambiable rdf:type owl:DatatypeProperty ;
                             rdfs:domain :EstacionSoldadura ;
                             rdfs:range xsd:string ;
                             rdfs:comment "Especificación física y métrica del vástago o cartucho de transmisión de calor que determina la compatibilidad estricta con consumibles de repuesto, indispensable para la gestión del inventario y el mantenimiento de la herramienta, ej. Serie 900M, Cartuchos T12"@es ;
                             rdfs:label "Estándar de punta intercambiable"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#estandarPuntaIntercambiableSoldLapiz
:estandarPuntaIntercambiableSoldLapiz rdf:type owl:DatatypeProperty ;
                                      rdfs:domain :SoldadorLapiz ;
                                      rdfs:range xsd:string ;
                                      rdfs:comment "Especificación física y métrica del vástago macizo de transmisión de calor que determina la compatibilidad estricta con consumibles de repuesto, indispensable para garantizar la operatividad continua de la herramienta básica en el taller, ej. Serie 900M, Punta roscada estándar"@es ;
                                      rdfs:label "Estándar de punta intercambiable para soldador de lápiz"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaAdquisicionInstitucional
:fechaAdquisicionInstitucional rdf:type owl:DatatypeProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain :Equipamiento ;
                               rdfs:range xsd:dateTime ;
                               rdfs:comment "Registro cronológico de la incorporación física y contable del activo al catálogo, métrica administrativa indispensable para calcular la amortización del hardware a lo largo de su ciclo de vida, auditar la vigencia de las coberturas de garantía y gestionar la rotación prioritaria de lotes en materiales fungibles sometidos a degradación temporal, ej. 2026-06-04"@es ;
                               rdfs:label "Fecha de adquisición institucional"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaAdquisicionInstitucionalConsumible
:fechaAdquisicionInstitucionalConsumible rdf:type owl:DatatypeProperty ,
                                                  owl:FunctionalProperty ;
                                         rdfs:domain :Consumible ;
                                         rdfs:range xsd:dateTime ;
                                         rdfs:comment "Registro cronológico de la incorporación física y contable del activo al catálogo, métrica administrativa indispensable para calcular la amortización del hardware a lo largo de su ciclo de vida, auditar la vigencia de las coberturas de garantía y gestionar la rotación prioritaria de lotes en materiales fungibles sometidos a degradación temporal, ej. 2026-06-04"@es ;
                                         rdfs:label "Fecha de adquisición institucional de consumible"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaDevolucionEsperada
:fechaDevolucionEsperada rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain :EventoPrestamo ;
                         rdfs:range xsd:dateTime ;
                         rdfs:comment "Límite temporal asignado al usuario para retornar el material físico al taller, cuyo incumplimiento dispara automáticamente los bloqueos cautelares en su ficha"@es ;
                         rdfs:label "Fecha de devolución esperada"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaFinEvento
:fechaFinEvento rdf:type owl:DatatypeProperty ;
                rdfs:domain :EventoPrestamo ;
                rdfs:range xsd:dateTime ;
                rdfs:label "Fecha de fin de evento"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaInicioEvento
:fechaInicioEvento rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :EventoPrestamo ;
                   rdfs:range xsd:dateTime ;
                   rdfs:comment "Marca temporal exacta en la que se registra la transacción, la alerta o el curso, un dato vital para mantener el orden cronológico en la base de datos"@es ;
                   rdfs:label "Fecha de inicio de evento"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaNacimiento
:fechaNacimiento rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Usuario ;
                 rdfs:range xsd:dateTime ;
                 rdfs:comment "Registro cronológico del nacimiento del individuo, una propiedad preferible a la edad estática ya que permite al sistema calcular dinámicamente los años del usuario y mantener la base de datos siempre actualizada"@es ;
                 rdfs:label "Fecha de nacimiento"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#flujoLuminosoMaximo
:flujoLuminosoMaximo rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :Iluminacion ;
                     rdfs:range xsd:integer ;
                     rdfs:comment "Potencia bruta de emisión del sistema, expresada habitualmente en lúmenes, vital para calcular la cobertura espacial del set o contrarrestar el sangrado de luz natural directa por las ventanas"@es ;
                     rdfs:label "Flujo luminoso máximo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#flujoLuminosoMaximoProyector
:flujoLuminosoMaximoProyector rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain :Proyector ;
                              rdfs:range xsd:integer ;
                              rdfs:comment "Potencia lumínica absoluta de la fuente de emisión estandarizada bajo la norma ANSI y expresada en lúmenes, factor crítico para garantizar la legibilidad del área proyectada en salas con alta contaminación de luz ambiental, ej. 3000, 5000"@es ;
                              rdfs:label "Flujo luminoso máximo de proyector"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoCintaVideo
:formatoCintaVideo rdf:type owl:DatatypeProperty ;
                   rdfs:domain :LectorVideo ;
                   rdfs:range xsd:string ;
                   rdfs:label "Formato cinta vídeo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoDiscoMagnetico
:formatoDiscoMagnetico rdf:type owl:DatatypeProperty ;
                       rdfs:domain :LectorDiscosMagneticos ;
                       rdfs:range xsd:string ;
                       rdfs:label "Formato disco magnético"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoNormalizadoMaximo
:formatoNormalizadoMaximo rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :Encuadernacion ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Dimensión estandarizada límite, habitualmente expresada mediante la serie A de la norma ISO 216, que el área de operación es capaz de abarcar íntegramente sin requerir la partición o el plegado previo del sustrato, vital para planificar el postprocesado de los pliegos impresos, ej. A3, A4"@es ;
                          rdfs:label "Formato normalizado máximo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoPapelMaximo
:formatoPapelMaximo rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :EscanerDocumental ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Tamaño estandarizado límite del documento físico que la superficie o campo visual del equipo puede abarcar en una sola captura, ej. A4, A3, Din-A2"@es ;
                    rdfs:label "Formato de papel máximo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoSalidaPrincipal
:formatoSalidaPrincipal rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Digitalizacion ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Extensión o tipo de archivo digital estándar que el equipo genera como resultado nativo del proceso de captura o volcado, ej. PDF, STL, WAV, MP4, ISO"@es ;
                        rdfs:label "Formato de salida principal"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoSuministroFisico
:formatoSuministroFisico rdf:type owl:DatatypeProperty ;
                         rdfs:domain :MaterialSustractivo ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Configuración geométrica de entrega y almacenaje del material en bruto, indispensable para que la logística del recinto asigne almacenamiento de carga plana o soportes cilíndricos de desenrollado continuo, determinando además la compatibilidad con los sistemas de alimentación de la maquinaria, ej. Tablero plano, Bobina"@es ;
                         rdfs:label "Formato de suministro físico"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#formatosDiscoAdmitidos
:formatosDiscoAdmitidos rdf:type owl:DatatypeProperty ;
                        rdfs:domain :LectorOptico ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Tipos de soportes ópticos estandarizados que el láser del dispositivo es capaz de reconocer, fundamentales para la ingesta de colecciones de distintas generaciones, ej. CD-ROM, DVD±R, BD-RE"@es ;
                        rdfs:label "Formatos de disco admitidos"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#frecuenciaBaseProcesador
:frecuenciaBaseProcesador rdf:type owl:DatatypeProperty ;
                          rdfs:domain :OrdenadorPlacaUnica ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Velocidad de reloj nominal de los núcleos principales del circuito integrado expresada en gigahercios, fundamental para evaluar la capacidad de cómputo bruto del dispositivo frente a tareas de procesamiento masivo de datos o ejecución de scripts concurrentes, ej. 1.5GHz, 2.4GHz"@es ;
                          rdfs:label "Frecuencia base de procesador"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#frecuenciaMuestreoMaxima
:frecuenciaMuestreoMaxima rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :DigitalizadorAudio ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Nivel límite de fidelidad en la conversión analógico-digital de la onda sonora, determinante para el rango dinámico de la captura, ej. 44.1kHz, 96kHz"@es ;
                          rdfs:label "Frecuencia de muestreo máxima"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#frecuenciaRelojOperativa
:frecuenciaRelojOperativa rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Microcontrolador ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Velocidad de procesamiento del oscilador de cuarzo interno expresada habitualmente en megahercios, fundamental para determinar la viabilidad del dispositivo en operaciones estrictas de tiempo real y cálculo de interrupciones, ej. 16MHz, 133MHz"@es ;
                          rdfs:label "Frecuencia de reloj operativa"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#fuerzaCorteMaxima
:fuerzaCorteMaxima rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :CortadoraVinilo ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "Presión límite de empuje vertical ejercida por el electroimán del cabezal sobre la cuchilla, habitualmente expresada en gramos-fuerza, crítica para evaluar la penetración en sustratos densos o multicapa sin provocar el bloqueo del motor transversal"@es ;
                   rdfs:label "Fuerza de corte máxima"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#generoUsuario
:generoUsuario rdf:type owl:DatatypeProperty ;
               rdfs:domain :Usuario ;
               rdfs:range xsd:string ;
               rdfs:comment "Clasificación demográfica del individuo, un dato estadístico que suelen requerir las instituciones académicas para elaborar memorias anuales y evaluar los perfiles de uso de las instalaciones"@es ;
               rdfs:label "Género de usuario"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#habilitaArea
:habilitaArea rdf:type owl:DatatypeProperty ;
              rdfs:domain :TallerFormativo ;
              rdfs:range xsd:string ;
              rdfs:comment "Designación del área que habilita a utilizar el curso en cuestión"@es ;
              rdfs:label "Habilita área"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#impedanciaNominal
:impedanciaNominal rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Monitorizacion ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "Resistencia eléctrica de las bobinas internas expresada en ohmios, determinante para saber si el equipo requiere amplificación dedicada para alcanzar un volumen operativo óptimo o si es apto para salidas de línea estándar"@es ;
                   rdfs:label "Impedancia nominal"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#incluyeAccesorios
:incluyeAccesorios rdf:type owl:DatatypeProperty ;
                   rdfs:domain :OrdenadorPortatil ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Indicador logístico que registra si el chasis se entrega conjuntamente con elementos de protección estructural y alimentación externa, como fundas acolchadas o transformadores de corriente, indispensable para auditar la devolución íntegra del recurso prestado"@es ;
                   rdfs:label "Incluye accesorios"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#incluyeControladoresCinematicos
:incluyeControladoresCinematicos rdf:type owl:DatatypeProperty ,
                                          owl:FunctionalProperty ;
                                 rdfs:domain :GafasVR ;
                                 rdfs:range xsd:boolean ;
                                 rdfs:comment "Disponibilidad de periféricos físicos de seguimiento espacial y respuesta háptica en el paquete base, determinantes para garantizar la interacción mecánica precisa y la manipulación de objetos en el entorno simulado frente a sistemas limitados exclusivamente al rastreo óptico de manos"@es ;
                                 rdfs:label "Incluye controladores cinemáticos"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#incluyeFondosIntercambiables
:incluyeFondosIntercambiables rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain :EstudioFotograficoPortatil ;
                              rdfs:range xsd:boolean ;
                              rdfs:comment "Disponibilidad de cicloramas de policarbonato o lona de distintos colores mate para el aislamiento óptico del objeto, vital para evitar rebotes de luz indeseados y facilitar la extracción automatizada del contorno mediante software de edición"@es ;
                              rdfs:label "Incluye fondos intercambiables"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#indiceFlexibilidadFibras
:indiceFlexibilidadFibras rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :Pinceleria ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Grado de resistencia mecánica y capacidad de retorno elástico del mechón al aplicar presión física, cualidad técnica indispensable para discriminar entre herramientas aptas para técnicas de abrasión en seco frente a la aplicación sutil de veladuras líquidas, ej. Alta, Baja, Media"@es ;
                          rdfs:label "Índice de flexibilidad de fibras"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazAlimentacionPrincipal
:interfazAlimentacionPrincipal rdf:type owl:DatatypeProperty ;
                               rdfs:domain :PlacaDesarrollo ;
                               rdfs:range xsd:string ;
                               rdfs:comment "Estándar del puerto físico o receptáculo integrado diseñado para el suministro primario de corriente continua desde una fuente externa, vital para la planificación de la autonomía energética o el diseño de la carcasa del montaje final, ej. USB-C, Jack de barril"@es ;
                               rdfs:label "Interfaz de alimentación principal"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazConexionAudio
:interfazConexionAudio rdf:type owl:DatatypeProperty ;
                       rdfs:domain :PerifericoAudio ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Protocolo físico, analógico o digital empleado para la transmisión de la señal sonora o datos de control hacia la estación de trabajo, vital para determinar la compatibilidad del cableado en el montaje, ej. XLR, USB-C, Jack 6.3mm, MIDI"@es ;
                       rdfs:label "Interfaz de conexión de audio"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazConexionDatos
:interfazConexionDatos rdf:type owl:DatatypeProperty ;
                       rdfs:domain :PerifericoVideo ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Protocolo físico o estándar de red empleado para la transmisión bidireccional de la señal visual o la recepción de comandos de control desde la estación de trabajo, indispensable para la integración en el software de emisión, ej. USB-C, Wi-Fi, HDMI"@es ;
                       rdfs:label "Interfaz de conexión de datos"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazConexionPC
:interfazConexionPC rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Digitalizacion ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Tipo de puerto o protocolo físico requerido para enlazar el periférico con la estación de trabajo encargada de procesar o almacenar la captura, ej. USB-A, USB-C, Firewire"@es ;
                    rdfs:label "Interfaz de conexión a PC"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazConexionTermica
:interfazConexionTermica rdf:type owl:DatatypeProperty ;
                         rdfs:domain :AdaptadoresPrensa ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Estándar de clavija física y distribución interna de pines requerido para enlazar el módulo con la unidad de control central del chasis para recibir voltaje y transmitir lecturas del termopar, crucial para garantizar la compatibilidad entre piezas de distintos fabricantes, ej. Conector de aviación de 4 pines, Clavija hembra de 5 pines"@es ;
                         rdfs:label "Interfaz de conexión térmica"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazRedPrincipal
:interfazRedPrincipal rdf:type owl:DatatypeProperty ;
                      rdfs:domain :OrdenadorPlacaUnica ;
                      rdfs:range xsd:string ;
                      rdfs:comment "Protocolo de comunicación de banda ancha, físico o inalámbrico, embebido directamente en el hardware, crítico para la integración en infraestructuras IoT, la descarga de repositorios de software y el mantenimiento de servicios como servidores locales, ej. Gigabit Ethernet, Wi-Fi 6"@es ;
                      rdfs:label "Interfaz de red principal"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazSalidaVideo
:interfazSalidaVideo rdf:type owl:DatatypeProperty ;
                     rdfs:domain :OrdenadorPlacaUnica ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Estándar de conexión física habilitado para la transmisión nativa de señal audiovisual hacia monitores periféricos, indispensable para la configuración inicial y la operación del dispositivo mediante entorno gráfico de escritorio sin depender de accesos remotos por consola, ej. Micro-HDMI, DSI"@es ;
                     rdfs:label "Interfaz de salida de vídeo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazTransmision
:interfazTransmision rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Impresora3D ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Vía o método físico/inalámbrico admitido para el envió de los archivos de código máquina al dispositivo, Tarjeta SD, mSD, USB, Wi-Fi…"@es ;
                     rdfs:label "Interfaz de transmisión"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#licenciasSoftwareDespliegue
:licenciasSoftwareDespliegue rdf:type owl:DatatypeProperty ;
                             rdfs:domain :OrdenadorEstacionTrabajo ;
                             rdfs:range xsd:string ;
                             rdfs:comment "Catálogo de entornos de diseño asistido por ordenador, laminadores o software de simulación física con clave institucional preactivada en el equipo local, vital para que el usuario verifique la disponibilidad de su entorno de trabajo antes de ocupar el puesto, ej. SolidWorks, AutoCAD, Ultimaker Cura"@es ;
                             rdfs:label "Licencias de software de despliegue"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#marca
:marca rdf:type owl:DatatypeProperty ;
       rdfs:domain [ rdf:type owl:Class ;
                     owl:unionOf ( :Consumible
                                   :Equipamiento
                                 )
                   ] ;
       rdfs:range xsd:string ;
       rdfs:comment "Designación comercial del fabricante del elemento"@es ;
       rdfs:label "Marca"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#materialElementoCalefactor
:materialElementoCalefactor rdf:type owl:DatatypeProperty ;
                            rdfs:domain :SoldadorLapiz ;
                            rdfs:range xsd:string ;
                            rdfs:comment "Composición física de la resistencia interna encargada de la transformación energética constante, determinante para evaluar la curva de aceleración térmica inicial y la retención del calor en un circuito carente de regulación electrónica activa, ej. Cerámica, Aleación de nicrom"@es ;
                            rdfs:label "Material de elemento calefactor"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#mecanismoAcopleChasis
:mecanismoAcopleChasis rdf:type owl:DatatypeProperty ;
                       rdfs:domain :AccesorioBrazoHerramientaRotativa ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Estándar físico de anclaje que permite la fijación rígida del brazo extensor o la base de fresado a la carcasa del motor principal, asegurando la transmisión del par de giro o manteniendo la perpendicularidad del eje sin holguras, ej. Rosca frontal Dremel"@es ;
                       rdfs:label "Mecanismo de acople a chasis"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#metodoFijacionSoporte
:metodoFijacionSoporte rdf:type owl:DatatypeProperty ;
                       rdfs:domain :ViniloCorte ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Principio termodinámico o mecánico requerido para la adherencia permanente del vector recortado sobre el material receptor, permitiendo a la plataforma discriminar entre sustratos de activación por presión manual en frío frente a polímeros que fuerzan al usuario a reservar paralelamente una prensa de transferencia térmica, ej. Adhesión en frío, Termofijación"@es ;
                       rdfs:label "Método de fijación a soporte"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#modelo
:modelo rdf:type owl:DatatypeProperty ;
        rdfs:domain [ rdf:type owl:Class ;
                      owl:unionOf ( :Consumible
                                    :Equipamiento
                                  )
                    ] ;
        rdfs:range xsd:string ;
        rdfs:comment "Versión técnica del dispositivo"@es ;
        rdfs:label "Modelo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#modeloGraficaInstalada
:modeloGraficaInstalada rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Ordenador ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Especificación de la unidad de procesamiento gráfico presente en la configuración base, orientada a registrar controladores integrados o chips dedicados estándar antes de evaluar el músculo gráfico especializado de las estaciones de trabajo, ej. Intel Iris Xe, AMD Radeon Graphics"@es ;
                        rdfs:label "Modelo de gráfica instalada"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#modeloProcesador
:modeloProcesador rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Ordenador ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Denominación comercial y técnica del microprocesador central que determina la generación y el modelo específico del chip, parámetro esencial para evaluar la capacidad de cómputo bruto del sistema, ej. Intel Core i7-12700H, AMD Ryzen 5 5700X"@es ;
                  rdfs:label "Modelo de procesador"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#morfologiaCabezalPictorico
:morfologiaCabezalPictorico rdf:type owl:DatatypeProperty ;
                            rdfs:domain :Pinceleria ;
                            rdfs:range xsd:string ;
                            rdfs:comment "Diseño de la matriz del mechón de fibras, responsable de dictar la huella geométrica y el comportamiento del pigmento al presionar sobre la superficie de la pieza, ej. Plano, Redondo, Lengua de gato"@es ;
                            rdfs:label "Morfología de cabezal pictórico"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#morfologiaSustratoDestino
:morfologiaSustratoDestino rdf:type owl:DatatypeProperty ;
                           rdfs:domain :AdaptadoresPrensa ;
                           rdfs:range xsd:string ;
                           rdfs:comment "Diseño geométrico específico de la resistencia térmica moldeada para acoplarse y aplicar presión uniforme sobre la curvatura de objetos volumétricos concretos, vital para acotar qué artículos de merchandising permite procesar el módulo esclavo, ej. Taza cilíndrica 11oz, Gorra curva, Plato 8 pulgadas"@es ;
                           rdfs:label "Morfología de sustrato destino"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#naturalezaCerdas
:naturalezaCerdas rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Pinceleria ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Origen biológico o formulación sintética de las fibras de aplicación, determinante para prever el nivel de retención hídrica, la flexibilidad estructural del trazo y la compatibilidad con ciertos aglutinantes, ej. Marta Kolinsky, Nylon"@es ;
                  rdfs:label "Naturaleza de cerdas"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#naturalezaMaterialBase
:naturalezaMaterialBase rdf:type owl:DatatypeProperty ;
                        rdfs:domain :PlanchaRigida ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Clasificación taxonómica o polimérica de la matriz estructural del tablero, determinante empírico para que el operario calcule las revoluciones del husillo, prevea el desprendimiento de viruta y seleccione la herramienta de corte adecuada sin astillar los bordes de la pieza, ej. MDF, Contrachapado de chopo, Metacrilato de extrusión"@es ;
                        rdfs:label "Naturaleza de material base"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#naturalezaTransmision
:naturalezaTransmision rdf:type owl:DatatypeProperty ;
                       rdfs:domain :PerifericoAudio ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Formato estructural del flujo de información que el dispositivo emite o recibe, determinante para planificar la cadena de conexión y saber si el equipo requiere conversión previa antes de integrarse en el software, ej. Analógica, Digital, MIDI"@es ;
                       rdfs:label "Naturaleza de transmisión"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#necesitaHabilitacion
:necesitaHabilitacion rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :Equipamiento ;
                      rdfs:range xsd:boolean ;
                      rdfs:comment "Indicador restrictivo sobre la obligatoriedad de haber superado un taller formativo previo para poder operar el recurso"@es ;
                      rdfs:label "Necesita habilitación"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#nivelPrioridadResolucion
:nivelPrioridadResolucion rdf:type owl:DatatypeProperty ;
                          rdfs:domain :SoporteMantenimiento ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Escala de urgencia asignada al aviso, fundamental para que los coordinadores sepan qué alertas de stock o averías deben atender primero para no paralizar el taller. 1-Bajo, 5-Muy urgente"@es ;
                          rdfs:label "Nivel de prioridad de resolución"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#nivelToleranciaQuimica
:nivelToleranciaQuimica rdf:type owl:DatatypeProperty ;
                        rdfs:domain :TratamientoCromatico ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Capacidad estructural de los materiales de fabricación, sean juntas tóricas, cerdas o polímeros, para soportar la exposición directa y prolongada a disolventes orgánicos agresivos sin sufrir degradación física durante los ciclos de limpieza, ej. Acrílicos al agua, Lacas celulósicas"@es ;
                        rdfs:label "Nivel de tolerancia química"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#nombreCompleto
:nombreCompleto rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Usuario ;
                rdfs:range xsd:string ;
                rdfs:comment "Cadena de texto que recoge el nombre y los apellidos de la persona, un dato básico y necesario para la identificación presencial en el mostrador, la firma de actas o la asignación de responsabilidades directas"@es ;
                rdfs:label "Nombre completo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#nombreEquipo
:nombreEquipo rdf:type owl:DatatypeProperty ;
              rdfs:domain :Equipamiento ;
              rdfs:range xsd:string ;
              rdfs:comment "Denominación del equipamiento."@es ;
              rdfs:label "Nombre de equipo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#nombreTaller
:nombreTaller rdf:type owl:DatatypeProperty ;
              rdfs:domain :TallerFormativo ;
              rdfs:range xsd:string ;
              rdfs:comment "Nombre del curso impartido por la Biblioteca para el manejo de la maquinaria del Bibliomaker"@es ;
              rdfs:label "Nombre de taller"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#numeroCabezales
:numeroCabezales rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :LectorVideo ;
                 rdfs:range xsd:integer ;
                 rdfs:comment "Cantidad de lectores magnéticos instalados en el tambor rotatorio, determinante para la fidelidad de la imagen en pausa y la decodificación de audio estéreo Hi-Fi"@es ;
                 rdfs:label "Número de cabezales"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#observacionNivelStock
:observacionNivelStock rdf:type owl:DatatypeProperty ;
                       rdfs:domain :IncidenciaTecnica ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Registro de texto en el que el usuario detalla de forma aproximada la cantidad sobrante que ha detectado visualmente en la caja o la estantería, sirviendo como aviso preliminar para que el coordinador audite el inventario real, ej. \"Queda menos de medio bote\", \"Solo quedan dos brocas sanas\""@es ;
                       rdfs:label "Observación de nivel de stock"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#patronPolar
:patronPolar rdf:type owl:DatatypeProperty ;
             rdfs:domain :Microfono ;
             rdfs:range xsd:string ;
             rdfs:comment "Sensibilidad direccional del dispositivo respecto a la fuente acústica, fundamental para predecir y mitigar la captación de ruido ambiente o reverberación de la sala, ej. Cardioide, Omnidireccional, Bidireccional"@es ;
             rdfs:label "Patrón polar"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#perfilSuperficial
:perfilSuperficial rdf:type owl:DatatypeProperty ;
                   rdfs:domain :PanelAcustico ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Diseño geométrico tridimensional de la cara expuesta del material, optimizado mecánicamente para la difracción o mitigación de rangos de frecuencia acústica específicos, ej. Piramidal, Trampa de graves, Liso"@es ;
                   rdfs:label "Perfil superficial"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#permiteImpresionDirecta
:permiteImpresionDirecta rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain :SecadorFilamento ;
                         rdfs:range xsd:boolean ;
                         rdfs:comment "Indicador físico sobre la presencia de orificios de salida que permiten alimentar el filamento hacia la impresora mientras la bobina permanece secándose en su interior"@es ;
                         rdfs:label "Permite impresión directa"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#perteneceADominioSeguro
:perteneceADominioSeguro rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain :Ordenador ;
                         rdfs:range xsd:boolean ;
                         rdfs:comment "Indicador lógico que confirma si el equipo informático está integrado de forma nativa en el servicio de directorio activo y bajo el firewall institucional, parámetro de red ineludible para acotar los permisos de acceso a carpetas compartidas y aislar el tráfico general frente a la intranet confidencial del personal"@es ;
                         rdfs:label "Pertenece a dominio seguro"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#pesoAlDespegueGramos
:pesoAlDespegueGramos rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :Dron ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "Masa total del vehículo incluyendo baterías y carga útil, métrica legal estricta que determina la categoría de certificación europea requerida y las restricciones de vuelo en espacios urbanos, ej. 249, 595"@es ;
                      rdfs:label "Peso al despegue en gramos"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#pesoFisicoGramos
:pesoFisicoGramos rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :OrdenadorPortatil ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "Masa total del dispositivo informático, métrica ergonómica fundamental para que el usuario evalúe la viabilidad de su transporte continuo en la mochila durante el periodo de préstamo temporal por el campus, ej. 1300, 2100"@es ;
                  rdfs:label "Peso físico en gramos"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#potenciaElectricaNominal
:potenciaElectricaNominal rdf:type owl:DatatypeProperty ;
                          rdfs:domain :PrensaTermica ;
                          rdfs:range xsd:integer ;
                          rdfs:comment "Consumo energético máximo del bloque de resistencias en pleno rendimiento, expresado en vatios, crítico para la planificación de la carga de red en el taller y la prevención de sobrecargas al operar maquinaria simultánea, ej. 1800W, 2200W"@es ;
                          rdfs:label "Potencia eléctrica nominal"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#potenciaEmisionLaser
:potenciaEmisionLaser rdf:type owl:DatatypeProperty ;
                      rdfs:domain :CorteLaser ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "Capacidad máxima de salida del tubo o diodo generador expresada en vatios, determinante para establecer la profundidad de seccionado y el tipo de materiales admitidos sin riesgo de combustión, ej. 40W, 130W"@es ;
                      rdfs:label "Potencia de emisión láser"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#potenciaTermicaNominal
:potenciaTermicaNominal rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Soldadura_y_Ensamblaje ;
                        rdfs:range xsd:integer ;
                        rdfs:comment "Capacidad máxima de consumo energético del elemento calefactor expresada en vatios, crítica para evaluar la inercia térmica del instrumento y su capacidad para recuperar la temperatura operativa instantáneamente al soldar sobre planos de masa extensos o cableado de gran calibre, ej. 40W, 130W"@es ;
                        rdfs:label "Potencia térmica nominal"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#precisionCaptura
:precisionCaptura rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Escaner3D ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Grado de fidelidad geométrica o margen de error mínimo del barrido respecto a la pieza original, expresado en fracciones de milímetro o micras"@es ;
                  rdfs:label "Precisión de captura"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#precisionEspacialAngular
:precisionEspacialAngular rdf:type owl:DatatypeProperty ;
                          rdfs:domain :SeguimientoOcular ;
                          rdfs:range xsd:decimal ;
                          rdfs:comment "Margen de error promedio del vector de mirada respecto al estímulo visual objetivo, medido en grados de arco visual, métrica crítica para certificar la validez científica del hardware en estudios estrictos de microfijaciones o lectura de textos, ej. 0.5°, 1.2°"@es ;
                          rdfs:label "Precisión espacial angular"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#presionOperativaMaxima
:presionOperativaMaxima rdf:type owl:DatatypeProperty ;
                        rdfs:domain :SistemaAerografia ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Límite superior de fuerza neumática soportada por el calderín y las válvulas expresada en bares o PSI, vital para determinar la capacidad del equipo para atomizar pigmentos de alta densidad o imprimaciones espesas sin atascarse, ej. 3 Bar, 45 PSI"@es ;
                        rdfs:label "Presión operativa máxima"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#prestableDomicilio
:prestableDomicilio rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :Equipamiento ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Indicador restrictivo sobre la viabilidad de cesión del material fuera de las instalaciones"@es ;
                    rdfs:label "Prestable a domicilio"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#procesadorOPU
:procesadorOPU rdf:type owl:DatatypeProperty ;
               rdfs:domain :OrdenadorPlacaUnica ;
               rdfs:range xsd:string ;
               rdfs:comment "Denominación comercial y fabricante del System on Chip o circuito integrado principal que centraliza las funciones de cómputo de la placa, indispensable para la identificación exacta del hardware y la consulta directa de hojas de especificaciones del fabricante, ej. Broadcom BCM2712, Rockchip RK3588"@es ;
               rdfs:label "Procesador de OPU"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#profundidadBits
:profundidadBits rdf:type owl:DatatypeProperty ;
                 rdfs:domain :DigitalizadorAudio ;
                 rdfs:range xsd:integer ;
                 rdfs:comment "Resolución de amplitud de la onda sonora capturada, vital para definir el margen dinámico y la reducción de ruido de fondo, ej. 16-bit, 24-bit"@es ;
                 rdfs:label "Profundidad de bits"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#profundidadColor
:profundidadColor rdf:type owl:DatatypeProperty ;
                  rdfs:domain :DigitalizadorFotografico ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Cantidad de bits de información de luz y color capturados por cada píxel del sensor, vital para extraer todo el rango dinámico de las películas fotosensibles, ej. 24-bit, 48-bit"@es ;
                  rdfs:label "Profundidad de color"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#rangoTemperaturaFusion
:rangoTemperaturaFusion rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :Filamento3D ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Intervalo térmico de plastificación recomendado expresado en grados Celsius, umbral termodinámico crítico para asegurar un flujo laminar constante a través del obturador sin generar atascos por carbonización del polímero ni fallos de adherencia entre capas, ej. 190-220°C, 240-260°C"@es ;
                        rdfs:label "Rango de temperatura de fusión"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#rangoVelocidadRotacion
:rangoVelocidadRotacion rdf:type owl:DatatypeProperty ;
                        rdfs:domain :HerramientaRotativa ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Espectro operativo del motor de corriente continua expresado en revoluciones por minuto, crítico para ajustar la fricción térmica según la densidad del material a mecanizar y evitar la fusión accidental de polímeros termoplásticos, ej. 5000-35000 RPM"@es ;
                        rdfs:label "Rango de velocidad de rotación"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#relacionAlcance
:relacionAlcance rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Proyector ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Coeficiente óptico que relaciona la distancia de instalación del chasis con el ancho de la pantalla resultante, vital para determinar la viabilidad espacial del equipo clasificándolo en ópticas de tiro normal, corto o ultracorto, ej. 0.5:1, 1.2:1"@es ;
                 rdfs:label "Relación de alcance"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereAlimentacionDedicada
:requiereAlimentacionDedicada rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain :PerifericoVideo ;
                              rdfs:range xsd:boolean ;
                              rdfs:comment "Indicador sobre si el equipo precisa conexión directa a la red eléctrica para alcanzar su rendimiento lumínico o de procesamiento máximo, diferenciándolo de los dispositivos alimentados exclusivamente por el bus de datos"@es ;
                              rdfs:label "Requiere alimentación dedicada"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereAlimentacionExterna
:requiereAlimentacionExterna rdf:type owl:DatatypeProperty ,
                                      owl:FunctionalProperty ;
                             rdfs:domain :RecuperacionSoporteDigital ;
                             rdfs:range xsd:boolean ;
                             rdfs:comment "Indicador físico sobre si el periférico precisa conexión dedicada a la red eléctrica o si opera de forma autónoma mediante la energía suministrada por el propio bus de datos"@es ;
                             rdfs:label "Requiere alimentación externa"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereAlimentacionPhantom
:requiereAlimentacionPhantom rdf:type owl:DatatypeProperty ,
                                      owl:FunctionalProperty ;
                             rdfs:domain :Microfono ;
                             rdfs:range xsd:boolean ;
                             rdfs:comment "Indicador técnico sobre la necesidad de inyectar voltaje continuo externo, habitualmente 48V, a través de la propia conexión para polarizar la cápsula y alimentar la circuitería interna"@es ;
                             rdfs:label "Requiere alimentación Phantom"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereAnclajeMobiliario
:requiereAnclajeMobiliario rdf:type owl:DatatypeProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:domain :Encuadernacion ;
                           rdfs:range xsd:boolean ;
                           rdfs:comment "Indicador de seguridad y estabilidad sobre si la inercia del bloque o la fuerza de torsión mecánica ejercida por el usuario exige que la base esté fijada de manera semipermanente a la superficie de trabajo para prevenir accidentes o el desplazamiento indeseado de la herramient"@es ;
                           rdfs:label "Requiere anclaje a mobiliario"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereCerramientoImpresora
:requiereCerramientoImpresora rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain :Filamento3D ;
                              rdfs:range xsd:boolean ;
                              rdfs:comment "Indicador termodinámico de contracción volumétrica que especifica si el coeficiente de dilatación del polímero exige obligatoriamente su ejecución en una cámara de impresión aislada y calefactada para evitar la delaminación o el pandeo estructural de las capas base"@es ;
                              rdfs:label "Requiere cerramiento de impresora"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereComputacionExterna
:requiereComputacionExterna rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain :GafasVR ;
                            rdfs:range xsd:boolean ;
                            rdfs:comment "Dependencia arquitectónica de un equipo informático secundario para el renderizado del entorno tridimensional, diferenciando arquitecturas de procesamiento integrado o 'standalone' frente a visores que actúan como meros periféricos de un PC"@es ;
                            rdfs:label "Requiere computación externa"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereInstalacionFija
:requiereInstalacionFija rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain :Presentacion_y_Difusion ;
                         rdfs:range xsd:boolean ;
                         rdfs:comment "Indicador logístico y estructural sobre si el equipamiento exige anclaje mecánico semipermanente a la arquitectura del espacio, como techos o soportes de pared, frente a la posibilidad de un despliegue portátil libre sobre mobiliario de la biblioteca"@es ;
                         rdfs:label "Requiere instalación fija"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereLaminaTransportadora
:requiereLaminaTransportadora rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain :ViniloCorte ;
                              rdfs:range xsd:boolean ;
                              rdfs:comment "Condicionante operativo que dictamina si el sustrato exige el consumo simultáneo de un film auxiliar para trasladar el diseño troquelado desde su base protectora hasta el objeto destino manteniendo intacta la topología de los vectores flotantes"@es ;
                              rdfs:label "Requiere lámina transportadora"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereParadaOperativa
:requiereParadaOperativa rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain :IncidenciaTecnica ;
                         rdfs:range xsd:boolean ;
                         rdfs:comment "Condicionante que fuerza la inhabilitación automática de la máquina en el sistema de reservas para evitar daños mayores o accidentes hasta que un técnico la revise"@es ;
                         rdfs:label "Requiere parada operativa"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereSoftwareDedicado
:requiereSoftwareDedicado rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:domain :PerifericoVideo ;
                          rdfs:range xsd:boolean ;
                          rdfs:comment "Indicador técnico sobre la necesidad de instalar controladores propietarios o paneles de gestión específicos en el sistema operativo para desbloquear parámetros avanzados, mapeo de teclas o perfiles de color, más allá del funcionamiento genérico plug-and-play"@es ;
                          rdfs:label "Requiere software dedicado"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#resistenciaMaximaViento
:resistenciaMaximaViento rdf:type owl:DatatypeProperty ;
                         rdfs:domain :Dron ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Umbral aerodinámico límite soportado por los rotores y el algoritmo de estabilización de actitud para mantener el vuelo estacionario sin deriva, expresado habitualmente en metros por segundo, dato indispensable para evaluar la viabilidad y seguridad de la captura de datos en exteriores bajo condiciones meteorológicas adversas, ej. 10m/s"@es ;
                         rdfs:label "Resistencia máxima al viento"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionCapturaMaxima
:resolucionCapturaMaxima rdf:type owl:DatatypeProperty ;
                         rdfs:domain :DigitalizadorVideo ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Límite de líneas horizontales o píxeles efectivos que el hardware es capaz de muestrear y convertir a formato digital sin interpolación, ej. 720x576"@es ;
                         rdfs:label "Resolución de captura máxima"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionCapturaMaximaFoto
:resolucionCapturaMaximaFoto rdf:type owl:DatatypeProperty ;
                             rdfs:domain :CamaraFotografias ;
                             rdfs:range xsd:string ;
                             rdfs:comment "Máxima resolución a la que permite capturar imágenes congeladas de forma nativa, sin interpolación"@es ;
                             rdfs:label "Resolución de captura máxima de fotografía"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionCapturaMaximaVideo
:resolucionCapturaMaximaVideo rdf:type owl:DatatypeProperty ;
                              rdfs:domain :CamaraFotografias ;
                              rdfs:range xsd:string ;
                              rdfs:comment "Máxima resolución y framerate a la que permite capturar imágenes en movimiento"@es ;
                              rdfs:label "Resolución de captura máxima de vídeo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionCapturaMaximaWebCam
:resolucionCapturaMaximaWebCam rdf:type owl:DatatypeProperty ;
                               rdfs:domain :CamaraWeb ;
                               rdfs:range xsd:string ;
                               rdfs:comment "Límite estandarizado de densidad de píxeles efectivos que el sensor óptico es capaz de registrar por cada fotograma, determinante para la definición espacial y el nivel de detalle de la emisión, ej. 1080p, 4K"@es ;
                               rdfs:label "Resolución de captura máxima de webcam"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionOpticaMaxima
:resolucionOpticaMaxima rdf:type owl:DatatypeProperty ;
                        rdfs:domain :EscanerDocumental ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Nivel máximo de detalle capturado por el sensor, expresado habitualmente en puntos por pulgada o DPI, fundamental para garantizar la legibilidad en digitalizaciones de conservación."@es ;
                        rdfs:label "Resolución óptica máxima"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionOpticaMaximaDFotog
:resolucionOpticaMaximaDFotog rdf:type owl:DatatypeProperty ;
                              rdfs:domain :DigitalizadorFotografico ;
                              rdfs:range xsd:integer ;
                              rdfs:comment "Nivel máximo de densidad de píxeles capturados por el sensor, expresado en PPI, fundamental para permitir ampliaciones digitales viables a partir de formatos físicos minúsculos"@es ;
                              rdfs:label "Resolución óptica máxima de digitalizador fotográfico"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionOpticaNativa
:resolucionOpticaNativa rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Proyector ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Matriz física real de píxeles generada por el motor de imagen o los paneles internos sin recurrir a interpolación por software o escalado digital, determinante para asegurar la nitidez tipográfica estricta en presentaciones académicas, ej. 1920x1080, 3840x2160"@es ;
                        rdfs:label "Resolución óptica nativa"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionPorOjo
:resolucionPorOjo rdf:type owl:DatatypeProperty ;
                  rdfs:domain :GafasVR ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Densidad de píxeles asignada a cada panel óptico individual, determinante para mitigar el efecto rejilla de la pantalla y garantizar la legibilidad de tipografías en interfaces inmersivas, ej. 1832x1920, 2064x2208"@es ;
                  rdfs:label "Resolución por ojo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#saldoFilamentoAgotado
:saldoFilamentoAgotado rdf:type owl:DatatypeProperty ;
                       rdfs:domain :ComunidadUniversitaria ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "Indicativo encargado de reflejar si el usuario en cuestión ha agotado los 200g de filamento que la biblioteca aporta de manera gratuita."@es ;
                       rdfs:label "Saldo de filamento agotado"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemaEmisionSoportado
:sistemaEmisionSoportado rdf:type owl:DatatypeProperty ;
                         rdfs:domain :DigitalizadorVideo ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Compatibilidad de decodificación del hardware con los estándares internacionales de señal de televisión analógica, ej. PAL, NTSC, SECAM"@es ;
                         rdfs:label "Sistema de emisión soportado"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemaOperativoInstalado
:sistemaOperativoInstalado rdf:type owl:DatatypeProperty ;
                           rdfs:domain :Ordenador ;
                           rdfs:range xsd:string ;
                           rdfs:comment "Plataforma de software base encargada de la gestión de los recursos de hardware y la ejecución de entornos de usuario, factor crítico para auditar la compatibilidad de las aplicaciones institucionales y herramientas de desarrollo, ej. Windows 11 Pro, Ubuntu LTS"@es ;
                           rdfs:label "Sistema operativo instalado"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemaPosicionamientoEspacial
:sistemaPosicionamientoEspacial rdf:type owl:DatatypeProperty ;
                                rdfs:domain :PerifericoVideo ;
                                rdfs:range xsd:string ;
                                rdfs:comment "Configuración mecánica o base de apoyo requerida para integrar y estabilizar el dispositivo en el entorno operativo, ej. Soporte de sobremesa antideslizante, Trípode, Zapata"@es ;
                                rdfs:label "Sistema de posicionamiento espacial"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemaTraccion
:sistemaTraccion rdf:type owl:DatatypeProperty ;
                 rdfs:domain :LectorVinilo ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Mecanismo físico de transferencia de movimiento desde el motor hasta el plato giratorio, determinante para la estabilidad de la rotación y el aislamiento de vibraciones, ej. Correa, Directa"@es ;
                 rdfs:label "Sistema de tracción"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemasArchivosCompatibles
:sistemasArchivosCompatibles rdf:type owl:DatatypeProperty ;
                             rdfs:domain :RecuperacionSoporteDigital ;
                             rdfs:range xsd:string ;
                             rdfs:comment "Formatos lógicos de volumen históricos que el hardware y su controlador son capaces de interpretar para montar el soporte en el sistema operativo huésped, ej. FAT12, ISO 9660, UDF"@es ;
                             rdfs:label "Sistemas de archivos compatibles"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemasReduccionRuido
:sistemasReduccionRuido rdf:type owl:DatatypeProperty ;
                        rdfs:domain :LectorCasete ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Filtros analógicos integrados en el hardware para atenuar el siseo de alta frecuencia propio del soporte magnético durante la reproducción, ej. Dolby B, Dolby C"@es ;
                        rdfs:label "Sistemas de reducción de ruido"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#softwareGestionPrincipal
:softwareGestionPrincipal rdf:type owl:DatatypeProperty ;
                          rdfs:domain :OrdenadorAdministracion ;
                          rdfs:range xsd:string ;
                          rdfs:comment "Cliente de administración integral o sistema de planificación de recursos empresariales desplegado específicamente en la terminal, determinante para acotar si el puesto está habilitado para realizar altas de inventario, auditorías o simples reservas, ej. Koha, Alma, SAP"@es ;
                          rdfs:label "Software de gestión principal"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#soportaNavegacionWaypoints
:soportaNavegacionWaypoints rdf:type owl:DatatypeProperty ;
                            rdfs:domain :Dron ;
                            rdfs:range xsd:boolean ;
                            rdfs:comment "Capacidad del firmware operativo para interpretar y ejecutar misiones de vuelo preprogramadas mediante una malla de coordenadas espaciales GNSS"@es ;
                            rdfs:label "Soporta navegación por waypoints"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#soporteFisicoAdmitido
:soporteFisicoAdmitido rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Digitalizacion ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Naturaleza o formato físico del material original que el dispositivo está capacitado para leer, capturar o transcodificar, ej. Documento impreso, Cinta magnética, Película fotosensible"@es ;
                       rdfs:label "Soporte físico admitido"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#suministraAlimentacionPhantom
:suministraAlimentacionPhantom rdf:type owl:DatatypeProperty ;
                               rdfs:domain :InterfazAudio ;
                               rdfs:range xsd:boolean ;
                               rdfs:comment "Capacidad del hardware para inyectar voltaje continuo de 48V a través de sus conectores, indispensable para habilitar la operatividad de micrófonos de condensador externos"@es ;
                               rdfs:label "Suministra alimentación Phantom"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#susceptibleDegradacionAmbiental
:susceptibleDegradacionAmbiental rdf:type owl:DatatypeProperty ;
                                 rdfs:domain :Consumible ;
                                 rdfs:range xsd:boolean ;
                                 rdfs:comment "Indicador estructural o químico que determina si la matriz del material sufre caducidad, oxidación o pérdida de propiedades mecánicas al interactuar pasivamente con la humedad relativa, la radiación ultravioleta o los gradientes térmicos del recinto, forzando la asignación de contenedores estancos o desecantes durante su almacenaje"@es ;
                                 rdfs:label "Susceptible a degradación ambiental"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tamañoSensor
:tamañoSensor rdf:type owl:DatatypeProperty ;
              rdfs:domain :CamaraFotografias ;
              rdfs:range xsd:string ;
              rdfs:comment "Tamaño expresado en pulgadas del sensor principal del equipo"@es ;
              rdfs:label "Tamaño de sensor"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tasaFotogramasMaximaWebCam
:tasaFotogramasMaximaWebCam rdf:type owl:DatatypeProperty ;
                            rdfs:domain :CamaraWeb ;
                            rdfs:range xsd:integer ;
                            rdfs:comment "Número límite de imágenes fijas consecutivas capturadas por segundo en la resolución operativa óptima, vital para garantizar la fluidez temporal y la naturalidad del movimiento en la transmisión, ej. 30 fps, 60 fps"@es ;
                            rdfs:label "Tasa de fotogramas máxima de webcam"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tasaRefrescoNativa
:tasaRefrescoNativa rdf:type owl:DatatypeProperty ;
                    rdfs:domain :GafasVR ;
                    rdfs:range xsd:integer ;
                    rdfs:comment "Frecuencia de actualización de los paneles expresada en hercios, umbral físico indispensable para prevenir la cinetosis o mareo por movimiento durante la traslación virtual del usuario, ej. 90Hz, 120Hz"@es ;
                    rdfs:label "Tasa de refresco nativa"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tecnologiaGeneracionLaser
:tecnologiaGeneracionLaser rdf:type owl:DatatypeProperty ;
                           rdfs:domain :CorteLaser ;
                           rdfs:range xsd:string ;
                           rdfs:comment "Naturaleza física del medio activo empleado para la amplificación de la luz, crucial para determinar la compatibilidad de alteración sobre sustratos orgánicos, polímeros o metálicos puros, ej. CO2, Diodo, Estado sólido"@es ;
                           rdfs:label "Tecnología de generación láser"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tecnologiaMemoriaRAMPC
:tecnologiaMemoriaRAMPC rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Ordenador ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Estándar físico y de velocidad de los módulos de memoria integrados en la placa, necesario para determinar la tasa de transferencia de datos interna y evaluar la compatibilidad de los componentes, ej. DDR4, DDR5"@es ;
                        rdfs:label "Tecnología de memoria RAM de PC"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#telefonoContacto
:telefonoContacto rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Usuario ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Dato requerido en caso de ser necesario contactar de urgencia con el usuario"@es ;
                  rdfs:label "Teléfono de contacto"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaColorIluminacion
:temperaturaColorIluminacion rdf:type owl:DatatypeProperty ;
                             rdfs:domain :EstudioFotograficoPortatil ;
                             rdfs:range xsd:integer ;
                             rdfs:comment "Valor espectral de los paneles LED integrados expresado en grados Kelvin, métrica ineludible para asegurar la fidelidad cromática estricta de las piezas documentadas sin requerir correcciones agresivas de balance de blancos en postproducción, ej. 5500K"@es ;
                             rdfs:label "Temperatura de color de iluminación"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaColorVariable
:temperaturaColorVariable rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Iluminacion ;
                          rdfs:range xsd:boolean ;
                          rdfs:comment "Capacidad del hardware para alternar electrónicamente los grados Kelvin emitidos, permitiendo igualar la luz ambiental o crear atmósferas específicas sin emplear filtros plásticos físicos, ej. 2700K a 6500K"@es ;
                          rdfs:label "Temperatura de color variable"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaMaximaExtrusor
:temperaturaMaximaExtrusor rdf:type owl:DatatypeProperty ;
                           rdfs:domain :Impresora_FDM ;
                           rdfs:range xsd:integer ;
                           rdfs:comment "Límite técnico del cabezal de impresión expresado en grados Celsius, crucial para determinar la compatibilidad con materiales avanzados"@es ;
                           rdfs:label "Temperatura máxima de extrusor"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaMaximaOperativa
:temperaturaMaximaOperativa rdf:type owl:DatatypeProperty ;
                            rdfs:domain :PrensaTermica ;
                            rdfs:range xsd:integer ;
                            rdfs:comment "Límite superior térmico de la platina calefactora expresado en grados, vital para determinar la compatibilidad con procesos de transferencia por sublimación de alta exigencia frente a aplicaciones de vinilo textil estándar de baja fusión"@es ;
                            rdfs:label "Temperatura máxima operativa"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaMaximaOperativaSoldador
:temperaturaMaximaOperativaSoldador rdf:type owl:DatatypeProperty ;
                                    rdfs:domain :Soldadura_y_Ensamblaje ;
                                    rdfs:range xsd:integer ;
                                    rdfs:comment "Límite superior de emisión calórica alcanzable por el elemento calefactor en estado de máximo rendimiento, expresado en grados Celsius, crítico para certificar la viabilidad de fusión sobre aleaciones de alta densidad libres de plomo y evaluar el riesgo de delaminación en circuitos impresos, ej. 450°C, 500°C"@es ;
                                    rdfs:label "Temperatura máxima operativa de soldador"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaMaximaSecado
:temperaturaMaximaSecado rdf:type owl:DatatypeProperty ;
                         rdfs:domain :SecadorFilamento ;
                         rdfs:range xsd:integer ;
                         rdfs:comment "Límite térmico alcanzable por el dispositivo expresado en grados Celsius, determinante para secar materiales técnicos que así lo requieran"@es ;
                         rdfs:label "Temperatura máxima de secado"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneAltavocesIntegrados
:tieneAltavocesIntegrados rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Proyector ;
                          rdfs:range xsd:boolean ;
                          rdfs:comment "Presencia de un sistema de transducción acústica embebido en el propio chasis del dispositivo, crítico para evaluar la autonomía del equipamiento en la reproducción de pistas de audio asociadas a la señal de vídeo sin obligar al usuario a desplegar sistemas de megafonía o periféricos independientes"@es ;
                          rdfs:label "Tiene altavoces integrados"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneAperturaCenital
:tieneAperturaCenital rdf:type owl:DatatypeProperty ;
                      rdfs:domain :EstudioFotograficoPortatil ;
                      rdfs:range xsd:boolean ;
                      rdfs:comment "Presencia de trampillas o ventanas de inspección en la cúpula superior del habitáculo, diseñadas para habilitar la captura macrofotográfica en ángulo picado perpendicular sin proyectar sombras del dispositivo móvil o la cámara sobre el componente"@es ;
                      rdfs:label "Tiene apertura cenital"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneAsistenciaOptica
:tieneAsistenciaOptica rdf:type owl:DatatypeProperty ;
                       rdfs:domain :EstacionSoldadura ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "Presencia de lentes de aumento articuladas o sistemas de iluminación focalizada anclados físicamente al chasis de la estación, diseñados para facilitar la inspección visual directa de soldaduras microscópicas durante la intervención manual"@es ;
                       rdfs:label "Tiene asistencia óptica"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneAutoreverse
:tieneAutoreverse rdf:type owl:DatatypeProperty ;
                  rdfs:domain :LectorCasete ;
                  rdfs:range xsd:boolean ;
                  rdfs:comment "Capacidad mecánica del sistema de tracción y cabezales para invertir el sentido de lectura automáticamente al finalizar una cara, permitiendo la digitalización continua e ininterrumpida del soporte completo"@es ;
                  rdfs:label "Tiene autoreverse"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneBloqueoCuchilla
:tieneBloqueoCuchilla rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Guillotina ;
                      rdfs:range xsd:boolean ;
                      rdfs:comment "Disponibilidad de un pestillo o fiador mecánico de seguridad estructural que ancla el brazo principal en su posición inferior de reposo, evitando la exposición o elevación accidental del filo mientras el dispositivo no está en uso"@es ;
                      rdfs:label "Tiene bloqueo de cuchilla"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneCabinaCerrada
:tieneCabinaCerrada rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Impresora3D ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "(Indicador físico sobre la presencia de un cerramiento estructural alrededor del área de impresión, vital para filtrado de gases, control térmico o protección UV)."@es ;
                    rdfs:label "Tiene cabina cerrada"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneCalibracionAutomatica
:tieneCalibracionAutomatica rdf:type owl:DatatypeProperty ;
                            rdfs:domain :Impresora3D ;
                            rdfs:range xsd:boolean ;
                            rdfs:comment "Indicador técnico sobre la presencia de sensores de nivelación autónoma en la base de impresión, lo que reduce la intervención manual del usuario"@es ;
                            rdfs:label "Tiene calibración automática"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneCamaCaliente
:tieneCamaCaliente rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Impresora_FDM ;
                   rdfs:range xsd:boolean ;
                   rdfs:comment "Indicador técnico sobre la presencia de una base térmica en la superficie de impresión, determinante para evitar el despegue de polímeros que sufren de contracción térmica"@es ;
                   rdfs:label "Tiene cama caliente"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneCompensacionLuzBaja
:tieneCompensacionLuzBaja rdf:type owl:DatatypeProperty ;
                          rdfs:domain :CamaraWeb ;
                          rdfs:range xsd:boolean ;
                          rdfs:comment "Capacidad del firmware interno integrado para ajustar dinámicamente la ganancia del sensor y el tiempo de exposición ante entornos pobremente iluminados, priorizando la legibilidad del sujeto principal frente a la aparición de artefactos o ruido digital"@es ;
                          rdfs:label "Tiene compensación de luz baja"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneControlTemperaturaVariable
:tieneControlTemperaturaVariable rdf:type owl:DatatypeProperty ;
                                 rdfs:domain :EstacionSoldadura ;
                                 rdfs:range xsd:boolean ;
                                 rdfs:comment "Disponibilidad de un módulo de gestión electrónica en la unidad base que permite el ajuste preciso de los grados de emisión térmica en tiempo real, vital para adaptar el calor a diferentes aleaciones de soldadura sin dañar componentes sensibles"@es ;
                                 rdfs:label "Tiene control de temperatura variable"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneDeteccionMarcasRegistro
:tieneDeteccionMarcasRegistro rdf:type owl:DatatypeProperty ;
                              rdfs:domain :CortadoraVinilo ;
                              rdfs:range xsd:boolean ;
                              rdfs:comment "Disponibilidad de un sensor óptico o infrarrojo integrado en el carro de corte para el escaneo autónomo de guías perimetrales, indispensable para la alineación y el seccionado preciso de contornos sobre gráficos generados previamente en periféricos de impresión externos"@es ;
                              rdfs:label "Tiene detección de marcas de registro"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneDeteccionObstaculos
:tieneDeteccionObstaculos rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Dron ;
                          rdfs:range xsd:boolean ;
                          rdfs:comment "Presencia de un array de sensores de visión computacional o infrarrojos perimetrales integrados en el controlador principal, capacidad crítica para intervenir los comandos direccionales y frenar la aeronave autónomamente ante colisiones inminentes, salvaguardando la integridad física del equipo prestado"@es ;
                          rdfs:label "Tiene detección de obstáculos"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneEscanerInventario
:tieneEscanerInventario rdf:type owl:DatatypeProperty ;
                        rdfs:domain :OrdenadorAdministracion ;
                        rdfs:range xsd:boolean ;
                        rdfs:comment "Presencia de un sistema de lectura óptica láser o de imágenes posicionado en el puesto de trabajo, indispensable para la captura automatizada de las etiquetas de catalogación del instrumental físico durante los procesos de entrega y devolución"@es ;
                        rdfs:label "Tiene escáner de inventario"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneGuiasMedicion
:tieneGuiasMedicion rdf:type owl:DatatypeProperty ;
                    rdfs:domain :TapeteCorte ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Disponibilidad de un patrón gráfico impreso en la superficie operativa que incluye cuadrículas milimetradas y ángulos estandarizados, diseñado para facilitar la alineación geométrica y el dimensionado del sustrato sin requerir instrumental de dibujo adicional"@es ;
                    rdfs:label "Tiene guías de medición"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneIluminacionIntegrada
:tieneIluminacionIntegrada rdf:type owl:DatatypeProperty ;
                           rdfs:domain :CamaraWeb ;
                           rdfs:range xsd:boolean ;
                           rdfs:comment "Presencia de un sistema de diodos emisores de luz físicos acoplados en el chasis perimetral del objetivo, diseñado para proporcionar iluminación frontal de compensación directa sobre el sujeto operativo sin requerir la instalación de periféricos lumínicos externos"@es ;
                           rdfs:label "Tiene iluminación integrada"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneMotorSonidoIntegrado
:tieneMotorSonidoIntegrado rdf:type owl:DatatypeProperty ;
                           rdfs:domain :InstrumentoMusical ;
                           rdfs:range xsd:boolean ;
                           rdfs:comment "Indicador sobre la capacidad del hardware para generar ondas de audio de forma autónoma, lo que permite discriminar entre sintetizadores o instrumentos de cuerda física frente a superficies de control puro que dependen obligatoriamente de instrumentos virtuales en la estación de trabajo"@es ;
                           rdfs:label "Tiene motor de sonido integrado"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneObturadorPrivacidad
:tieneObturadorPrivacidad rdf:type owl:DatatypeProperty ;
                          rdfs:domain :CamaraWeb ;
                          rdfs:range xsd:boolean ;
                          rdfs:comment "Presencia de un mecanismo físico deslizante o cubierta magnética que bloquea mecánicamente el acceso visual a la lente, garantizando la seguridad perimetral del entorno contra transmisiones no autorizadas sin depender de anulaciones por software"@es ;
                          rdfs:label "Tiene obturador de privacidad"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tienePantallaTactil
:tienePantallaTactil rdf:type owl:DatatypeProperty ;
                     rdfs:domain :ControladorRealizacion ;
                     rdfs:range xsd:boolean ;
                     rdfs:comment "Disponibilidad de una superficie de visualización interactiva adicional a los botones físicos, diseñada para ampliar la capacidad de control mediante gestos de deslizamiento lateral o monitorización de métricas del directo"@es ;
                     rdfs:label "Tiene pantalla táctil"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tienePedalCaptura
:tienePedalCaptura rdf:type owl:DatatypeProperty ;
                   rdfs:domain :EscanerCenital ;
                   rdfs:range xsd:boolean ;
                   rdfs:comment "Presencia de un periférico de accionamiento mediante el pie, indispensable para liberar las manos del operador al pasar páginas o manipular material histórico delicado"@es ;
                   rdfs:label "Tiene pedal de captura"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tienePisonRetencion
:tienePisonRetencion rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Guillotina ;
                     rdfs:range xsd:boolean ;
                     rdfs:comment "Presencia de un mecanismo de presión de ajuste manual o automático que inmoviliza el bloque de sustrato contra la base operativa, previniendo el desplazamiento o abanico lateral durante el cizallado para garantizar una escuadra perfecta"@es ;
                     rdfs:label "Tiene pisón de retención"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tienePreamplificadorIntegrado
:tienePreamplificadorIntegrado rdf:type owl:DatatypeProperty ;
                               rdfs:domain :DigitalizadorAudio ;
                               rdfs:range xsd:boolean ;
                               rdfs:comment "Indicador técnico sobre la inclusión de circuitería interna para elevar la señal cruda del soporte físico a nivel de línea, indispensable para su inyección directa a la interfaz de captura del ordenador"@es ;
                               rdfs:label "Tiene preamplificador integrado"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneRegulacionIntensidad
:tieneRegulacionIntensidad rdf:type owl:DatatypeProperty ;
                           rdfs:domain :Iluminacion ;
                           rdfs:range xsd:boolean ;
                           rdfs:comment "Disponibilidad de un atenuador o dimmer integrado para controlar de forma progresiva el porcentaje de potencia de salida de los diodos, permitiendo ajustar la exposición sin alterar la distancia física del foco"@es ;
                           rdfs:label "Tiene regulación de intensidad"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneRetroalimentacionVisualDinamica
:tieneRetroalimentacionVisualDinamica rdf:type owl:DatatypeProperty ;
                                      rdfs:domain :ControladorRealizacion ;
                                      rdfs:range xsd:boolean ;
                                      rdfs:comment "Presencia de paneles visuales bajo los interruptores o en el chasis para mostrar iconos personalizables que cambian reflejando el estado en tiempo real de la función asignada"@es ;
                                      rdfs:label "Tiene retroalimentación visual dinámica"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneSuperficieNoPorosa
:tieneSuperficieNoPorosa rdf:type owl:DatatypeProperty ;
                         rdfs:domain :UtillajeMezcla ;
                         rdfs:range xsd:boolean ;
                         rdfs:comment "Condición física del material de contacto que impide la absorción capilar de los pigmentos líquidos, requisito ineludible para garantizar la recuperación total del color preparado y permitir una limpieza por arrastre sin dejar manchas residuales"@es ;
                         rdfs:label "Tiene superficie no porosa"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneTrackingAutomatico
:tieneTrackingAutomatico rdf:type owl:DatatypeProperty ;
                         rdfs:domain :LectorVideo ;
                         rdfs:range xsd:boolean ;
                         rdfs:comment "Indicador sobre la capacidad del hardware para autoajustar la alineación del cabezal con las pistas magnéticas diagonales, minimizando el ruido visual sin intervención manual"@es ;
                         rdfs:label "Tiene tracking automático"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tipoDeMedioAuxiliar
:tipoDeMedioAuxiliar rdf:type owl:DatatypeProperty ;
                     rdfs:domain :MedioAuxiliar ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Se especifica el nombre autorizado del medio auxiliar en cuestión"@es ;
                     rdfs:label "Tipo de medio auxiliar"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tipoSoporteObjetivo
:tipoSoporteObjetivo rdf:type owl:DatatypeProperty ;
                     rdfs:domain :SoporteObjetivo ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Naturaleza del elemento a personalizar, camiseta, taza…"@es ;
                     rdfs:label "Tipo de soporte objetivo"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tipoTransductor
:tipoTransductor rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Microfono ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Tecnología interna de conversión acústico-eléctrica que determina la respuesta en frecuencias y la sensibilidad general del equipo, ej. Condensador, Dinámico"@es ;
                 rdfs:label "Tipo de transductor"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tiposCintaAdmitidos
:tiposCintaAdmitidos rdf:type owl:DatatypeProperty ;
                     rdfs:domain :LectorCasete ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Niveles de polarización y ecualización soportados por el cabezal de lectura según la formulación de la cinta magnética, ej. Tipo I Normal, Tipo II Cromo, Tipo IV Metal"@es ;
                     rdfs:label "Tipos de cinta admitidos"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#titulacionEnCurso
:titulacionEnCurso rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Estudiante ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Programa académico oficial en el que está matriculado el alumno, un dato muy útil para que el taller pueda priorizar el uso de ciertas máquinas hacia estudiantes de ingenierías o bellas artes durante las épocas de entregas finales"@es ;
                   rdfs:label "Titulación en curso"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#toleraLentesOftalmicas
:toleraLentesOftalmicas rdf:type owl:DatatypeProperty ;
                        rdfs:domain :SeguimientoOcular ;
                        rdfs:range xsd:boolean ;
                        rdfs:comment "Capacidad del algoritmo de visión artificial y del filtrado de espectro infrarrojo para descartar reflejos especulares y aberraciones ópticas provocadas por gafas graduadas o lentes de contacto sin comprometer la calibración del modelo biométrico del ojo"@es ;
                        rdfs:label "Tolera lentes oftálmicas"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tonalidadCromatica
:tonalidadCromatica rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Filamento3D ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Pigmentación integrada en la matriz del polímero durante su fabricación, atributo visual ineludible para la distinción de existencias en el inventario y la asignación estética del material en proyectos de prototipado rápido o piezas finales, ej. Rojo, Blanco mate, Negro"@es ;
                    rdfs:label "Tonalidad cromática"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#tonalidadIncrustacion
:tonalidadIncrustacion rdf:type owl:DatatypeProperty ;
                       rdfs:domain :FondoCromatico ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Espectro cromático dominante de la superficie diseñado para ofrecer el máximo contraste con los tonos de piel humanos y el vestuario, facilitando la transparencia por software, ej. Verde, Azul"@es ;
                       rdfs:label "Tonalidad de incrustación"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#velocidadCorteMaxima
:velocidadCorteMaxima rdf:type owl:DatatypeProperty ;
                      rdfs:domain :CortadoraVinilo ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "Límite máximo de desplazamiento lineal simultáneo del cabezal operativo y los rodillos de tracción, expresado habitualmente en milímetros por segundo, crítico para estimar la eficiencia temporal y el rendimiento productivo de la máquina frente a tiradas extensas o trazados vectoriales de alta densidad"@es ;
                      rdfs:label "Velocidad de corte máxima"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#velocidadLecturaMaxima
:velocidadLecturaMaxima rdf:type owl:DatatypeProperty ;
                        rdfs:domain :RecuperacionSoporteDigital ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Tasa límite de transferencia de datos desde el soporte extraíble a la estación de trabajo, determinante para calcular tiempos de extracción en copias de seguridad de gran volumen, ej. 52x, 500 KB/s"@es ;
                        rdfs:label "Velocidad de lectura máxima"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#velocidadesReproduccion
:velocidadesReproduccion rdf:type owl:DatatypeProperty ;
                         rdfs:domain :LectorVinilo ;
                         rdfs:range xsd:string ;
                         rdfs:comment "Tasas de rotación soportadas mecánicamente por el motor del giradiscos para asegurar la lectura adecuada de distintos formatos históricos, ej. 33, 45, 78 RPM"@es ;
                         rdfs:label "Velocidades de reproducción"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#velocidadesReproduccionSoportadas
:velocidadesReproduccionSoportadas rdf:type owl:DatatypeProperty ;
                                   rdfs:domain :LectorVideo ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "Modos de arrastre de la cinta magnética admitidos por el tambor de lectura, esenciales para recuperar grabaciones de larga duración, ej. SP, LP, EP"@es ;
                                   rdfs:label "Velocidades de reproducción soportadas"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#voltajeOperativoLogico
:voltajeOperativoLogico rdf:type owl:DatatypeProperty ;
                        rdfs:domain :PlacaDesarrollo ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Nivel de tensión eléctrica estandarizada a la que operan los circuitos integrados y buses de datos de la placa, crítico para garantizar la compatibilidad electrónica directa con módulos de sensores externos sin requerir la intercalación de conversores lógicos de nivel, ej. 3.3V, 5V"@es ;
                        rdfs:label "Voltaje operativo lógico"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#volumenImpresion
:volumenImpresion rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Impresora3D ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Dimensiones máximas del área de trabajo admitidas por la máquina, expresadas en milímetros (ej. 220x220x250)"@es ;
                  rdfs:label "Volumen de impresión"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#volumenMaximoEscaneo
:volumenMaximoEscaneo rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Escaner3D ;
                      rdfs:range xsd:string ;
                      rdfs:comment "Dimensiones físicas límite o área máxima de barrido que el sensor es capaz de procesar para generar una malla tridimensional cerrada, habitualmente expresado en milímetros"@es ;
                      rdfs:label "Volumen máximo de escaneo"@es .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/ontologies/2026/bibliomaker#AccesorioBrazoHerramientaRotativa
:AccesorioBrazoHerramientaRotativa rdf:type owl:Class ;
                                   rdfs:subClassOf :Otros ;
                                   rdfs:comment "Brazos flexibles extensores y adaptadores para control espacial de profundidad"@es ;
                                   rdfs:label "Accesorio de brazo para herramienta rotativa"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#AcondicionamientoEstudio
:AcondicionamientoEstudio rdf:type owl:Class ;
                          rdfs:subClassOf :Streaming ;
                          rdfs:comment "Estructuras pasivas para el aislamiento y modificación del entorno visual"@es ;
                          rdfs:label "Acondicionamiento de estudio"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#AdaptadoresPrensa
:AdaptadoresPrensa rdf:type owl:Class ;
                   rdfs:subClassOf :CorteEstampadoVinilo ;
                   rdfs:comment "Módulos térmicos intercambiables para intervención sobre superficies curvas y cerámicas"@es ;
                   rdfs:label "Adaptadores de prensa"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#Administradores
:Administradores rdf:type owl:Class ;
                 rdfs:subClassOf :Usuario ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :emiteAviso ;
                                   owl:someValuesFrom :IncidenciaTecnica
                                 ] ;
                 rdfs:comment "Operadores con privilegios de administración, mantenimiento y control de inventario"@es ;
                 rdfs:label "Administradores"@es .


###  http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraFotografias
