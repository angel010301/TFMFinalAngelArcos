###  http://www.semanticweb.org/ontologies/2026/bibliomaker#CorteLaser
:CorteLaser rdf:type owl:Class ;
            rdfs:subClassOf :Equipamiento ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :seOperaMediante ;
                              owl:someValuesFrom :OrdenadorEstacionTrabajo
