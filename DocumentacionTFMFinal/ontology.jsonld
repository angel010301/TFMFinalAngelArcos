    "@language" : "es",
    "@value" : "Número de cabezales"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#observacionNivelStock",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Registro de texto en el que el usuario detalla de forma aproximada la cantidad sobrante que ha detectado visualmente en la caja o la estantería, sirviendo como aviso preliminar para que el coordinador audite el inventario real, ej. \"Queda menos de medio bote\", \"Solo quedan dos brocas sanas\""
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
