  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Cantidad de lectores magnéticos instalados en el tambor rotatorio, determinante para la fidelidad de la imagen en pausa y la decodificación de audio estéreo Hi-Fi"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorVideo"
  } ],
