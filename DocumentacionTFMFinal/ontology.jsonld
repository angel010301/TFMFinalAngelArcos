}, {
  "@id" : "http://purl.org/dc/terms/abstract",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://purl.org/dc/terms/license",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/elements/1.1/contributor" : [ {
    "@language" : "es",
    "@value" : "Martín Vega, Consuelo"
  }, {
    "@language" : "es",
    "@value" : "Morales del Castillo, José Manuel"
  } ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@language" : "es",
    "@value" : "Arcos Sánchez, Ángel"
  } ],
  "http://purl.org/dc/elements/1.1/date" : [ {
    "@language" : "es",
    "@value" : "2026-06-01T16:00:00"
  } ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@language" : "es",
    "@value" : "El vocabulario articula cuatro superclases principales para estructurar el dominio (Equipamiento, Consumible, Usuario y Gestión). El diseño lógico establece propiedades de datos para registrar los atributos inmutables del hardware y propiedades de objeto direccionales que resuelven las tripletas lógicas entre la maquinaria tecnológica, el material fungible dependiente y la interacción administrativa humana dentro del recinto."
  }, {
    "@language" : "es",
    "@value" : "La instanciación de este esquema semántico responde a la necesidad institucional y operativa de estandarizar los procesos internos de un laboratorio de fabricación digital. Mediante la aplicación de principios de ingeniería ontológica, se persigue mitigar la ambigüedad documental en el inventario y garantizar la interoperabilidad y reutilización de los datos de soporte logístico a largo plazo."
  } ],
  "http://purl.org/dc/elements/1.1/identifier" : [ {
    "@language" : "es",
    "@value" : "http://www.semanticweb.org/ontologies/2026/bibliomaker"
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "es",
    "@value" : "Ontología para la Gestión Integral de espacios Maker en Bibliotecas Universitarias."
  } ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "es",
    "@value" : "El presente modelo semántico establece la estructura lógica conceptual para la gestión integral de espacios maker en Bibliotecas Universitarias. Su diseño abarca la categorización jerárquica del equipamiento de fabricación digital, el control logístico de los materiales consumibles y la trazabilidad de los flujos burocráticos, incluyendo reservas, capacitación técnica y reportes de mantenimiento por parte de la comunidad universitaria."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@language" : "es",
    "@value" : "https://creativecommons.org/licenses/by-nc-sa/4.0/"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@language" : "es",
    "@value" : "1.0.3"
  } ]
