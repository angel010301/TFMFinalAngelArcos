}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#flujoLuminosoMaximo",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Potencia bruta de emisión del sistema, expresada habitualmente en lúmenes, vital para calcular la cobertura espacial del set o contrarrestar el sangrado de luz natural directa por las ventanas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#Iluminacion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Flujo luminoso máximo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#flujoLuminosoMaximoProyector",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Potencia lumínica absoluta de la fuente de emisión estandarizada bajo la norma ANSI y expresada en lúmenes, factor crítico para garantizar la legibilidad del área proyectada en salas con alta contaminación de luz ambiental, ej. 3000, 5000"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#Proyector"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Flujo luminoso máximo de proyector"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#fondo_croma_001",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ontologies/2026/bibliomaker#dimensionesFisicasSoporte" : [ {
