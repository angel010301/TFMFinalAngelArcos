    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#moduloTermicoEsAcopladoEn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Conexión física que asocia la base principal de presión y calor con las distintas resistencias periféricas intercambiables, necesarias para transferir diseños sobre superficies no planas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
