  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoCintaVideo",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorVideo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
