    "@language" : "es",
    "@value" : "Volumen de memoria no volátil embebida en la propia arquitectura del visor expresada en gigabytes, límite operativo crítico para sistemas autónomos que exigen la instalación directa de simuladores y la carga de mallas tridimensionales en local, ej. 128GB, 512GB"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#GafasVR"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Capacidad de almacenamiento interno"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadAlmacenamientoPrincipal",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Espacio total de memoria no volátil disponible en la unidad de disco local expresado en gigabytes, métrica indispensable para controlar la capacidad de instalación de software masivo y la persistencia de archivos locales, ej. 512, 1024"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Capacidad de almacenamiento principal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadBandejaAlimentacion",
