  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Estándar del puerto físico o receptáculo integrado diseñado para el suministro primario de corriente continua desde una fuente externa, vital para la planificación de la autonomía energética o el diseño de la carcasa del montaje final, ej. USB-C, Jack de barril"
  } ],
