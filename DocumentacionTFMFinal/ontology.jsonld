  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Denominación comercial y técnica del microprocesador central que determina la generación y el modelo específico del chip, parámetro esencial para evaluar la capacidad de cómputo bruto del sistema, ej. Intel Core i7-12700H, AMD Ryzen 5 5700X"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"
  } ],
