  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Diseño geométrico tridimensional de la cara expuesta del material, optimizado mecánicamente para la difracción o mitigación de rangos de frecuencia acústica específicos, ej. Piramidal, Trampa de graves, Liso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#PanelAcustico"
