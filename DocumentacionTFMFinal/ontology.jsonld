  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#toleraLentesOftalmicas",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Capacidad del algoritmo de visión artificial y del filtrado de espectro infrarrojo para descartar reflejos especulares y aberraciones ópticas provocadas por gafas graduadas o lentes de contacto sin comprometer la calibración del modelo biométrico del ojo"
  } ],
