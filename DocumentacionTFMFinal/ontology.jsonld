  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Pigmentación integrada en la matriz del polímero durante su fabricación, atributo visual ineludible para la distinción de existencias en el inventario y la asignación estética del material en proyectos de prototipado rápido o piezas finales, ej. Rojo, Blanco mate, Negro"
  } ],
