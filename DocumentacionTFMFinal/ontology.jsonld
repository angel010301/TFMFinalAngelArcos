}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#incluyeAccesorios",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Indicador logístico que registra si el chasis se entrega conjuntamente con elementos de protección estructural y alimentación externa, como fundas acolchadas o transformadores de corriente, indispensable para auditar la devolución íntegra del recurso prestado"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
