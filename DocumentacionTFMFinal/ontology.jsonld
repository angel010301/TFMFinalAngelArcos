  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#patronPolar",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Sensibilidad direccional del dispositivo respecto a la fuente acústica, fundamental para predecir y mitigar la captación de ruido ambiente o reverberación de la sala, ej. Cardioide, Omnidireccional, Bidireccional"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#Microfono"
  } ],
