  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoDiscoMagnetico",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorDiscosMagneticos"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Formato disco magnético"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoNormalizadoMaximo",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Dimensión estandarizada límite, habitualmente expresada mediante la serie A de la norma ISO 216, que el área de operación es capaz de abarcar íntegramente sin requerir la partición o el plegado previo del sustrato, vital para planificar el postprocesado de los pliegos impresos, ej. A3, A4"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#Encuadernacion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Formato normalizado máximo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoPapelMaximo",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Tamaño estandarizado límite del documento físico que la superficie o campo visual del equipo puede abarcar en una sola captura, ej. A4, A3, Din-A2"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerDocumental"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Formato de papel máximo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoSalidaPrincipal",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Extensión o tipo de archivo digital estándar que el equipo genera como resultado nativo del proceso de captura o volcado, ej. PDF, STL, WAV, MP4, ISO"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#Digitalizacion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Formato de salida principal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoSuministroFisico",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Configuración geométrica de entrega y almacenaje del material en bruto, indispensable para que la logística del recinto asigne almacenamiento de carga plana o soportes cilíndricos de desenrollado continuo, determinando además la compatibilidad con los sistemas de alimentación de la maquinaria, ej. Tablero plano, Bobina"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#MaterialSustractivo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Formato de suministro físico"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#formatosDiscoAdmitidos",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Tipos de soportes ópticos estandarizados que el láser del dispositivo es capaz de reconocer, fundamentales para la ingesta de colecciones de distintas generaciones, ej. CD-ROM, DVD±R, BD-RE"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorOptico"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Formatos de disco admitidos"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#frecuenciaBaseProcesador",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Velocidad de reloj nominal de los núcleos principales del circuito integrado expresada en gigahercios, fundamental para evaluar la capacidad de cómputo bruto del dispositivo frente a tareas de procesamiento masivo de datos o ejecución de scripts concurrentes, ej. 1.5GHz, 2.4GHz"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPlacaUnica"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Frecuencia base de procesador"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#frecuenciaMuestreoMaxima",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Nivel límite de fidelidad en la conversión analógico-digital de la onda sonora, determinante para el rango dinámico de la captura, ej. 44.1kHz, 96kHz"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorAudio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Frecuencia de muestreo máxima"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#frecuenciaRelojOperativa",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Velocidad de procesamiento del oscilador de cuarzo interno expresada habitualmente en megahercios, fundamental para determinar la viabilidad del dispositivo en operaciones estrictas de tiempo real y cálculo de interrupciones, ej. 16MHz, 133MHz"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#Microcontrolador"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Frecuencia de reloj operativa"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#fuerzaCorteMaxima",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Presión límite de empuje vertical ejercida por el electroimán del cabezal sobre la cuchilla, habitualmente expresada en gramos-fuerza, crítica para evaluar la penetración en sustratos densos o multicapa sin provocar el bloqueo del motor transversal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#CortadoraVinilo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Fuerza de corte máxima"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#generoUsuario",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Clasificación demográfica del individuo, un dato estadístico que suelen requerir las instituciones académicas para elaborar memorias anuales y evaluar los perfiles de uso de las instalaciones"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#Usuario"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
