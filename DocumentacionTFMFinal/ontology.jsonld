    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadPocillosDosificacion",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Número de concavidades físicas aisladas integradas en la estructura, esencial para calcular el volumen de mezclas de color simultáneas o diluciones independientes que el usuario puede preparar sin riesgo de contaminación cruzada"
  } ],
