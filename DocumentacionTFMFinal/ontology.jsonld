  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Conexión de trazabilidad que vincula directamente un dispositivo físico con el parte de avería abierto en el sistema, permitiendo auditar su historial de fallos y paradas operativas"
  } ],
