}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#admiteMultimaterial",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Indicador sobre la capacidad tecnológica del equipo para combinar múltiples filamentos distintos en una misma impresión, ya sea mediante extrusión múltiple o sistemas de cambio automático"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora_FDM"
  } ],
