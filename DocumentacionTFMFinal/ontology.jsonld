  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Número de superficies de interacción principal, ya sean teclas, pads de percusión o cuerdas, que delimitan la extensión musical abarcable simultáneamente sin requerir el uso de botones electrónicos de transposición de octava"
  } ],
