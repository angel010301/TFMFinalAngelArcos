    "@language" : "es",
    "@value" : "Mecanismo de acople a chasis"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#metodoFijacionSoporte",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Principio termodinámico o mecánico requerido para la adherencia permanente del vector recortado sobre el material receptor, permitiendo a la plataforma discriminar entre sustratos de activación por presión manual en frío frente a polímeros que fuerzan al usuario a reservar paralelamente una prensa de transferencia térmica, ej. Adhesión en frío, Termofijación"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#ViniloCorte"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Método de fijación a soporte"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
