  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Espectro cromático dominante de la superficie diseñado para ofrecer el máximo contraste con los tonos de piel humanos y el vestuario, facilitando la transparencia por software, ej. Verde, Azul"
