  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Enlace físico operativo que vincula el hardware de mantenimiento con la bobina de material termoplástico que requiere corregir su alineación o distribución de espiras antes de pasar a fabricación"
  } ],
