  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Programa académico oficial en el que está matriculado el alumno, un dato muy útil para que el taller pueda priorizar el uso de ciertas máquinas hacia estudiantes de ingenierías o bellas artes durante las épocas de entregas finales"
  } ],
