  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Especificación de la unidad de procesamiento gráfico presente en la configuración base, orientada a registrar controladores integrados o chips dedicados estándar antes de evaluar el músculo gráfico especializado de las estaciones de trabajo, ej. Intel Iris Xe, AMD Radeon Graphics"
  } ],
