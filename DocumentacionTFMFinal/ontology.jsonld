}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#materialElementoCalefactor",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Composición física de la resistencia interna encargada de la transformación energética constante, determinante para evaluar la curva de aceleración térmica inicial y la retención del calor en un circuito carente de regulación electrónica activa, ej. Cerámica, Aleación de nicrom"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#SoldadorLapiz"
  } ],
