}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#esPlegableTensado",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Diseño estructural que incorpora un marco flexible perimetral para auto-tensar el material al desplegarse, evitando la formación mecánica de pliegues que generen gradientes de sombra perjudiciales para la homogeneidad del recorte"
  } ],
