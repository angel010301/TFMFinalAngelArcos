    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadEntradasAnalogicas",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Número de pines específicos equipados a nivel de hardware con un conversor analógico-digital interno, indispensables para la traducción directa de señales de voltaje variable provenientes de sensores pasivos a valores lógicos operables"
