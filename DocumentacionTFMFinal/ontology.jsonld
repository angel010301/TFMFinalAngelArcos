  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Indicador mecánico y eléctrico sobre si el bastidor de la unidad permite la extracción del bloque de calor primario para acoplar, alimentar y gestionar térmicamente resistencias periféricas con morfologías no planas"
  } ],
