        <rdfs:comment xml:lang="es">Sistemas lógicos programables para el control de electrónica física</rdfs:comment>
        <rdfs:label xml:lang="es">Placa de desarrollo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#PlanchaRigida -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#PlanchaRigida">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#MaterialSustractivo"/>
        <rdfs:comment xml:lang="es">Tableros de densidad media, madera aglomerada de diversas medidas y acrílicos</rdfs:comment>
        <rdfs:label xml:lang="es">Plancha rígida</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#PrensaManual -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#PrensaManual">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Encuadernacion"/>
        <rdfs:comment xml:lang="es">Mecanismos de accionamiento por tornillo para la inmovilización y compactación de volúmenes</rdfs:comment>
        <rdfs:label xml:lang="es">Prensa manual</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#PrensaTermica -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#PrensaTermica">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CorteEstampadoVinilo"/>
        <rdfs:subClassOf>
            <owl:Restriction>
