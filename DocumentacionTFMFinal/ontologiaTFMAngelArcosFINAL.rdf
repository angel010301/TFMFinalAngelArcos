        <rdfs:label xml:lang="es">Evento de préstamo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D">
