        <rdfs:label xml:lang="es">Fotografía</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#GafasVR -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#GafasVR">
