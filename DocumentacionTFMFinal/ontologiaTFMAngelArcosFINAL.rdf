        <rdfs:label xml:lang="es">Recuperación de soporte digital</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Robotica_y_Circuiteria -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Robotica_y_Circuiteria">
