        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#acoplaBrazo"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#AccesorioBrazoHerramientaRotativa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Sistemas motorizados de alta velocidad para mecanizado manual</rdfs:comment>
        <rdfs:label xml:lang="es">Herramienta rotativa</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Iluminacion -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Iluminacion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoVideo"/>
        <rdfs:comment xml:lang="es">Sistemas perimetrales de compensación de sombras, anillos de luz</rdfs:comment>
        <rdfs:label xml:lang="es">Iluminación</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora3D -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora3D">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#seOperaMediante"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorEstacionTrabajo"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Sistemas de fabricación aditiva de diversas tecnologías</rdfs:comment>
        <rdfs:label xml:lang="es">Impresora 3D</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora_FDM -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora_FDM">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora3D"/>
        <rdfs:comment xml:lang="es">Sistemas por deposición de filamento termoplástico fundido / Fused Deposition Modelling</rdfs:comment>
        <rdfs:label xml:lang="es">Impresora FDM</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#IncidenciaTecnica -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#IncidenciaTecnica">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SoporteMantenimiento"/>
        <rdfs:comment xml:lang="es">Reportes de avería, descalibración o falta de stock</rdfs:comment>
        <rdfs:label xml:lang="es">Incidencia técnica</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#InstrumentoMusical -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#InstrumentoMusical">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:comment xml:lang="es">Superficies de control MIDI y guitarras eléctricas</rdfs:comment>
        <rdfs:label xml:lang="es">Instrumento musical</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#InterfazAudio -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#InterfazAudio">
