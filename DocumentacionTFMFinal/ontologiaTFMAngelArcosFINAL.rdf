        <rdfs:label xml:lang="es">Periférico de vídeo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Pinceleria -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Pinceleria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#TratamientoCromatico"/>
