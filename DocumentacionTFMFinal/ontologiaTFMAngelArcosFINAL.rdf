        <rdfs:label xml:lang="es">Estudio fotográfico portátil</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo">
