    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#EstudioFotograficoPortatil -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#EstudioFotograficoPortatil">
