        <rdfs:comment xml:lang="es">Tarjetas de sonido externas para conversión analógico-digital</rdfs:comment>
        <rdfs:label xml:lang="es">Interfaz de audio</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorCasete -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorCasete">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorAudio"/>
        <rdfs:comment xml:lang="es">Reproductores de cinta magnética compacta con salida de línea o USB</rdfs:comment>
        <rdfs:label xml:lang="es">Lector de casete</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorDiscosMagneticos -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorDiscosMagneticos">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#RecuperacionSoporteDigital"/>
        <rdfs:comment xml:lang="es">Disqueteras externas para la recuperación de datos en discos de 3,5 pulgadas</rdfs:comment>
        <rdfs:label xml:lang="es">Lector discos magnéticos</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorOptico -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorOptico">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#RecuperacionSoporteDigital"/>
        <rdfs:comment xml:lang="es">Unidades de lectura mediante láser para extracción de archivos en formatos CD, DVD y Blu-ray</rdfs:comment>
        <rdfs:label xml:lang="es">Lector óptico</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorSuper8 -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorSuper8">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorVideo"/>
        <rdfs:comment xml:lang="es">Sistema motorizado de arrastre continuo diseñado para procesar cintas cinematográficas subestándar fotograma a fotograma, extrayendo la secuencia luminosa para su ensamblaje en un archivo de vídeo.</rdfs:comment>
        <rdfs:label xml:lang="es">Lector Super 8</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorVideo -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorVideo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorVideo"/>
        <rdfs:comment xml:lang="es">Unidades de reproducción y captura para videocasetes estándar de media pulgada</rdfs:comment>
        <rdfs:label xml:lang="es">Lector Vídeo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorVinilo -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorVinilo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorAudio"/>
        <rdfs:comment xml:lang="es">Giradiscos traccionados orientados a la digitalización de discos microsurco</rdfs:comment>
        <rdfs:label xml:lang="es">Lector de vinilo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#MaterialSustractivo -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#MaterialSustractivo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Consumible"/>
        <rdfs:comment xml:lang="es">Sustratos en bruto orientados al seccionado, grabado o vaciado geométrico</rdfs:comment>
        <rdfs:label xml:lang="es">Material sustractivo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#MedioAuxiliar -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#MedioAuxiliar">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Consumible"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#esRequeridoPor"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CortadoraVinilo"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#esRequeridoPor"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Soldadura_y_Ensamblaje"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#esRequeridoPor"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#TratamientoCromatico"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Elementos de apoyo al proceso productivo, contiene Papel Transfer, pintura, estaño…</rdfs:comment>
        <rdfs:label xml:lang="es">Medio auxiliar</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Microcontrolador -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Microcontrolador">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PlacaDesarrollo"/>
        <rdfs:comment xml:lang="es">Plataformas de hardware libre orientadas a la ejecución de bucles simples y lectura de sensores, ej. Arduino</rdfs:comment>
        <rdfs:label xml:lang="es">Microcontrolador</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Microfono -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Microfono">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoAudio"/>
        <rdfs:comment xml:lang="es">Dispositivos de captura de audio, como el de condensador</rdfs:comment>
        <rdfs:label xml:lang="es">Micrófono</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Monitorizacion -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Monitorizacion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoAudio"/>
        <rdfs:comment xml:lang="es">Sistemas de escucha cerrada, como auriculares de estudio</rdfs:comment>
        <rdfs:label xml:lang="es">Monitorización</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:comment xml:lang="es">Sistemas informáticos de propósito general clasificados según su rol operativo y nivel de acceso</rdfs:comment>
        <rdfs:label xml:lang="es">Ordenador</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorAdministracion -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorAdministracion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"/>
        <rdfs:comment xml:lang="es">Equipos de uso exclusivo para el personal, orientados a la gestión interna, registro de usuarios y control logístico</rdfs:comment>
        <rdfs:label xml:lang="es">Ordenador de administración</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorEstacionTrabajo -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorEstacionTrabajo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"/>
        <rdfs:comment xml:lang="es">Equipos dedicados al control directo de maquinaria de fabricación, renderizado y ejecución de software específico</rdfs:comment>
        <rdfs:label xml:lang="es">Ordenador de estación de trabajo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPlacaUnica -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPlacaUnica">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PlacaDesarrollo"/>
        <rdfs:comment xml:lang="es">Sistemas con arquitectura y capacidad para soportar un S.O. completo, ej. Raspberry Pi</rdfs:comment>
        <rdfs:label xml:lang="es">Ordenador de placa única</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPortatil -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPortatil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"/>
        <rdfs:comment xml:lang="es">Dispositivos de computación móvil destinados al préstamo, movilidad o uso polivalente temporal por parte de los usuarios</rdfs:comment>
        <rdfs:label xml:lang="es">Ordenador portátil</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Otros -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Otros">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:label xml:lang="es">Otros</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#PanelAcustico -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#PanelAcustico">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#AcondicionamientoEstudio"/>
        <rdfs:comment xml:lang="es">Materiales fonoabsorbentes destinados a la mitigación de reverberaciones y control de reflexiones sonoras</rdfs:comment>
        <rdfs:label xml:lang="es">Panel acústico</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoAudio -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoAudio">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Streaming"/>
        <rdfs:comment xml:lang="es">Dispositivos de entrada, salida y procesamiento de señal sonora</rdfs:comment>
        <rdfs:label xml:lang="es">Periférico de audio</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoVideo -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoVideo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Streaming"/>
