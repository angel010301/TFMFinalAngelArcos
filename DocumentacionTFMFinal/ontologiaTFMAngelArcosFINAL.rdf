        <rdfs:label xml:lang="es">Fondo cromático</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Fotografia -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Fotografia">
