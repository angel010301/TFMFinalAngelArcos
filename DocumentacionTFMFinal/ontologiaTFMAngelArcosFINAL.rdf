        <rdfs:comment xml:lang="es">Infraestructura de salida audiovisual para docencia y transferencia del conocimiento</rdfs:comment>
        <rdfs:label xml:lang="es">Presentación y difusión</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Proyector -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Proyector">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Presentacion_y_Difusion"/>
        <rdfs:comment xml:lang="es">Sistemas de emisión óptica y ampliación de señal de vídeo para grandes formatos</rdfs:comment>
        <rdfs:label xml:lang="es">Proyector</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#RebobinadorFilamento -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#RebobinadorFilamento">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#rebobina"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Dispositivo auxiliar de mantenimiento logístico destinado a la transferencia, corrección de tensión y reordenamiento espacial de las espiras de polímero termoplástico, con el fin de prevenir atascos mecánicos por cruces de hilo y asegurar una alimentación continua hacia los sistemas de extrusión.</rdfs:comment>
        <rdfs:label xml:lang="es">Rebobinador de filamento</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#RecuperacionSoporteDigital -->

