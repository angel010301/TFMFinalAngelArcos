    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#FondoCromatico -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#FondoCromatico">
