                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#AdaptadoresPrensa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Unidades base de calor y presión controlada para fijación de polímeros</rdfs:comment>
        <rdfs:label xml:lang="es">Prensa térmica</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Presentacion_y_Difusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Presentacion_y_Difusion">
