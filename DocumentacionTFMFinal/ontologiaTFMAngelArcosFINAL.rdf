    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#acondiciona -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#acondiciona">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#esAcondicionadoPor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SecadorFilamento"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D"/>
        <rdfs:comment xml:lang="es">Enlace físico que vincula el dispositivo de control térmico periférico directamente con el material fungible al que le extrae la humedad, garantizando sus propiedades mecánicas antes del proceso de fabricación</rdfs:comment>
        <rdfs:label xml:lang="es">Acondiciona</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#acoplaBrazo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#acoplaBrazo">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#brazoEsAcopladoEn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#HerramientaRotativa"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#AccesorioBrazoHerramientaRotativa"/>
        <rdfs:comment xml:lang="es">Enlace físico que vincula una herramienta motorizada de mecanizado manual con los brazos extensores, soportes o guías de profundidad necesarios para estabilizar y controlar su trayectoria espacial</rdfs:comment>
        <rdfs:label xml:lang="es">Acopla brazo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#acoplaModuloTermico -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#acoplaModuloTermico">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#moduloTermicoEsAcopladoEn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PrensaTermica"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#AdaptadoresPrensa"/>
        <rdfs:comment xml:lang="es">Conexión física que asocia la base principal de presión y calor con las distintas resistencias periféricas intercambiables, necesarias para transferir diseños sobre superficies no planas</rdfs:comment>
        <rdfs:label xml:lang="es">Acopla módulo térmico</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#avisoEsEmitidoPor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#avisoEsEmitidoPor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#emiteAviso"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#IncidenciaTecnica"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Administradores"/>
        <rdfs:comment xml:lang="es">Enlace de trazabilidad que asocia a individuo registrado en el espacio como administrador con la generación de un reporte de mantenimiento, ya sea por avería de hardware o por agotamiento de consumibles, cerrando el ciclo de notificación</rdfs:comment>
        <rdfs:label xml:lang="es">Aviso es emitido por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#brazoEsAcopladoEn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#brazoEsAcopladoEn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#AccesorioBrazoHerramientaRotativa"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#HerramientaRotativa"/>
        <rdfs:comment xml:lang="es">Enlace físico que vincula una herramienta motorizada de mecanizado manual con los brazos extensores, soportes o guías de profundidad necesarios para estabilizar y controlar su trayectoria espacial</rdfs:comment>
        <rdfs:label xml:lang="es">Brazo es acoplado en</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#consumeMaterial -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#consumeMaterial">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#materialEsConsumidoPor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Consumible"/>
        <rdfs:comment xml:lang="es">Enlace físico de carácter opcional que asocia directamente la maquinaria con el material fungible que necesita cargar para funcionar, aplicable exclusivamente a los dispositivos de fabricación o desgaste, permitiendo cruzar el nivel de stock con la viabilidad técnica de la máquina</rdfs:comment>
        <rdfs:label xml:lang="es">Consume material</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#emiteAviso -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#emiteAviso">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Administradores"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#IncidenciaTecnica"/>
        <rdfs:comment xml:lang="es">Enlace de trazabilidad que asocia a individuo registrado en el espacio como administrador con la generación de un reporte de mantenimiento, ya sea por avería de hardware o por agotamiento de consumibles, cerrando el ciclo de notificación</rdfs:comment>
        <rdfs:label xml:lang="es">Emite aviso</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#empleaEquipamiento -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#empleaEquipamiento">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#equipamientoEsEmpleadoEn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:comment xml:lang="es">Enlace logístico opcional que determina qué elementos del inventario físico son susceptibles de cesión temporal</rdfs:comment>
        <rdfs:label xml:lang="es">Emplea equipamiento</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#equipamientoEsEmpleadoEn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#equipamientoEsEmpleadoEn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:comment xml:lang="es">Enlace logístico opcional que determina qué elementos del inventario físico son susceptibles de cesión temporal</rdfs:comment>
        <rdfs:label xml:lang="es">Equipamiento es empleado en</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#esAcondicionadoPor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#esAcondicionadoPor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SecadorFilamento"/>
        <rdfs:comment xml:lang="es">Enlace físico que vincula el dispositivo de control térmico periférico directamente con el material fungible al que le extrae la humedad, garantizando sus propiedades mecánicas antes del proceso de fabricación</rdfs:comment>
        <rdfs:label xml:lang="es">Es acondicionado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#esRebobinadoPor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#esRebobinadoPor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#rebobina"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#RebobinadorFilamento"/>
        <rdfs:comment xml:lang="es">Enlace físico operativo que vincula el hardware de mantenimiento con la bobina de material termoplástico que requiere corregir su alineación o distribución de espiras antes de pasar a fabricación</rdfs:comment>
        <rdfs:label xml:lang="es">Es rebobinado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#esRequeridoComoSoportePor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#esRequeridoComoSoportePor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereSoporteObjetivo"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SoporteObjetivo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ViniloCorte"/>
        <rdfs:comment xml:lang="es">Enlace de dependencia logística que asocia un material de transferencia térmica, como el vinilo textil o el papel de sublimación, con la superficie física en blanco necesaria para anclar el diseño de forma permanente mediante la aplicación de calor y presión en la prensa</rdfs:comment>
        <rdfs:label xml:lang="es">Es requerido como soporte por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#esRequeridoPor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#esRequeridoPor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiere"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#MedioAuxiliar"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#CortadoraVinilo"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Soldadura_y_Ensamblaje"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#TratamientoCromatico"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Conexión que justifica la existencia del papel transportador en el almacén al vincularlo exclusivamente con los sustratos adhesivos que exigen un traslado en bloque</rdfs:comment>
        <rdfs:label xml:lang="es">Es requerido por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#esSupervisadoPor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#esSupervisadoPor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#supervisa"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Administradores"/>
        <rdfs:label xml:lang="es">Es supervisado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#incidenciaEsRegistradaEn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#incidenciaEsRegistradaEn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#registraIncidencia"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#IncidenciaTecnica"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:comment xml:lang="es">Conexión de trazabilidad que vincula directamente un dispositivo físico con el parte de avería abierto en el sistema, permitiendo auditar su historial de fallos y paradas operativas</rdfs:comment>
        <rdfs:label xml:lang="es">Incidencia es registrada en</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#materialEsConsumidoPor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#materialEsConsumidoPor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Consumible"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:comment xml:lang="es">Enlace físico de carácter opcional que asocia directamente la maquinaria con el material fungible que necesita cargar para funcionar, aplicable exclusivamente a los dispositivos de fabricación o desgaste, permitiendo cruzar el nivel de stock con la viabilidad técnica de la máquina</rdfs:comment>
        <rdfs:label xml:lang="es">Material es consumido por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#moduloTermicoEsAcopladoEn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#moduloTermicoEsAcopladoEn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#AdaptadoresPrensa"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PrensaTermica"/>
        <rdfs:comment xml:lang="es">Conexión física que asocia la base principal de presión y calor con las distintas resistencias periféricas intercambiables, necesarias para transferir diseños sobre superficies no planas</rdfs:comment>
        <rdfs:label xml:lang="es">Módulo térmico es acoplado en</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#operaA -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#operaA">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#seOperaMediante"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorEstacionTrabajo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:comment xml:lang="es">Enlace técnico de carácter opcional que asocia un equipo de fabricación aditiva, sustractiva o digitalización con el terminal informático dedicado a su control y envío de instrucciones). Dominio: SIN ACOTAR (Axiomatizado mediante restricciones existenciales a nivel de clase</rdfs:comment>
        <rdfs:label xml:lang="es">Opera a</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#planchaSeccionadaPor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#planchaSeccionadaPor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#seccionaPlancha"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PlanchaRigida"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CorteLaser"/>
        <rdfs:comment xml:lang="es">Enlace operativo que asocia directamente la maquinaria de corte por haz de luz, con la tipología exacta de material fungible sobre el que interviene para ejecutar su trabajo</rdfs:comment>
        <rdfs:label xml:lang="es">Plancha seccionada por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#prestamoEsSolicitadoPor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#prestamoEsSolicitadoPor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#solicitaPrestamo"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Usuario"/>
        <rdfs:comment xml:lang="es">Enlace logístico que vincula a un miembro de la comunidad académica con el registro de movimiento temporal de inventario, asociando la responsabilidad del cuidado del hardware al perfil del solicitante durante el periodo establecido</rdfs:comment>
        <rdfs:label xml:lang="es">Préstamo es solicitado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#rebobina -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#rebobina">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#RebobinadorFilamento"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D"/>
        <rdfs:comment xml:lang="es">Enlace físico operativo que vincula el hardware de mantenimiento con la bobina de material termoplástico que requiere corregir su alineación o distribución de espiras antes de pasar a fabricación</rdfs:comment>
        <rdfs:label xml:lang="es">Rebobina</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#registraIncidencia -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#registraIncidencia">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#IncidenciaTecnica"/>
        <rdfs:comment xml:lang="es">Conexión de trazabilidad que vincula directamente un dispositivo físico con el parte de avería abierto en el sistema, permitiendo auditar su historial de fallos y paradas operativas</rdfs:comment>
        <rdfs:label xml:lang="es">Registra incidencia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#requiere -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiere">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#CortadoraVinilo"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Soldadura_y_Ensamblaje"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#TratamientoCromatico"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#MedioAuxiliar"/>
        <rdfs:comment xml:lang="es">Conexión que justifica la existencia del papel transportador en el almacén al vincularlo exclusivamente con los sustratos adhesivos que exigen un traslado en bloque</rdfs:comment>
        <rdfs:label xml:lang="es">Requiere</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereSoporteObjetivo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereSoporteObjetivo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ViniloCorte"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SoporteObjetivo"/>
        <rdfs:comment xml:lang="es">Enlace de dependencia logística que asocia un material de transferencia térmica, como el vinilo textil o el papel de sublimación, con la superficie física en blanco necesaria para anclar el diseño de forma permanente mediante la aplicación de calor y presión en la prensa</rdfs:comment>
        <rdfs:label xml:lang="es">Requiere soporte objetivo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#seOperaMediante -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#seOperaMediante">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorEstacionTrabajo"/>
        <rdfs:comment xml:lang="es">Enlace técnico de carácter opcional que asocia un equipo de fabricación aditiva, sustractiva o digitalización con el terminal informático dedicado a su control y envío de instrucciones). Dominio: SIN ACOTAR (Axiomatizado mediante restricciones existenciales a nivel de clase</rdfs:comment>
        <rdfs:label xml:lang="es">Se opera mediante</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#seccionaPlancha -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#seccionaPlancha">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CorteLaser"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PlanchaRigida"/>
        <rdfs:comment xml:lang="es">Enlace operativo que asocia directamente la maquinaria de corte por haz de luz, con la tipología exacta de material fungible sobre el que interviene para ejecutar su trabajo</rdfs:comment>
        <rdfs:label xml:lang="es">Secciona plancha</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#seccionaVinilo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#seccionaVinilo">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#viniloEsSeccionadoPor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CortadoraVinilo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ViniloCorte"/>
        <rdfs:comment xml:lang="es">Enlace operativo que asocia directamente la maquinaria de corte por cuchilla, con la tipología exacta de material fungible sobre el que interviene para ejecutar su trabajo</rdfs:comment>
        <rdfs:label xml:lang="es">Secciona vinilo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#solicitaPrestamo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#solicitaPrestamo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Usuario"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:comment xml:lang="es">Enlace logístico que vincula a un miembro de la comunidad académica con el registro de movimiento temporal de inventario, asociando la responsabilidad del cuidado del hardware al perfil del solicitante durante el periodo establecido</rdfs:comment>
        <rdfs:label xml:lang="es">Solicita préstamo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#superaTaller -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#superaTaller">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#tallerEsSuperadoPor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ComunidadUniversitaria"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#TallerFormativo"/>
        <rdfs:comment xml:lang="es">Enlace de capacitación que asocia a un perfil académico con la sesión de instrucción finalizada con éxito, actuando como llave lógica para desbloquear sus permisos de operación sobre el hardware restringido en el sistema</rdfs:comment>
        <rdfs:label xml:lang="es">Supera taller</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#supervisa -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#supervisa">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Administradores"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:label xml:lang="es">Supervisa</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tallerEsSuperadoPor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tallerEsSuperadoPor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#TallerFormativo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ComunidadUniversitaria"/>
        <rdfs:comment xml:lang="es">Enlace de capacitación que asocia a un perfil académico con la sesión de instrucción finalizada con éxito, actuando como llave lógica para desbloquear sus permisos de operación sobre el hardware restringido en el sistema</rdfs:comment>
        <rdfs:label xml:lang="es">Taller es superado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#viniloEsSeccionadoPor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#viniloEsSeccionadoPor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ViniloCorte"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CortadoraVinilo"/>
        <rdfs:comment xml:lang="es">Enlace operativo que asocia directamente la maquinaria de corte por cuchilla, con la tipología exacta de material fungible sobre el que interviene para ejecutar su trabajo</rdfs:comment>
        <rdfs:label xml:lang="es">Vinilo es seccionado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#MaquinariaVinculada -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#MaquinariaVinculada">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorEstacionTrabajo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Referencia del equipamiento de fabricación física, como impresoras 3D, que se encuentra directamente subordinado a las instrucciones de esta terminal, condicionando la reserva del ordenador a la operación estricta de dicho hardware</rdfs:comment>
        <rdfs:label xml:lang="es">Maquinaria vinculada</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#acabadoSuperficialVisual -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#acabadoSuperficialVisual">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Naturaleza óptica del sustrato tras su solidificación a temperatura ambiente, cualidad determinante para la asignación del recurso en proyectos de diseño de producto o maquetismo donde la refracción lumínica prima sobre la resistencia mecánica pura, ej. Mate, Sedoso, Traslúcido</rdfs:comment>
        <rdfs:label xml:lang="es">Acabado superficial visual</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#admiteMultimaterial -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#admiteMultimaterial">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora_FDM"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador sobre la capacidad tecnológica del equipo para combinar múltiples filamentos distintos en una misma impresión, ya sea mediante extrusión múltiple o sistemas de cambio automático</rdfs:comment>
        <rdfs:label xml:lang="es">Admite multimaterial</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#admitePedalExterno -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#admitePedalExterno">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#InstrumentoMusical"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Disponibilidad de puertos de entrada físicos, generalmente en formato jack, destinados a la conexión de controladores de pie para la alteración del sostenido o la modulación de la expresión dinámica durante la interpretación</rdfs:comment>
        <rdfs:label xml:lang="es">Admite pedal externo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#admiteTransmisionInalambrica -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#admiteTransmisionInalambrica">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Presentacion_y_Difusion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Capacidad del hardware para recibir e interpretar flujos de datos audiovisuales mediante protocolos de red local, indispensable para habilitar el envío de señal desde portátiles de los usuarios sin depender de interfaces de cableado físico directo, ej. Miracast, AirPlay</rdfs:comment>
        <rdfs:label xml:lang="es">Admite transmisión inalámbrica</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#alcanceMaximoTelemetria -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#alcanceMaximoTelemetria">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Dron"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Distancia límite de cobertura radial en metros para mantener el enlace de control de radiofrecuencia y la transmisión de vídeo de retorno sin pérdida de señal, ej. 4000, 10000</rdfs:comment>
        <rdfs:label xml:lang="es">Alcance máximo de telemetría</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#anchoMaterialAdmitido -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#anchoMaterialAdmitido">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CortadoraVinilo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Distancia máxima transversal operativa entre los rodillos de arrastre del chasis, fundamental para determinar si el equipo procesa bobinas continuas de formato industrial o se limita a hojas estandarizadas de escritorio</rdfs:comment>
        <rdfs:label xml:lang="es">Ancho de material admitido</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#anioInicioEstudios -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#anioInicioEstudios">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Estudiante"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Año natural en el que el alumno formalizó su primera matrícula en la titulación actual, un parámetro que permite al sistema identificar su nivel de veteranía académica y anticipar si va a requerir mayor supervisión técnica durante su paso por el espacio</rdfs:comment>
        <rdfs:label xml:lang="es">Año de inicio de estudios</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#aperturaMaximaVertical -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#aperturaMaximaVertical">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PrensaManual"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Distancia máxima operativa en el eje Z entre la superficie estática de apoyo y el plato móvil superior, expresada habitualmente en milímetros, crítica para acotar el grosor límite del volumen o la cantidad de pliegos que admite el habitáculo antes de aplicar presión</rdfs:comment>
        <rdfs:label xml:lang="es">Apertura máxima vertical</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#aptoParaCorteLaser -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#aptoParaCorteLaser">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PlanchaRigida"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Certificación de composición química que valida la viabilidad del tablero para ser sometido a estrés térmico concentrado sin emitir gases halógenos corrosivos, actuando como criba de seguridad ineludible para vetar el mecanizado de polímeros tóxicos como el PVC</rdfs:comment>
        <rdfs:label xml:lang="es">Apto para corte láser</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#areaTrabajoEfectiva -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#areaTrabajoEfectiva">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CorteLaser"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Dimensiones máximas bidimensionales que el cabezal óptico puede recorrer en los ejes cartesianos, vital para acotar el tamaño de la plancha de sustrato que el usuario puede introducir en el habitáculo, ej. 600x400mm</rdfs:comment>
        <rdfs:label xml:lang="es">Área de trabajo efectiva</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#areaTrabajoEfectivaTabletaGrafica -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#areaTrabajoEfectivaTabletaGrafica">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#TabletaDigitalizadora"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Superficie física bidimensional u operativa útil, ya sea la cuadrícula sensible al lápiz o la base interior de la tienda de luz, determinante para evaluar la viabilidad de digitalizar planos extensos o fotografiar maquetas voluminosas sin exceder los límites del hardware, ej. 224x148mm, 40x40cm</rdfs:comment>
        <rdfs:label xml:lang="es">Área de trabajo efectiva de tableta gráfica</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#arquitecturaProcesador -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#arquitecturaProcesador">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPlacaUnica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Conjunto de instrucciones nativo que determina el diseño lógico del silicio y condiciona de forma absoluta la compatibilidad binaria del software, determinando si el dispositivo requiere distribuciones operativas compiladas en exclusiva o admite binarios comerciales estándar, ej. ARMv8, x86_64</rdfs:comment>
        <rdfs:label xml:lang="es">Arquitectura de procesador</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#arquitecturaProcesadorPC -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#arquitecturaProcesadorPC">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Especificación del conjunto de instrucciones y diseño del chip central, indispensable para determinar el tipo de binarios y dependencias lógicas que el sistema puede compilar o ejecutar nativamente, ej. x86_64, ARM64</rdfs:comment>
        <rdfs:label xml:lang="es">Arquitectura de procesador de PC</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#autonomiaBateriaMinutos -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#autonomiaBateriaMinutos">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPortatil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Tiempo teórico de operación continua del dispositivo móvil bajo carga de trabajo estándar sin dependencia de una toma de corriente alterna, factor logístico estricto para la planificación de sesiones de estudio del alumno fuera de los puestos electrificados, ej. 240, 480</rdfs:comment>
        <rdfs:label xml:lang="es">Autonomía de batería en minutos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#bobinaAgotada -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#bobinaAgotada">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Marcador encargado de indicar la existencia o el agotamiento de la bobina de filamento en cuestión</rdfs:comment>
        <rdfs:label xml:lang="es">Bobina agotada</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#calibreBoquillaAtomizacion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#calibreBoquillaAtomizacion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SistemaAerografia"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Diámetro del orificio de salida del obturador expresado en milímetros, factor geométrico crítico que acota el nivel de detalle del patrón de pulverización y condiciona el grosor mínimo de la línea trazable, ej. 0.2mm, 0.5mm</rdfs:comment>
        <rdfs:label xml:lang="es">Calibre de boquilla de atomización</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#campoVisionDiagonal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#campoVisionDiagonal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraWeb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Amplitud angular máxima capturada por el grupo óptico, expresada en grados, vital para predecir si el encuadre abarca exclusivamente a un locutor o permite registrar a varios ponentes simultáneos en el set, ej. 78, 90</rdfs:comment>
        <rdfs:label xml:lang="es">Campo de visión diagonal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadBotonesProgramables -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadBotonesProgramables">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ControladorRealizacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número de interruptores físicos o matrices interactivas disponibles en la superficie para la asignación y ejecución rápida de macros, scripts o transiciones de escena en directo</rdfs:comment>
        <rdfs:label xml:lang="es">Cantidad de botones programables</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadControlesRotatorios -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadControlesRotatorios">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ControladorRealizacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número de diales o perillas físicas de giro continuo integradas en el chasis, esenciales para el ajuste fino de niveles de audio, zoom o colorimetría en software de edición sin recurrir a pulsaciones reiteradas</rdfs:comment>
        <rdfs:label xml:lang="es">Cantidad de controles rotatorios</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadElementosEjecucion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadElementosEjecucion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#InstrumentoMusical"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número de superficies de interacción principal, ya sean teclas, pads de percusión o cuerdas, que delimitan la extensión musical abarcable simultáneamente sin requerir el uso de botones electrónicos de transposición de octava</rdfs:comment>
        <rdfs:label xml:lang="es">Cantidad de elementos de ejecución</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadEntradasAnalogicas -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadEntradasAnalogicas">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Microcontrolador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número de pines específicos equipados a nivel de hardware con un conversor analógico-digital interno, indispensables para la traducción directa de señales de voltaje variable provenientes de sensores pasivos a valores lógicos operables</rdfs:comment>
        <rdfs:label xml:lang="es">Cantidad de entradas analógicas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadEntradasSimultaneas -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadEntradasSimultaneas">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#InterfazAudio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número de canales físicos independientes disponibles en los preamplificadores del equipo para la ingesta paralela de múltiples señales sonoras</rdfs:comment>
        <rdfs:label xml:lang="es">Cantidad de entradas simultáneas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadMonitoresAsignados -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadMonitoresAsignados">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Cuantificación de las unidades de visualización independientes conectadas periféricamente o integradas en el chasis del sistema, factor operativo esencial para determinar la viabilidad de tareas complejas de desarrollo, diseño asistido por ordenador o monitorización simultánea de flujos de datos sin sufrir restricciones de espacio en el escritorio virtual, ej. 1, 2</rdfs:comment>
        <rdfs:label xml:lang="es">Cantidad de monitores asignados</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadPinesGPIO -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadPinesGPIO">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PlacaDesarrollo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número total de terminales físicos de entrada y salida de propósito general disponibles en la cabecera del circuito, determinante para acotar la capacidad máxima de expansión y el volumen de actuadores que el usuario puede interconectar simultáneamente</rdfs:comment>
        <rdfs:label xml:lang="es">Cantidad de pines GPIO</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadPocillosDosificacion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadPocillosDosificacion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#UtillajeMezcla"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número de concavidades físicas aisladas integradas en la estructura, esencial para calcular el volumen de mezclas de color simultáneas o diluciones independientes que el usuario puede preparar sin riesgo de contaminación cruzada</rdfs:comment>
        <rdfs:label xml:lang="es">Cantidad de pocillos de dosificación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadSalidasMonitorizacion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#cantidadSalidasMonitorizacion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#InterfazAudio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número de envíos físicos independientes dedicados a la conexión de escuchas de estudio o amplificadores de auriculares</rdfs:comment>
        <rdfs:label xml:lang="es">Cantidad de salidas de monitorización</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadAlmacenamientoInterno -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadAlmacenamientoInterno">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#GafasVR"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Volumen de memoria no volátil embebida en la propia arquitectura del visor expresada en gigabytes, límite operativo crítico para sistemas autónomos que exigen la instalación directa de simuladores y la carga de mallas tridimensionales en local, ej. 128GB, 512GB</rdfs:comment>
        <rdfs:label xml:lang="es">Capacidad de almacenamiento interno</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadAlmacenamientoPrincipal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadAlmacenamientoPrincipal">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Espacio total de memoria no volátil disponible en la unidad de disco local expresado en gigabytes, métrica indispensable para controlar la capacidad de instalación de software masivo y la persistencia de archivos locales, ej. 512, 1024</rdfs:comment>
        <rdfs:label xml:lang="es">Capacidad de almacenamiento principal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadBandejaAlimentacion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadBandejaAlimentacion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerRodillo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número máximo de hojas físicas que el alimentador automático puede procesar en un único lote de escaneo ininterrumpido</rdfs:comment>
        <rdfs:label xml:lang="es">Capacidad de bandeja de alimentación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadBandejaCarga -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadBandejaCarga">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerDiapositivas"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número máximo de diapositivas enmarcadas que el sistema de alimentación o el chasis portador puede albergar para su digitalización secuencial por lotes sin intervención del operador</rdfs:comment>
        <rdfs:label xml:lang="es">Capacidad de bandeja de carga</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadBobinas -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadBobinas">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SecadorFilamento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número máximo de rollos de filamento estándar que el dispositivo puede alojar y deshumidificar de forma simultánea</rdfs:comment>
        <rdfs:label xml:lang="es">Capacidad de bobinas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadGrabacion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadGrabacion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorOptico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador técnico sobre si el periférico incluye diodo láser de escritura para la creación de discos físicos de preservación o si está limitado exclusivamente a la extracción de datos</rdfs:comment>
        <rdfs:label xml:lang="es">Capacidad de grabación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadMemoriaFlash -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadMemoriaFlash">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Microcontrolador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Volumen máximo de almacenamiento no volátil disponible internamente, acotado generalmente en kilobytes, que determina el límite dimensional del código o firmware que el usuario puede cargar físicamente en la placa, ej. 32KB, 256KB</rdfs:comment>
        <rdfs:label xml:lang="es">Capacidad de memoria flash</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadMemoriaRAM -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadMemoriaRAM">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPlacaUnica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Volumen de memoria volátil integrada en la arquitectura, determinante para garantizar la estabilidad operativa de un núcleo completo y la viabilidad de ejecución simultánea de procesos de alta carga computacional, ej. 4GB, 8GB</rdfs:comment>
        <rdfs:label xml:lang="es">Capacidad de memoria RAM</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadMemoriaRAMPC -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadMemoriaRAMPC">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Volumen total de memoria de acceso aleatorio instalada en el sistema expresada en gigabytes, factor crítico que condiciona el límite de procesos simultáneos y la fluidez en la ejecución de entornos de desarrollo, ej. 16, 32</rdfs:comment>
        <rdfs:label xml:lang="es">Capacidad de memoria RAM de PC</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadSeccionadoHojas -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capacidadSeccionadoHojas">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Guillotina"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Volumen máximo de folios de gramaje estandarizado que la cizalla puede atravesar en un único movimiento de palanca descendente sin provocar desgarros en el borde ni bloquear la herramienta, vital para calcular la viabilidad del corte en bloques densos</rdfs:comment>
        <rdfs:label xml:lang="es">Capacidad de seccionado de hojas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capturaDobleCara -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capturaDobleCara">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerRodillo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador técnico sobre la presencia de un sensor dúplex que permite la digitalización simultánea del anverso y reverso del folio</rdfs:comment>
        <rdfs:label xml:lang="es">Captura a doble cara</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capturaEnColor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capturaEnColor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerDocumental"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador técnico sobre la capacidad del hardware para registrar el documento en espectro cromático completo, frente a limitaciones mecánicas o de software de captura exclusiva en monocromo o escala de grises</rdfs:comment>
        <rdfs:label xml:lang="es">Captura en color</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capturaPistaMagnetica -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capturaPistaMagnetica">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorSuper8"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador lógico que especifica si el hardware dispone de cabezales de audio integrados para la lectura y digitalización simultánea de la banda de sonido presente en el borde de algunos carretes cinematográficos subestándar</rdfs:comment>
        <rdfs:label xml:lang="es">Captura de pista magnética</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#capturaTexturaColor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#capturaTexturaColor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Escaner3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador técnico sobre la capacidad del hardware para registrar fotométricamente el aspecto visual y los colores de la superficie del objeto, además de su topología estructural</rdfs:comment>
        <rdfs:label xml:lang="es">Captura de textura y color</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#cargoAdministrador -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#cargoAdministrador">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Administradores"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Descripción del cargo que desempeña el profesional en el centro</rdfs:comment>
        <rdfs:label xml:lang="es">Cargo de administrador</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#codigoInventario -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#codigoInventario">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Consumible"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Cadena alfanumérica única para la identificación patrimonial del recurso en el catálogo</rdfs:comment>
        <rdfs:label xml:lang="es">Código de inventario</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#codigoRegistroInterno -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#codigoRegistroInterno">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Gestion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Identificador alfanumérico único generado por el sistema para auditar cualquier evento administrativo, garantizando la trazabilidad absoluta de todos los procesos del espacio</rdfs:comment>
        <rdfs:label xml:lang="es">Código de registro interno</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#coeficienteReduccionRuido -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#coeficienteReduccionRuido">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PanelAcustico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Métrica estandarizada NRC que cuantifica el porcentaje de eficacia de absorción sonora del material, crucial para calcular el volumen de unidades requeridas según el tiempo de reverberación natural del entorno</rdfs:comment>
        <rdfs:label xml:lang="es">Coeficiente de reducción de ruido</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#composicionPolimeroBase -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#composicionPolimeroBase">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Naturaleza química de la matriz termoplástica que define las capacidades mecánicas de tracción o flexibilidad inherentes al material, permitiendo al sistema clasificar logísticamente la bobina y acotar su uso técnico sin necesidad de ramificar la estructura jerárquica del inventario, ej. PLA, TPU, Nylon</rdfs:comment>
        <rdfs:label xml:lang="es">Composición de polímero base</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#controlVelocidadVariable -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#controlVelocidadVariable">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorCasete"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Presencia de potenciómetro o ajuste de hardware para alterar finamente la velocidad de arrastre de la cinta magnética, indispensable para corregir grabaciones históricas con desajustes de tono o formatos de dictáfono.</rdfs:comment>
        <rdfs:label xml:lang="es">Control de velocidad variable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#correccionCurvaturaLibros -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#correccionCurvaturaLibros">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerCenital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador sobre la capacidad del equipo o su software dedicado para aplanar digitalmente la deformación geométrica generada por el lomo de los volúmenes encuadernados</rdfs:comment>
        <rdfs:label xml:lang="es">Corrección de curvatura de libros</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#correoInstitucionalVinculado -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#correoInstitucionalVinculado">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Usuario"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Identificador telemático oficial proporcionado por la universidad, parámetro lógico esencial para la notificación automatizada de reservas, avisos de caducidad de préstamos y emisión de alertas por infracciones normativas en el recinto sin depender de bases de datos externas</rdfs:comment>
        <rdfs:label xml:lang="es">Correo institucional vinculado</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#densidadesLecturaSoportadas -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#densidadesLecturaSoportadas">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorDiscosMagneticos"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Compatibilidad del cabezal magnético con las diferentes codificaciones de pistas y sectores de los discos flexibles, clave para recuperar datos de distintas épocas, ej. Doble Densidad DD 720KB, Alta Densidad HD 1.44MB</rdfs:comment>
        <rdfs:label xml:lang="es">Densidades de lectura soportadas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#departamentoPDI -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#departamentoPDI">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DocenteInvestigador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Departamento al que pertenece el Personal Docente Investigador, mayormente por cuestiones estadísticas</rdfs:comment>
        <rdfs:label xml:lang="es">Departamento de PDI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#descripcionSintomaFallo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#descripcionSintomaFallo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#IncidenciaTecnica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Registro de texto donde el usuario o el operador detalla el comportamiento anómalo detectado en el hardware, facilitando el diagnóstico previo</rdfs:comment>
        <rdfs:label xml:lang="es">Descripción de síntoma de fallo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#diagonalPantallaPulgadas -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#diagonalPantallaPulgadas">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPortatil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Dimensión transversal del panel de visualización integrado, factor geométrico que determina simultáneamente el área de trabajo móvil disponible y el volumen espacial requerido para su despliegue físico en las mesas de lectura, ej. 13.3, 15.6</rdfs:comment>
        <rdfs:label xml:lang="es">Diagonal de pantalla en pulgadas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#diametroCalibreSeccion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#diametroCalibreSeccion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Medida transversal del hilo polimérico en estado sólido expresada en milímetros, parámetro geométrico ineludible para garantizar la compatibilidad mecánica con el sistema de tracción del extrusor y la barrera térmica de la máquina asignada, ej. 1.75mm, 2.85mm</rdfs:comment>
        <rdfs:label xml:lang="es">Diámetro y calibre de sección</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#diametroFilamento -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#diametroFilamento">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora_FDM"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Grosor del material termoplástico compatible con el sistema de extrusión de la máquina, habitualmente 1,75mm o 2,85mm</rdfs:comment>
        <rdfs:label xml:lang="es">Diámetro de filamento</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#diametroPinzaSoportado -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#diametroPinzaSoportado">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#HerramientaRotativa"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Métrica del collarín de sujeción o portabrocas integrado, determinante para acotar la compatibilidad física de la herramienta con estandarizaciones comerciales de accesorios de terceros, ej. 3.2mm, 1/8 pulgada</rdfs:comment>
        <rdfs:label xml:lang="es">Diámetro de pinza soportado</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#diametrosAdmitidos -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#diametrosAdmitidos">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorVinilo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Formatos físicos estandarizados según su diámetro en pulgadas que el plato y el brazo fonocaptor pueden abarcar mecánicamente para su lectura, ej. 7&quot;, 10&quot;, 12&quot;</rdfs:comment>
        <rdfs:label xml:lang="es">Diámetros admitidos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#dimensionesFisicasSoporte -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#dimensionesFisicasSoporte">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#AcondicionamientoEstudio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Medidas perimetrales de la estructura o material desplegado, determinantes para calcular la viabilidad de cobertura espacial en la sala de grabación, ej. 2x3m, 50x50cm</rdfs:comment>
        <rdfs:label xml:lang="es">Dimensiones físicas de soporte</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#dimensionesPlatoPlano -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#dimensionesPlatoPlano">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PrensaTermica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Área máxima de intervención bidimensional de la resistencia principal, que acota estructuralmente el formato límite de los sustratos que pueden procesarse en un solo ciclo de cierre por presión</rdfs:comment>
        <rdfs:label xml:lang="es">Dimensiones de plato plano</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#disenoAcustico -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#disenoAcustico">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Monitorizacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Configuración estructural de la cúpula que determina el grado de aislamiento pasivo y la fuga de audio, crítico para evitar la retroalimentación en micrófonos durante sesiones de grabación vocal, ej. Cerrado, Abierto, Semicerrado</rdfs:comment>
        <rdfs:label xml:lang="es">Diseño acústico</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#distanciaOperativaOptima -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#distanciaOperativaOptima">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SeguimientoOcular"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Rango longitudinal de separación física requerida entre el plano focal del emisor infrarrojo y el rostro del sujeto, expresado en milímetros, vital para configurar la ergonomía del entorno de pruebas de Interacción Persona-Ordenador sin perder el rastreo pupilar, ej. 500-800mm</rdfs:comment>
        <rdfs:label xml:lang="es">Distancia operativa óptima</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#documentoIdentidad -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#documentoIdentidad">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Usuario"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Identificador oficial expedido por una autoridad gubernamental, como el DNI, NIE o pasaporte, indispensable para registrar la trazabilidad legal del usuario y auditar el préstamo de equipamiento de cierto valor económico</rdfs:comment>
        <rdfs:label xml:lang="es">Documento de identidad</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#esAutocicatrizante -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#esAutocicatrizante">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#TapeteCorte"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Propiedad estructural del polímero base que permite la restitución física de la superficie tras incisiones superficiales, vital para prolongar la vida útil del material y evitar el desvío de la herramienta en cortes sucesivos</rdfs:comment>
        <rdfs:label xml:lang="es">Es autocicatrizante</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#esAutomatico -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#esAutomatico">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#RebobinadorFilamento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Atributo lógico que determina si el dispositivo de rebobinado opera de forma motorizada e independiente o si requiere del accionamiento mecánico manual por parte del operador para guiar el hilo.</rdfs:comment>
        <rdfs:label xml:lang="es">Es automático</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#esChasisMultifuncion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#esChasisMultifuncion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PrensaTermica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador mecánico y eléctrico sobre si el bastidor de la unidad permite la extracción del bloque de calor primario para acoplar, alimentar y gestionar térmicamente resistencias periféricas con morfologías no planas</rdfs:comment>
        <rdfs:label xml:lang="es">Es chasis multifunción</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#esEspectroRGB -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#esEspectroRGB">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Iluminacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador técnico sobre la incorporación de diodos de color dedicados que permiten la mezcla aditiva para bañar fondos o generar luz de contra en cualquier tono del espectro cromático, más allá de la escala térmica de blancos</rdfs:comment>
        <rdfs:label xml:lang="es">Es espectro RGB</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#esInstrumento -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#esInstrumento">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#InstrumentoMusical"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Nombre del instrumento musical en cuestión</rdfs:comment>
        <rdfs:label xml:lang="es">Es instrumento</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#esPlegableTensado -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#esPlegableTensado">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#FondoCromatico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Diseño estructural que incorpora un marco flexible perimetral para auto-tensar el material al desplegarse, evitando la formación mecánica de pliegues que generen gradientes de sombra perjudiciales para la homogeneidad del recorte</rdfs:comment>
        <rdfs:label xml:lang="es">Es plegable y tensado</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#escalaCalibreComercial -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#escalaCalibreComercial">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Pinceleria"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Identificador alfanumérico estandarizado por la industria que clasifica el volumen transversal del mechón y la longitud útil de las fibras, métrica crítica para adecuar la herramienta a la escala micrométrica del componente a detallar o a grandes superficies de imprimación, ej. 000, 2, 5/0</rdfs:comment>
        <rdfs:label xml:lang="es">Escala de calibre comercial</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#espesorNominal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#espesorNominal">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PlanchaRigida"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Medida transversal de la materia prima expresada en milímetros, parámetro físico indispensable para establecer la profundidad de pasada en el mecanizado o la distancia focal de la óptica garantizando que la herramienta atraviese el sustrato sin perforar la cama de sacrificio perimetral, ej. 3, 5</rdfs:comment>
        <rdfs:label xml:lang="es">Espesor nominal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#estadoBloqueoCautelar -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#estadoBloqueoCautelar">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ComunidadUniversitaria"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador que señala si el trabajador tiene suspendidos sus privilegios de reserva en el taller por alguna negligencia previa o retraso en las devoluciones</rdfs:comment>
        <rdfs:label xml:lang="es">Estado de bloqueo cautelar</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#estadoOperativo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#estadoOperativo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Condición técnica actual de la máquina para su uso, Activo, Averiado, En Mantenimiento…</rdfs:comment>
        <rdfs:label xml:lang="es">Estado operativo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#estadoTransaccion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#estadoTransaccion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Indicador logístico que define en tiempo real si el préstamo está activo, finalizado o en estado de morosidad. Valores: &quot;EXITOSO, CANCELADO, ACTIVO, INCIDENCIA&quot;.</rdfs:comment>
        <rdfs:label xml:lang="es">Estado de transacción</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#estandarPuntaIntercambiable -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#estandarPuntaIntercambiable">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EstacionSoldadura"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Especificación física y métrica del vástago o cartucho de transmisión de calor que determina la compatibilidad estricta con consumibles de repuesto, indispensable para la gestión del inventario y el mantenimiento de la herramienta, ej. Serie 900M, Cartuchos T12</rdfs:comment>
        <rdfs:label xml:lang="es">Estándar de punta intercambiable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#estandarPuntaIntercambiableSoldLapiz -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#estandarPuntaIntercambiableSoldLapiz">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SoldadorLapiz"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Especificación física y métrica del vástago macizo de transmisión de calor que determina la compatibilidad estricta con consumibles de repuesto, indispensable para garantizar la operatividad continua de la herramienta básica en el taller, ej. Serie 900M, Punta roscada estándar</rdfs:comment>
        <rdfs:label xml:lang="es">Estándar de punta intercambiable para soldador de lápiz</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaAdquisicionInstitucional -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaAdquisicionInstitucional">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="es">Registro cronológico de la incorporación física y contable del activo al catálogo, métrica administrativa indispensable para calcular la amortización del hardware a lo largo de su ciclo de vida, auditar la vigencia de las coberturas de garantía y gestionar la rotación prioritaria de lotes en materiales fungibles sometidos a degradación temporal, ej. 2026-06-04</rdfs:comment>
        <rdfs:label xml:lang="es">Fecha de adquisición institucional</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaAdquisicionInstitucionalConsumible -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaAdquisicionInstitucionalConsumible">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Consumible"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="es">Registro cronológico de la incorporación física y contable del activo al catálogo, métrica administrativa indispensable para calcular la amortización del hardware a lo largo de su ciclo de vida, auditar la vigencia de las coberturas de garantía y gestionar la rotación prioritaria de lotes en materiales fungibles sometidos a degradación temporal, ej. 2026-06-04</rdfs:comment>
        <rdfs:label xml:lang="es">Fecha de adquisición institucional de consumible</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaDevolucionEsperada -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaDevolucionEsperada">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="es">Límite temporal asignado al usuario para retornar el material físico al taller, cuyo incumplimiento dispara automáticamente los bloqueos cautelares en su ficha</rdfs:comment>
        <rdfs:label xml:lang="es">Fecha de devolución esperada</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaFinEvento -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaFinEvento">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="es">Fecha de fin de evento</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaInicioEvento -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaInicioEvento">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="es">Marca temporal exacta en la que se registra la transacción, la alerta o el curso, un dato vital para mantener el orden cronológico en la base de datos</rdfs:comment>
        <rdfs:label xml:lang="es">Fecha de inicio de evento</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaNacimiento -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#fechaNacimiento">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Usuario"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="es">Registro cronológico del nacimiento del individuo, una propiedad preferible a la edad estática ya que permite al sistema calcular dinámicamente los años del usuario y mantener la base de datos siempre actualizada</rdfs:comment>
        <rdfs:label xml:lang="es">Fecha de nacimiento</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#flujoLuminosoMaximo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#flujoLuminosoMaximo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Iluminacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Potencia bruta de emisión del sistema, expresada habitualmente en lúmenes, vital para calcular la cobertura espacial del set o contrarrestar el sangrado de luz natural directa por las ventanas</rdfs:comment>
        <rdfs:label xml:lang="es">Flujo luminoso máximo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#flujoLuminosoMaximoProyector -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#flujoLuminosoMaximoProyector">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Proyector"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Potencia lumínica absoluta de la fuente de emisión estandarizada bajo la norma ANSI y expresada en lúmenes, factor crítico para garantizar la legibilidad del área proyectada en salas con alta contaminación de luz ambiental, ej. 3000, 5000</rdfs:comment>
        <rdfs:label xml:lang="es">Flujo luminoso máximo de proyector</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoCintaVideo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoCintaVideo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorVideo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="es">Formato cinta vídeo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoDiscoMagnetico -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoDiscoMagnetico">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorDiscosMagneticos"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="es">Formato disco magnético</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoNormalizadoMaximo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoNormalizadoMaximo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Encuadernacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Dimensión estandarizada límite, habitualmente expresada mediante la serie A de la norma ISO 216, que el área de operación es capaz de abarcar íntegramente sin requerir la partición o el plegado previo del sustrato, vital para planificar el postprocesado de los pliegos impresos, ej. A3, A4</rdfs:comment>
        <rdfs:label xml:lang="es">Formato normalizado máximo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoPapelMaximo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoPapelMaximo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerDocumental"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Tamaño estandarizado límite del documento físico que la superficie o campo visual del equipo puede abarcar en una sola captura, ej. A4, A3, Din-A2</rdfs:comment>
        <rdfs:label xml:lang="es">Formato de papel máximo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoSalidaPrincipal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoSalidaPrincipal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Digitalizacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Extensión o tipo de archivo digital estándar que el equipo genera como resultado nativo del proceso de captura o volcado, ej. PDF, STL, WAV, MP4, ISO</rdfs:comment>
        <rdfs:label xml:lang="es">Formato de salida principal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoSuministroFisico -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#formatoSuministroFisico">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#MaterialSustractivo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Configuración geométrica de entrega y almacenaje del material en bruto, indispensable para que la logística del recinto asigne almacenamiento de carga plana o soportes cilíndricos de desenrollado continuo, determinando además la compatibilidad con los sistemas de alimentación de la maquinaria, ej. Tablero plano, Bobina</rdfs:comment>
        <rdfs:label xml:lang="es">Formato de suministro físico</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#formatosDiscoAdmitidos -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#formatosDiscoAdmitidos">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorOptico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Tipos de soportes ópticos estandarizados que el láser del dispositivo es capaz de reconocer, fundamentales para la ingesta de colecciones de distintas generaciones, ej. CD-ROM, DVD±R, BD-RE</rdfs:comment>
        <rdfs:label xml:lang="es">Formatos de disco admitidos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#frecuenciaBaseProcesador -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#frecuenciaBaseProcesador">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPlacaUnica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Velocidad de reloj nominal de los núcleos principales del circuito integrado expresada en gigahercios, fundamental para evaluar la capacidad de cómputo bruto del dispositivo frente a tareas de procesamiento masivo de datos o ejecución de scripts concurrentes, ej. 1.5GHz, 2.4GHz</rdfs:comment>
        <rdfs:label xml:lang="es">Frecuencia base de procesador</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#frecuenciaMuestreoMaxima -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#frecuenciaMuestreoMaxima">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorAudio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Nivel límite de fidelidad en la conversión analógico-digital de la onda sonora, determinante para el rango dinámico de la captura, ej. 44.1kHz, 96kHz</rdfs:comment>
        <rdfs:label xml:lang="es">Frecuencia de muestreo máxima</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#frecuenciaRelojOperativa -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#frecuenciaRelojOperativa">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Microcontrolador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Velocidad de procesamiento del oscilador de cuarzo interno expresada habitualmente en megahercios, fundamental para determinar la viabilidad del dispositivo en operaciones estrictas de tiempo real y cálculo de interrupciones, ej. 16MHz, 133MHz</rdfs:comment>
        <rdfs:label xml:lang="es">Frecuencia de reloj operativa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#fuerzaCorteMaxima -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#fuerzaCorteMaxima">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CortadoraVinilo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Presión límite de empuje vertical ejercida por el electroimán del cabezal sobre la cuchilla, habitualmente expresada en gramos-fuerza, crítica para evaluar la penetración en sustratos densos o multicapa sin provocar el bloqueo del motor transversal</rdfs:comment>
        <rdfs:label xml:lang="es">Fuerza de corte máxima</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#generoUsuario -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#generoUsuario">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Usuario"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Clasificación demográfica del individuo, un dato estadístico que suelen requerir las instituciones académicas para elaborar memorias anuales y evaluar los perfiles de uso de las instalaciones</rdfs:comment>
        <rdfs:label xml:lang="es">Género de usuario</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#habilitaArea -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#habilitaArea">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#TallerFormativo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Designación del área que habilita a utilizar el curso en cuestión</rdfs:comment>
        <rdfs:label xml:lang="es">Habilita área</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#impedanciaNominal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#impedanciaNominal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Monitorizacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Resistencia eléctrica de las bobinas internas expresada en ohmios, determinante para saber si el equipo requiere amplificación dedicada para alcanzar un volumen operativo óptimo o si es apto para salidas de línea estándar</rdfs:comment>
        <rdfs:label xml:lang="es">Impedancia nominal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#incluyeAccesorios -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#incluyeAccesorios">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPortatil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Indicador logístico que registra si el chasis se entrega conjuntamente con elementos de protección estructural y alimentación externa, como fundas acolchadas o transformadores de corriente, indispensable para auditar la devolución íntegra del recurso prestado</rdfs:comment>
        <rdfs:label xml:lang="es">Incluye accesorios</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#incluyeControladoresCinematicos -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#incluyeControladoresCinematicos">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#GafasVR"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Disponibilidad de periféricos físicos de seguimiento espacial y respuesta háptica en el paquete base, determinantes para garantizar la interacción mecánica precisa y la manipulación de objetos en el entorno simulado frente a sistemas limitados exclusivamente al rastreo óptico de manos</rdfs:comment>
        <rdfs:label xml:lang="es">Incluye controladores cinemáticos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#incluyeFondosIntercambiables -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#incluyeFondosIntercambiables">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EstudioFotograficoPortatil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Disponibilidad de cicloramas de policarbonato o lona de distintos colores mate para el aislamiento óptico del objeto, vital para evitar rebotes de luz indeseados y facilitar la extracción automatizada del contorno mediante software de edición</rdfs:comment>
        <rdfs:label xml:lang="es">Incluye fondos intercambiables</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#indiceFlexibilidadFibras -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#indiceFlexibilidadFibras">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Pinceleria"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Grado de resistencia mecánica y capacidad de retorno elástico del mechón al aplicar presión física, cualidad técnica indispensable para discriminar entre herramientas aptas para técnicas de abrasión en seco frente a la aplicación sutil de veladuras líquidas, ej. Alta, Baja, Media</rdfs:comment>
        <rdfs:label xml:lang="es">Índice de flexibilidad de fibras</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazAlimentacionPrincipal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazAlimentacionPrincipal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PlacaDesarrollo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Estándar del puerto físico o receptáculo integrado diseñado para el suministro primario de corriente continua desde una fuente externa, vital para la planificación de la autonomía energética o el diseño de la carcasa del montaje final, ej. USB-C, Jack de barril</rdfs:comment>
        <rdfs:label xml:lang="es">Interfaz de alimentación principal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazConexionAudio -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazConexionAudio">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoAudio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Protocolo físico, analógico o digital empleado para la transmisión de la señal sonora o datos de control hacia la estación de trabajo, vital para determinar la compatibilidad del cableado en el montaje, ej. XLR, USB-C, Jack 6.3mm, MIDI</rdfs:comment>
        <rdfs:label xml:lang="es">Interfaz de conexión de audio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazConexionDatos -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazConexionDatos">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoVideo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Protocolo físico o estándar de red empleado para la transmisión bidireccional de la señal visual o la recepción de comandos de control desde la estación de trabajo, indispensable para la integración en el software de emisión, ej. USB-C, Wi-Fi, HDMI</rdfs:comment>
        <rdfs:label xml:lang="es">Interfaz de conexión de datos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazConexionPC -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazConexionPC">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Digitalizacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Tipo de puerto o protocolo físico requerido para enlazar el periférico con la estación de trabajo encargada de procesar o almacenar la captura, ej. USB-A, USB-C, Firewire</rdfs:comment>
        <rdfs:label xml:lang="es">Interfaz de conexión a PC</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazConexionTermica -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazConexionTermica">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#AdaptadoresPrensa"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Estándar de clavija física y distribución interna de pines requerido para enlazar el módulo con la unidad de control central del chasis para recibir voltaje y transmitir lecturas del termopar, crucial para garantizar la compatibilidad entre piezas de distintos fabricantes, ej. Conector de aviación de 4 pines, Clavija hembra de 5 pines</rdfs:comment>
        <rdfs:label xml:lang="es">Interfaz de conexión térmica</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazRedPrincipal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazRedPrincipal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPlacaUnica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Protocolo de comunicación de banda ancha, físico o inalámbrico, embebido directamente en el hardware, crítico para la integración en infraestructuras IoT, la descarga de repositorios de software y el mantenimiento de servicios como servidores locales, ej. Gigabit Ethernet, Wi-Fi 6</rdfs:comment>
        <rdfs:label xml:lang="es">Interfaz de red principal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazSalidaVideo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazSalidaVideo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPlacaUnica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Estándar de conexión física habilitado para la transmisión nativa de señal audiovisual hacia monitores periféricos, indispensable para la configuración inicial y la operación del dispositivo mediante entorno gráfico de escritorio sin depender de accesos remotos por consola, ej. Micro-HDMI, DSI</rdfs:comment>
        <rdfs:label xml:lang="es">Interfaz de salida de vídeo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazTransmision -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#interfazTransmision">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Vía o método físico/inalámbrico admitido para el envió de los archivos de código máquina al dispositivo, Tarjeta SD, mSD, USB, Wi-Fi…</rdfs:comment>
        <rdfs:label xml:lang="es">Interfaz de transmisión</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#licenciasSoftwareDespliegue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#licenciasSoftwareDespliegue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorEstacionTrabajo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Catálogo de entornos de diseño asistido por ordenador, laminadores o software de simulación física con clave institucional preactivada en el equipo local, vital para que el usuario verifique la disponibilidad de su entorno de trabajo antes de ocupar el puesto, ej. SolidWorks, AutoCAD, Ultimaker Cura</rdfs:comment>
        <rdfs:label xml:lang="es">Licencias de software de despliegue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#marca -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#marca">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Consumible"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Designación comercial del fabricante del elemento</rdfs:comment>
        <rdfs:label xml:lang="es">Marca</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#materialElementoCalefactor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#materialElementoCalefactor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SoldadorLapiz"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Composición física de la resistencia interna encargada de la transformación energética constante, determinante para evaluar la curva de aceleración térmica inicial y la retención del calor en un circuito carente de regulación electrónica activa, ej. Cerámica, Aleación de nicrom</rdfs:comment>
        <rdfs:label xml:lang="es">Material de elemento calefactor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#mecanismoAcopleChasis -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#mecanismoAcopleChasis">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#AccesorioBrazoHerramientaRotativa"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Estándar físico de anclaje que permite la fijación rígida del brazo extensor o la base de fresado a la carcasa del motor principal, asegurando la transmisión del par de giro o manteniendo la perpendicularidad del eje sin holguras, ej. Rosca frontal Dremel</rdfs:comment>
        <rdfs:label xml:lang="es">Mecanismo de acople a chasis</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#metodoFijacionSoporte -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#metodoFijacionSoporte">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ViniloCorte"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Principio termodinámico o mecánico requerido para la adherencia permanente del vector recortado sobre el material receptor, permitiendo a la plataforma discriminar entre sustratos de activación por presión manual en frío frente a polímeros que fuerzan al usuario a reservar paralelamente una prensa de transferencia térmica, ej. Adhesión en frío, Termofijación</rdfs:comment>
        <rdfs:label xml:lang="es">Método de fijación a soporte</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#modelo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#modelo">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Consumible"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Versión técnica del dispositivo</rdfs:comment>
        <rdfs:label xml:lang="es">Modelo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#modeloGraficaInstalada -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#modeloGraficaInstalada">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Especificación de la unidad de procesamiento gráfico presente en la configuración base, orientada a registrar controladores integrados o chips dedicados estándar antes de evaluar el músculo gráfico especializado de las estaciones de trabajo, ej. Intel Iris Xe, AMD Radeon Graphics</rdfs:comment>
        <rdfs:label xml:lang="es">Modelo de gráfica instalada</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#modeloProcesador -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#modeloProcesador">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Denominación comercial y técnica del microprocesador central que determina la generación y el modelo específico del chip, parámetro esencial para evaluar la capacidad de cómputo bruto del sistema, ej. Intel Core i7-12700H, AMD Ryzen 5 5700X</rdfs:comment>
        <rdfs:label xml:lang="es">Modelo de procesador</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#morfologiaCabezalPictorico -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#morfologiaCabezalPictorico">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Pinceleria"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Diseño de la matriz del mechón de fibras, responsable de dictar la huella geométrica y el comportamiento del pigmento al presionar sobre la superficie de la pieza, ej. Plano, Redondo, Lengua de gato</rdfs:comment>
        <rdfs:label xml:lang="es">Morfología de cabezal pictórico</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#morfologiaSustratoDestino -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#morfologiaSustratoDestino">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#AdaptadoresPrensa"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Diseño geométrico específico de la resistencia térmica moldeada para acoplarse y aplicar presión uniforme sobre la curvatura de objetos volumétricos concretos, vital para acotar qué artículos de merchandising permite procesar el módulo esclavo, ej. Taza cilíndrica 11oz, Gorra curva, Plato 8 pulgadas</rdfs:comment>
        <rdfs:label xml:lang="es">Morfología de sustrato destino</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#naturalezaCerdas -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#naturalezaCerdas">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Pinceleria"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Origen biológico o formulación sintética de las fibras de aplicación, determinante para prever el nivel de retención hídrica, la flexibilidad estructural del trazo y la compatibilidad con ciertos aglutinantes, ej. Marta Kolinsky, Nylon</rdfs:comment>
        <rdfs:label xml:lang="es">Naturaleza de cerdas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#naturalezaMaterialBase -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#naturalezaMaterialBase">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PlanchaRigida"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Clasificación taxonómica o polimérica de la matriz estructural del tablero, determinante empírico para que el operario calcule las revoluciones del husillo, prevea el desprendimiento de viruta y seleccione la herramienta de corte adecuada sin astillar los bordes de la pieza, ej. MDF, Contrachapado de chopo, Metacrilato de extrusión</rdfs:comment>
        <rdfs:label xml:lang="es">Naturaleza de material base</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#naturalezaTransmision -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#naturalezaTransmision">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoAudio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Formato estructural del flujo de información que el dispositivo emite o recibe, determinante para planificar la cadena de conexión y saber si el equipo requiere conversión previa antes de integrarse en el software, ej. Analógica, Digital, MIDI</rdfs:comment>
        <rdfs:label xml:lang="es">Naturaleza de transmisión</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#necesitaHabilitacion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#necesitaHabilitacion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador restrictivo sobre la obligatoriedad de haber superado un taller formativo previo para poder operar el recurso</rdfs:comment>
        <rdfs:label xml:lang="es">Necesita habilitación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#nivelPrioridadResolucion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#nivelPrioridadResolucion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SoporteMantenimiento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Escala de urgencia asignada al aviso, fundamental para que los coordinadores sepan qué alertas de stock o averías deben atender primero para no paralizar el taller. 1-Bajo, 5-Muy urgente</rdfs:comment>
        <rdfs:label xml:lang="es">Nivel de prioridad de resolución</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#nivelToleranciaQuimica -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#nivelToleranciaQuimica">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#TratamientoCromatico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Capacidad estructural de los materiales de fabricación, sean juntas tóricas, cerdas o polímeros, para soportar la exposición directa y prolongada a disolventes orgánicos agresivos sin sufrir degradación física durante los ciclos de limpieza, ej. Acrílicos al agua, Lacas celulósicas</rdfs:comment>
        <rdfs:label xml:lang="es">Nivel de tolerancia química</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#nombreCompleto -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#nombreCompleto">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Usuario"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Cadena de texto que recoge el nombre y los apellidos de la persona, un dato básico y necesario para la identificación presencial en el mostrador, la firma de actas o la asignación de responsabilidades directas</rdfs:comment>
        <rdfs:label xml:lang="es">Nombre completo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#nombreEquipo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#nombreEquipo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Denominación del equipamiento.</rdfs:comment>
        <rdfs:label xml:lang="es">Nombre de equipo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#nombreTaller -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#nombreTaller">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#TallerFormativo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Nombre del curso impartido por la Biblioteca para el manejo de la maquinaria del Bibliomaker</rdfs:comment>
        <rdfs:label xml:lang="es">Nombre de taller</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#numeroCabezales -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#numeroCabezales">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorVideo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Cantidad de lectores magnéticos instalados en el tambor rotatorio, determinante para la fidelidad de la imagen en pausa y la decodificación de audio estéreo Hi-Fi</rdfs:comment>
        <rdfs:label xml:lang="es">Número de cabezales</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#observacionNivelStock -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#observacionNivelStock">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#IncidenciaTecnica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Registro de texto en el que el usuario detalla de forma aproximada la cantidad sobrante que ha detectado visualmente en la caja o la estantería, sirviendo como aviso preliminar para que el coordinador audite el inventario real, ej. &quot;Queda menos de medio bote&quot;, &quot;Solo quedan dos brocas sanas&quot;</rdfs:comment>
        <rdfs:label xml:lang="es">Observación de nivel de stock</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#patronPolar -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#patronPolar">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Microfono"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Sensibilidad direccional del dispositivo respecto a la fuente acústica, fundamental para predecir y mitigar la captación de ruido ambiente o reverberación de la sala, ej. Cardioide, Omnidireccional, Bidireccional</rdfs:comment>
        <rdfs:label xml:lang="es">Patrón polar</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#perfilSuperficial -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#perfilSuperficial">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PanelAcustico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Diseño geométrico tridimensional de la cara expuesta del material, optimizado mecánicamente para la difracción o mitigación de rangos de frecuencia acústica específicos, ej. Piramidal, Trampa de graves, Liso</rdfs:comment>
        <rdfs:label xml:lang="es">Perfil superficial</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#permiteImpresionDirecta -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#permiteImpresionDirecta">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SecadorFilamento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador físico sobre la presencia de orificios de salida que permiten alimentar el filamento hacia la impresora mientras la bobina permanece secándose en su interior</rdfs:comment>
        <rdfs:label xml:lang="es">Permite impresión directa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#perteneceADominioSeguro -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#perteneceADominioSeguro">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador lógico que confirma si el equipo informático está integrado de forma nativa en el servicio de directorio activo y bajo el firewall institucional, parámetro de red ineludible para acotar los permisos de acceso a carpetas compartidas y aislar el tráfico general frente a la intranet confidencial del personal</rdfs:comment>
        <rdfs:label xml:lang="es">Pertenece a dominio seguro</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#pesoAlDespegueGramos -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#pesoAlDespegueGramos">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Dron"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Masa total del vehículo incluyendo baterías y carga útil, métrica legal estricta que determina la categoría de certificación europea requerida y las restricciones de vuelo en espacios urbanos, ej. 249, 595</rdfs:comment>
        <rdfs:label xml:lang="es">Peso al despegue en gramos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#pesoFisicoGramos -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#pesoFisicoGramos">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPortatil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Masa total del dispositivo informático, métrica ergonómica fundamental para que el usuario evalúe la viabilidad de su transporte continuo en la mochila durante el periodo de préstamo temporal por el campus, ej. 1300, 2100</rdfs:comment>
        <rdfs:label xml:lang="es">Peso físico en gramos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#potenciaElectricaNominal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#potenciaElectricaNominal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PrensaTermica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Consumo energético máximo del bloque de resistencias en pleno rendimiento, expresado en vatios, crítico para la planificación de la carga de red en el taller y la prevención de sobrecargas al operar maquinaria simultánea, ej. 1800W, 2200W</rdfs:comment>
        <rdfs:label xml:lang="es">Potencia eléctrica nominal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#potenciaEmisionLaser -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#potenciaEmisionLaser">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CorteLaser"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Capacidad máxima de salida del tubo o diodo generador expresada en vatios, determinante para establecer la profundidad de seccionado y el tipo de materiales admitidos sin riesgo de combustión, ej. 40W, 130W</rdfs:comment>
        <rdfs:label xml:lang="es">Potencia de emisión láser</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#potenciaTermicaNominal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#potenciaTermicaNominal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Soldadura_y_Ensamblaje"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Capacidad máxima de consumo energético del elemento calefactor expresada en vatios, crítica para evaluar la inercia térmica del instrumento y su capacidad para recuperar la temperatura operativa instantáneamente al soldar sobre planos de masa extensos o cableado de gran calibre, ej. 40W, 130W</rdfs:comment>
        <rdfs:label xml:lang="es">Potencia térmica nominal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#precisionCaptura -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#precisionCaptura">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Escaner3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Grado de fidelidad geométrica o margen de error mínimo del barrido respecto a la pieza original, expresado en fracciones de milímetro o micras</rdfs:comment>
        <rdfs:label xml:lang="es">Precisión de captura</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#precisionEspacialAngular -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#precisionEspacialAngular">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SeguimientoOcular"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="es">Margen de error promedio del vector de mirada respecto al estímulo visual objetivo, medido en grados de arco visual, métrica crítica para certificar la validez científica del hardware en estudios estrictos de microfijaciones o lectura de textos, ej. 0.5°, 1.2°</rdfs:comment>
        <rdfs:label xml:lang="es">Precisión espacial angular</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#presionOperativaMaxima -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#presionOperativaMaxima">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SistemaAerografia"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Límite superior de fuerza neumática soportada por el calderín y las válvulas expresada en bares o PSI, vital para determinar la capacidad del equipo para atomizar pigmentos de alta densidad o imprimaciones espesas sin atascarse, ej. 3 Bar, 45 PSI</rdfs:comment>
        <rdfs:label xml:lang="es">Presión operativa máxima</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#prestableDomicilio -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#prestableDomicilio">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador restrictivo sobre la viabilidad de cesión del material fuera de las instalaciones</rdfs:comment>
        <rdfs:label xml:lang="es">Prestable a domicilio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#procesadorOPU -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#procesadorOPU">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorPlacaUnica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Denominación comercial y fabricante del System on Chip o circuito integrado principal que centraliza las funciones de cómputo de la placa, indispensable para la identificación exacta del hardware y la consulta directa de hojas de especificaciones del fabricante, ej. Broadcom BCM2712, Rockchip RK3588</rdfs:comment>
        <rdfs:label xml:lang="es">Procesador de OPU</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#profundidadBits -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#profundidadBits">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorAudio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Resolución de amplitud de la onda sonora capturada, vital para definir el margen dinámico y la reducción de ruido de fondo, ej. 16-bit, 24-bit</rdfs:comment>
        <rdfs:label xml:lang="es">Profundidad de bits</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#profundidadColor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#profundidadColor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorFotografico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Cantidad de bits de información de luz y color capturados por cada píxel del sensor, vital para extraer todo el rango dinámico de las películas fotosensibles, ej. 24-bit, 48-bit</rdfs:comment>
        <rdfs:label xml:lang="es">Profundidad de color</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#rangoTemperaturaFusion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#rangoTemperaturaFusion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Intervalo térmico de plastificación recomendado expresado en grados Celsius, umbral termodinámico crítico para asegurar un flujo laminar constante a través del obturador sin generar atascos por carbonización del polímero ni fallos de adherencia entre capas, ej. 190-220°C, 240-260°C</rdfs:comment>
        <rdfs:label xml:lang="es">Rango de temperatura de fusión</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#rangoVelocidadRotacion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#rangoVelocidadRotacion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#HerramientaRotativa"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Espectro operativo del motor de corriente continua expresado en revoluciones por minuto, crítico para ajustar la fricción térmica según la densidad del material a mecanizar y evitar la fusión accidental de polímeros termoplásticos, ej. 5000-35000 RPM</rdfs:comment>
        <rdfs:label xml:lang="es">Rango de velocidad de rotación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#relacionAlcance -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#relacionAlcance">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Proyector"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Coeficiente óptico que relaciona la distancia de instalación del chasis con el ancho de la pantalla resultante, vital para determinar la viabilidad espacial del equipo clasificándolo en ópticas de tiro normal, corto o ultracorto, ej. 0.5:1, 1.2:1</rdfs:comment>
        <rdfs:label xml:lang="es">Relación de alcance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereAlimentacionDedicada -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereAlimentacionDedicada">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoVideo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador sobre si el equipo precisa conexión directa a la red eléctrica para alcanzar su rendimiento lumínico o de procesamiento máximo, diferenciándolo de los dispositivos alimentados exclusivamente por el bus de datos</rdfs:comment>
        <rdfs:label xml:lang="es">Requiere alimentación dedicada</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereAlimentacionExterna -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereAlimentacionExterna">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#RecuperacionSoporteDigital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador físico sobre si el periférico precisa conexión dedicada a la red eléctrica o si opera de forma autónoma mediante la energía suministrada por el propio bus de datos</rdfs:comment>
        <rdfs:label xml:lang="es">Requiere alimentación externa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereAlimentacionPhantom -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereAlimentacionPhantom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Microfono"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador técnico sobre la necesidad de inyectar voltaje continuo externo, habitualmente 48V, a través de la propia conexión para polarizar la cápsula y alimentar la circuitería interna</rdfs:comment>
        <rdfs:label xml:lang="es">Requiere alimentación Phantom</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereAnclajeMobiliario -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereAnclajeMobiliario">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Encuadernacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador de seguridad y estabilidad sobre si la inercia del bloque o la fuerza de torsión mecánica ejercida por el usuario exige que la base esté fijada de manera semipermanente a la superficie de trabajo para prevenir accidentes o el desplazamiento indeseado de la herramient</rdfs:comment>
        <rdfs:label xml:lang="es">Requiere anclaje a mobiliario</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereCerramientoImpresora -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereCerramientoImpresora">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador termodinámico de contracción volumétrica que especifica si el coeficiente de dilatación del polímero exige obligatoriamente su ejecución en una cámara de impresión aislada y calefactada para evitar la delaminación o el pandeo estructural de las capas base</rdfs:comment>
        <rdfs:label xml:lang="es">Requiere cerramiento de impresora</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereComputacionExterna -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereComputacionExterna">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#GafasVR"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Dependencia arquitectónica de un equipo informático secundario para el renderizado del entorno tridimensional, diferenciando arquitecturas de procesamiento integrado o &apos;standalone&apos; frente a visores que actúan como meros periféricos de un PC</rdfs:comment>
        <rdfs:label xml:lang="es">Requiere computación externa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereInstalacionFija -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereInstalacionFija">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Presentacion_y_Difusion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador logístico y estructural sobre si el equipamiento exige anclaje mecánico semipermanente a la arquitectura del espacio, como techos o soportes de pared, frente a la posibilidad de un despliegue portátil libre sobre mobiliario de la biblioteca</rdfs:comment>
        <rdfs:label xml:lang="es">Requiere instalación fija</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereLaminaTransportadora -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereLaminaTransportadora">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ViniloCorte"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Condicionante operativo que dictamina si el sustrato exige el consumo simultáneo de un film auxiliar para trasladar el diseño troquelado desde su base protectora hasta el objeto destino manteniendo intacta la topología de los vectores flotantes</rdfs:comment>
        <rdfs:label xml:lang="es">Requiere lámina transportadora</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereParadaOperativa -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereParadaOperativa">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#IncidenciaTecnica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Condicionante que fuerza la inhabilitación automática de la máquina en el sistema de reservas para evitar daños mayores o accidentes hasta que un técnico la revise</rdfs:comment>
        <rdfs:label xml:lang="es">Requiere parada operativa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereSoftwareDedicado -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#requiereSoftwareDedicado">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoVideo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador técnico sobre la necesidad de instalar controladores propietarios o paneles de gestión específicos en el sistema operativo para desbloquear parámetros avanzados, mapeo de teclas o perfiles de color, más allá del funcionamiento genérico plug-and-play</rdfs:comment>
        <rdfs:label xml:lang="es">Requiere software dedicado</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#resistenciaMaximaViento -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#resistenciaMaximaViento">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Dron"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Umbral aerodinámico límite soportado por los rotores y el algoritmo de estabilización de actitud para mantener el vuelo estacionario sin deriva, expresado habitualmente en metros por segundo, dato indispensable para evaluar la viabilidad y seguridad de la captura de datos en exteriores bajo condiciones meteorológicas adversas, ej. 10m/s</rdfs:comment>
        <rdfs:label xml:lang="es">Resistencia máxima al viento</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionCapturaMaxima -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionCapturaMaxima">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorVideo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Límite de líneas horizontales o píxeles efectivos que el hardware es capaz de muestrear y convertir a formato digital sin interpolación, ej. 720x576</rdfs:comment>
        <rdfs:label xml:lang="es">Resolución de captura máxima</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionCapturaMaximaFoto -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionCapturaMaximaFoto">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraFotografias"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Máxima resolución a la que permite capturar imágenes congeladas de forma nativa, sin interpolación</rdfs:comment>
        <rdfs:label xml:lang="es">Resolución de captura máxima de fotografía</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionCapturaMaximaVideo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionCapturaMaximaVideo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraFotografias"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Máxima resolución y framerate a la que permite capturar imágenes en movimiento</rdfs:comment>
        <rdfs:label xml:lang="es">Resolución de captura máxima de vídeo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionCapturaMaximaWebCam -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionCapturaMaximaWebCam">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraWeb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Límite estandarizado de densidad de píxeles efectivos que el sensor óptico es capaz de registrar por cada fotograma, determinante para la definición espacial y el nivel de detalle de la emisión, ej. 1080p, 4K</rdfs:comment>
        <rdfs:label xml:lang="es">Resolución de captura máxima de webcam</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionOpticaMaxima -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionOpticaMaxima">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerDocumental"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Nivel máximo de detalle capturado por el sensor, expresado habitualmente en puntos por pulgada o DPI, fundamental para garantizar la legibilidad en digitalizaciones de conservación.</rdfs:comment>
        <rdfs:label xml:lang="es">Resolución óptica máxima</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionOpticaMaximaDFotog -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionOpticaMaximaDFotog">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorFotografico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Nivel máximo de densidad de píxeles capturados por el sensor, expresado en PPI, fundamental para permitir ampliaciones digitales viables a partir de formatos físicos minúsculos</rdfs:comment>
        <rdfs:label xml:lang="es">Resolución óptica máxima de digitalizador fotográfico</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionOpticaNativa -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionOpticaNativa">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Proyector"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Matriz física real de píxeles generada por el motor de imagen o los paneles internos sin recurrir a interpolación por software o escalado digital, determinante para asegurar la nitidez tipográfica estricta en presentaciones académicas, ej. 1920x1080, 3840x2160</rdfs:comment>
        <rdfs:label xml:lang="es">Resolución óptica nativa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionPorOjo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#resolucionPorOjo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#GafasVR"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Densidad de píxeles asignada a cada panel óptico individual, determinante para mitigar el efecto rejilla de la pantalla y garantizar la legibilidad de tipografías en interfaces inmersivas, ej. 1832x1920, 2064x2208</rdfs:comment>
        <rdfs:label xml:lang="es">Resolución por ojo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#saldoFilamentoAgotado -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#saldoFilamentoAgotado">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ComunidadUniversitaria"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicativo encargado de reflejar si el usuario en cuestión ha agotado los 200g de filamento que la biblioteca aporta de manera gratuita.</rdfs:comment>
        <rdfs:label xml:lang="es">Saldo de filamento agotado</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemaEmisionSoportado -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemaEmisionSoportado">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorVideo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Compatibilidad de decodificación del hardware con los estándares internacionales de señal de televisión analógica, ej. PAL, NTSC, SECAM</rdfs:comment>
        <rdfs:label xml:lang="es">Sistema de emisión soportado</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemaOperativoInstalado -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemaOperativoInstalado">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Plataforma de software base encargada de la gestión de los recursos de hardware y la ejecución de entornos de usuario, factor crítico para auditar la compatibilidad de las aplicaciones institucionales y herramientas de desarrollo, ej. Windows 11 Pro, Ubuntu LTS</rdfs:comment>
        <rdfs:label xml:lang="es">Sistema operativo instalado</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemaPosicionamientoEspacial -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemaPosicionamientoEspacial">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoVideo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Configuración mecánica o base de apoyo requerida para integrar y estabilizar el dispositivo en el entorno operativo, ej. Soporte de sobremesa antideslizante, Trípode, Zapata</rdfs:comment>
        <rdfs:label xml:lang="es">Sistema de posicionamiento espacial</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemaTraccion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemaTraccion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorVinilo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Mecanismo físico de transferencia de movimiento desde el motor hasta el plato giratorio, determinante para la estabilidad de la rotación y el aislamiento de vibraciones, ej. Correa, Directa</rdfs:comment>
        <rdfs:label xml:lang="es">Sistema de tracción</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemasArchivosCompatibles -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemasArchivosCompatibles">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#RecuperacionSoporteDigital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Formatos lógicos de volumen históricos que el hardware y su controlador son capaces de interpretar para montar el soporte en el sistema operativo huésped, ej. FAT12, ISO 9660, UDF</rdfs:comment>
        <rdfs:label xml:lang="es">Sistemas de archivos compatibles</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemasReduccionRuido -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#sistemasReduccionRuido">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorCasete"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Filtros analógicos integrados en el hardware para atenuar el siseo de alta frecuencia propio del soporte magnético durante la reproducción, ej. Dolby B, Dolby C</rdfs:comment>
        <rdfs:label xml:lang="es">Sistemas de reducción de ruido</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#softwareGestionPrincipal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#softwareGestionPrincipal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorAdministracion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Cliente de administración integral o sistema de planificación de recursos empresariales desplegado específicamente en la terminal, determinante para acotar si el puesto está habilitado para realizar altas de inventario, auditorías o simples reservas, ej. Koha, Alma, SAP</rdfs:comment>
        <rdfs:label xml:lang="es">Software de gestión principal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#soportaNavegacionWaypoints -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#soportaNavegacionWaypoints">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Dron"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Capacidad del firmware operativo para interpretar y ejecutar misiones de vuelo preprogramadas mediante una malla de coordenadas espaciales GNSS</rdfs:comment>
        <rdfs:label xml:lang="es">Soporta navegación por waypoints</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#soporteFisicoAdmitido -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#soporteFisicoAdmitido">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Digitalizacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Naturaleza o formato físico del material original que el dispositivo está capacitado para leer, capturar o transcodificar, ej. Documento impreso, Cinta magnética, Película fotosensible</rdfs:comment>
        <rdfs:label xml:lang="es">Soporte físico admitido</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#suministraAlimentacionPhantom -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#suministraAlimentacionPhantom">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#InterfazAudio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Capacidad del hardware para inyectar voltaje continuo de 48V a través de sus conectores, indispensable para habilitar la operatividad de micrófonos de condensador externos</rdfs:comment>
        <rdfs:label xml:lang="es">Suministra alimentación Phantom</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#susceptibleDegradacionAmbiental -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#susceptibleDegradacionAmbiental">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Consumible"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador estructural o químico que determina si la matriz del material sufre caducidad, oxidación o pérdida de propiedades mecánicas al interactuar pasivamente con la humedad relativa, la radiación ultravioleta o los gradientes térmicos del recinto, forzando la asignación de contenedores estancos o desecantes durante su almacenaje</rdfs:comment>
        <rdfs:label xml:lang="es">Susceptible a degradación ambiental</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tamañoSensor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tamañoSensor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraFotografias"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Tamaño expresado en pulgadas del sensor principal del equipo</rdfs:comment>
        <rdfs:label xml:lang="es">Tamaño de sensor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tasaFotogramasMaximaWebCam -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tasaFotogramasMaximaWebCam">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraWeb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Número límite de imágenes fijas consecutivas capturadas por segundo en la resolución operativa óptima, vital para garantizar la fluidez temporal y la naturalidad del movimiento en la transmisión, ej. 30 fps, 60 fps</rdfs:comment>
        <rdfs:label xml:lang="es">Tasa de fotogramas máxima de webcam</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tasaRefrescoNativa -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tasaRefrescoNativa">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#GafasVR"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Frecuencia de actualización de los paneles expresada en hercios, umbral físico indispensable para prevenir la cinetosis o mareo por movimiento durante la traslación virtual del usuario, ej. 90Hz, 120Hz</rdfs:comment>
        <rdfs:label xml:lang="es">Tasa de refresco nativa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tecnologiaGeneracionLaser -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tecnologiaGeneracionLaser">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CorteLaser"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Naturaleza física del medio activo empleado para la amplificación de la luz, crucial para determinar la compatibilidad de alteración sobre sustratos orgánicos, polímeros o metálicos puros, ej. CO2, Diodo, Estado sólido</rdfs:comment>
        <rdfs:label xml:lang="es">Tecnología de generación láser</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tecnologiaMemoriaRAMPC -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tecnologiaMemoriaRAMPC">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Ordenador"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Estándar físico y de velocidad de los módulos de memoria integrados en la placa, necesario para determinar la tasa de transferencia de datos interna y evaluar la compatibilidad de los componentes, ej. DDR4, DDR5</rdfs:comment>
        <rdfs:label xml:lang="es">Tecnología de memoria RAM de PC</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#telefonoContacto -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#telefonoContacto">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Usuario"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Dato requerido en caso de ser necesario contactar de urgencia con el usuario</rdfs:comment>
        <rdfs:label xml:lang="es">Teléfono de contacto</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaColorIluminacion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaColorIluminacion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EstudioFotograficoPortatil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Valor espectral de los paneles LED integrados expresado en grados Kelvin, métrica ineludible para asegurar la fidelidad cromática estricta de las piezas documentadas sin requerir correcciones agresivas de balance de blancos en postproducción, ej. 5500K</rdfs:comment>
        <rdfs:label xml:lang="es">Temperatura de color de iluminación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaColorVariable -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaColorVariable">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Iluminacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Capacidad del hardware para alternar electrónicamente los grados Kelvin emitidos, permitiendo igualar la luz ambiental o crear atmósferas específicas sin emplear filtros plásticos físicos, ej. 2700K a 6500K</rdfs:comment>
        <rdfs:label xml:lang="es">Temperatura de color variable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaMaximaExtrusor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaMaximaExtrusor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora_FDM"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Límite técnico del cabezal de impresión expresado en grados Celsius, crucial para determinar la compatibilidad con materiales avanzados</rdfs:comment>
        <rdfs:label xml:lang="es">Temperatura máxima de extrusor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaMaximaOperativa -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaMaximaOperativa">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PrensaTermica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Límite superior térmico de la platina calefactora expresado en grados, vital para determinar la compatibilidad con procesos de transferencia por sublimación de alta exigencia frente a aplicaciones de vinilo textil estándar de baja fusión</rdfs:comment>
        <rdfs:label xml:lang="es">Temperatura máxima operativa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaMaximaOperativaSoldador -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaMaximaOperativaSoldador">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Soldadura_y_Ensamblaje"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Límite superior de emisión calórica alcanzable por el elemento calefactor en estado de máximo rendimiento, expresado en grados Celsius, crítico para certificar la viabilidad de fusión sobre aleaciones de alta densidad libres de plomo y evaluar el riesgo de delaminación en circuitos impresos, ej. 450°C, 500°C</rdfs:comment>
        <rdfs:label xml:lang="es">Temperatura máxima operativa de soldador</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaMaximaSecado -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#temperaturaMaximaSecado">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SecadorFilamento"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Límite térmico alcanzable por el dispositivo expresado en grados Celsius, determinante para secar materiales técnicos que así lo requieran</rdfs:comment>
        <rdfs:label xml:lang="es">Temperatura máxima de secado</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneAltavocesIntegrados -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneAltavocesIntegrados">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Proyector"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Presencia de un sistema de transducción acústica embebido en el propio chasis del dispositivo, crítico para evaluar la autonomía del equipamiento en la reproducción de pistas de audio asociadas a la señal de vídeo sin obligar al usuario a desplegar sistemas de megafonía o periféricos independientes</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene altavoces integrados</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneAperturaCenital -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneAperturaCenital">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EstudioFotograficoPortatil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Presencia de trampillas o ventanas de inspección en la cúpula superior del habitáculo, diseñadas para habilitar la captura macrofotográfica en ángulo picado perpendicular sin proyectar sombras del dispositivo móvil o la cámara sobre el componente</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene apertura cenital</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneAsistenciaOptica -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneAsistenciaOptica">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EstacionSoldadura"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Presencia de lentes de aumento articuladas o sistemas de iluminación focalizada anclados físicamente al chasis de la estación, diseñados para facilitar la inspección visual directa de soldaduras microscópicas durante la intervención manual</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene asistencia óptica</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneAutoreverse -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneAutoreverse">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorCasete"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Capacidad mecánica del sistema de tracción y cabezales para invertir el sentido de lectura automáticamente al finalizar una cara, permitiendo la digitalización continua e ininterrumpida del soporte completo</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene autoreverse</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneBloqueoCuchilla -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneBloqueoCuchilla">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Guillotina"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Disponibilidad de un pestillo o fiador mecánico de seguridad estructural que ancla el brazo principal en su posición inferior de reposo, evitando la exposición o elevación accidental del filo mientras el dispositivo no está en uso</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene bloqueo de cuchilla</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneCabinaCerrada -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneCabinaCerrada">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">(Indicador físico sobre la presencia de un cerramiento estructural alrededor del área de impresión, vital para filtrado de gases, control térmico o protección UV).</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene cabina cerrada</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneCalibracionAutomatica -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneCalibracionAutomatica">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador técnico sobre la presencia de sensores de nivelación autónoma en la base de impresión, lo que reduce la intervención manual del usuario</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene calibración automática</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneCamaCaliente -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneCamaCaliente">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora_FDM"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador técnico sobre la presencia de una base térmica en la superficie de impresión, determinante para evitar el despegue de polímeros que sufren de contracción térmica</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene cama caliente</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneCompensacionLuzBaja -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneCompensacionLuzBaja">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraWeb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Capacidad del firmware interno integrado para ajustar dinámicamente la ganancia del sensor y el tiempo de exposición ante entornos pobremente iluminados, priorizando la legibilidad del sujeto principal frente a la aparición de artefactos o ruido digital</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene compensación de luz baja</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneControlTemperaturaVariable -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneControlTemperaturaVariable">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EstacionSoldadura"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Disponibilidad de un módulo de gestión electrónica en la unidad base que permite el ajuste preciso de los grados de emisión térmica en tiempo real, vital para adaptar el calor a diferentes aleaciones de soldadura sin dañar componentes sensibles</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene control de temperatura variable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneDeteccionMarcasRegistro -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneDeteccionMarcasRegistro">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CortadoraVinilo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Disponibilidad de un sensor óptico o infrarrojo integrado en el carro de corte para el escaneo autónomo de guías perimetrales, indispensable para la alineación y el seccionado preciso de contornos sobre gráficos generados previamente en periféricos de impresión externos</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene detección de marcas de registro</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneDeteccionObstaculos -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneDeteccionObstaculos">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Dron"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Presencia de un array de sensores de visión computacional o infrarrojos perimetrales integrados en el controlador principal, capacidad crítica para intervenir los comandos direccionales y frenar la aeronave autónomamente ante colisiones inminentes, salvaguardando la integridad física del equipo prestado</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene detección de obstáculos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneEscanerInventario -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneEscanerInventario">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorAdministracion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Presencia de un sistema de lectura óptica láser o de imágenes posicionado en el puesto de trabajo, indispensable para la captura automatizada de las etiquetas de catalogación del instrumental físico durante los procesos de entrega y devolución</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene escáner de inventario</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneGuiasMedicion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneGuiasMedicion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#TapeteCorte"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Disponibilidad de un patrón gráfico impreso en la superficie operativa que incluye cuadrículas milimetradas y ángulos estandarizados, diseñado para facilitar la alineación geométrica y el dimensionado del sustrato sin requerir instrumental de dibujo adicional</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene guías de medición</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneIluminacionIntegrada -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneIluminacionIntegrada">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraWeb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Presencia de un sistema de diodos emisores de luz físicos acoplados en el chasis perimetral del objetivo, diseñado para proporcionar iluminación frontal de compensación directa sobre el sujeto operativo sin requerir la instalación de periféricos lumínicos externos</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene iluminación integrada</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneMotorSonidoIntegrado -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneMotorSonidoIntegrado">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#InstrumentoMusical"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador sobre la capacidad del hardware para generar ondas de audio de forma autónoma, lo que permite discriminar entre sintetizadores o instrumentos de cuerda física frente a superficies de control puro que dependen obligatoriamente de instrumentos virtuales en la estación de trabajo</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene motor de sonido integrado</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneObturadorPrivacidad -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneObturadorPrivacidad">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraWeb"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Presencia de un mecanismo físico deslizante o cubierta magnética que bloquea mecánicamente el acceso visual a la lente, garantizando la seguridad perimetral del entorno contra transmisiones no autorizadas sin depender de anulaciones por software</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene obturador de privacidad</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tienePantallaTactil -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tienePantallaTactil">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ControladorRealizacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Disponibilidad de una superficie de visualización interactiva adicional a los botones físicos, diseñada para ampliar la capacidad de control mediante gestos de deslizamiento lateral o monitorización de métricas del directo</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene pantalla táctil</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tienePedalCaptura -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tienePedalCaptura">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerCenital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Presencia de un periférico de accionamiento mediante el pie, indispensable para liberar las manos del operador al pasar páginas o manipular material histórico delicado</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene pedal de captura</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tienePisonRetencion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tienePisonRetencion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Guillotina"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Presencia de un mecanismo de presión de ajuste manual o automático que inmoviliza el bloque de sustrato contra la base operativa, previniendo el desplazamiento o abanico lateral durante el cizallado para garantizar una escuadra perfecta</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene pisón de retención</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tienePreamplificadorIntegrado -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tienePreamplificadorIntegrado">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorAudio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador técnico sobre la inclusión de circuitería interna para elevar la señal cruda del soporte físico a nivel de línea, indispensable para su inyección directa a la interfaz de captura del ordenador</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene preamplificador integrado</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneRegulacionIntensidad -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneRegulacionIntensidad">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Iluminacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Disponibilidad de un atenuador o dimmer integrado para controlar de forma progresiva el porcentaje de potencia de salida de los diodos, permitiendo ajustar la exposición sin alterar la distancia física del foco</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene regulación de intensidad</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneRetroalimentacionVisualDinamica -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneRetroalimentacionVisualDinamica">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ControladorRealizacion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Presencia de paneles visuales bajo los interruptores o en el chasis para mostrar iconos personalizables que cambian reflejando el estado en tiempo real de la función asignada</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene retroalimentación visual dinámica</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneSuperficieNoPorosa -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneSuperficieNoPorosa">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#UtillajeMezcla"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Condición física del material de contacto que impide la absorción capilar de los pigmentos líquidos, requisito ineludible para garantizar la recuperación total del color preparado y permitir una limpieza por arrastre sin dejar manchas residuales</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene superficie no porosa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneTrackingAutomatico -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tieneTrackingAutomatico">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorVideo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indicador sobre la capacidad del hardware para autoajustar la alineación del cabezal con las pistas magnéticas diagonales, minimizando el ruido visual sin intervención manual</rdfs:comment>
        <rdfs:label xml:lang="es">Tiene tracking automático</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tipoDeMedioAuxiliar -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tipoDeMedioAuxiliar">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#MedioAuxiliar"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Se especifica el nombre autorizado del medio auxiliar en cuestión</rdfs:comment>
        <rdfs:label xml:lang="es">Tipo de medio auxiliar</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tipoSoporteObjetivo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tipoSoporteObjetivo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SoporteObjetivo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Naturaleza del elemento a personalizar, camiseta, taza…</rdfs:comment>
        <rdfs:label xml:lang="es">Tipo de soporte objetivo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tipoTransductor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tipoTransductor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Microfono"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Tecnología interna de conversión acústico-eléctrica que determina la respuesta en frecuencias y la sensibilidad general del equipo, ej. Condensador, Dinámico</rdfs:comment>
        <rdfs:label xml:lang="es">Tipo de transductor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tiposCintaAdmitidos -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tiposCintaAdmitidos">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorCasete"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Niveles de polarización y ecualización soportados por el cabezal de lectura según la formulación de la cinta magnética, ej. Tipo I Normal, Tipo II Cromo, Tipo IV Metal</rdfs:comment>
        <rdfs:label xml:lang="es">Tipos de cinta admitidos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#titulacionEnCurso -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#titulacionEnCurso">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Estudiante"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Programa académico oficial en el que está matriculado el alumno, un dato muy útil para que el taller pueda priorizar el uso de ciertas máquinas hacia estudiantes de ingenierías o bellas artes durante las épocas de entregas finales</rdfs:comment>
        <rdfs:label xml:lang="es">Titulación en curso</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#toleraLentesOftalmicas -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#toleraLentesOftalmicas">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#SeguimientoOcular"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Capacidad del algoritmo de visión artificial y del filtrado de espectro infrarrojo para descartar reflejos especulares y aberraciones ópticas provocadas por gafas graduadas o lentes de contacto sin comprometer la calibración del modelo biométrico del ojo</rdfs:comment>
        <rdfs:label xml:lang="es">Tolera lentes oftálmicas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tonalidadCromatica -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tonalidadCromatica">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Filamento3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Pigmentación integrada en la matriz del polímero durante su fabricación, atributo visual ineludible para la distinción de existencias en el inventario y la asignación estética del material en proyectos de prototipado rápido o piezas finales, ej. Rojo, Blanco mate, Negro</rdfs:comment>
        <rdfs:label xml:lang="es">Tonalidad cromática</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#tonalidadIncrustacion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#tonalidadIncrustacion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#FondoCromatico"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Espectro cromático dominante de la superficie diseñado para ofrecer el máximo contraste con los tonos de piel humanos y el vestuario, facilitando la transparencia por software, ej. Verde, Azul</rdfs:comment>
        <rdfs:label xml:lang="es">Tonalidad de incrustación</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#velocidadCorteMaxima -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#velocidadCorteMaxima">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CortadoraVinilo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Límite máximo de desplazamiento lineal simultáneo del cabezal operativo y los rodillos de tracción, expresado habitualmente en milímetros por segundo, crítico para estimar la eficiencia temporal y el rendimiento productivo de la máquina frente a tiradas extensas o trazados vectoriales de alta densidad</rdfs:comment>
        <rdfs:label xml:lang="es">Velocidad de corte máxima</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#velocidadLecturaMaxima -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#velocidadLecturaMaxima">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#RecuperacionSoporteDigital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Tasa límite de transferencia de datos desde el soporte extraíble a la estación de trabajo, determinante para calcular tiempos de extracción en copias de seguridad de gran volumen, ej. 52x, 500 KB/s</rdfs:comment>
        <rdfs:label xml:lang="es">Velocidad de lectura máxima</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#velocidadesReproduccion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#velocidadesReproduccion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorVinilo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Tasas de rotación soportadas mecánicamente por el motor del giradiscos para asegurar la lectura adecuada de distintos formatos históricos, ej. 33, 45, 78 RPM</rdfs:comment>
        <rdfs:label xml:lang="es">Velocidades de reproducción</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#velocidadesReproduccionSoportadas -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#velocidadesReproduccionSoportadas">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#LectorVideo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Modos de arrastre de la cinta magnética admitidos por el tambor de lectura, esenciales para recuperar grabaciones de larga duración, ej. SP, LP, EP</rdfs:comment>
        <rdfs:label xml:lang="es">Velocidades de reproducción soportadas</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#voltajeOperativoLogico -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#voltajeOperativoLogico">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PlacaDesarrollo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Nivel de tensión eléctrica estandarizada a la que operan los circuitos integrados y buses de datos de la placa, crítico para garantizar la compatibilidad electrónica directa con módulos de sensores externos sin requerir la intercalación de conversores lógicos de nivel, ej. 3.3V, 5V</rdfs:comment>
        <rdfs:label xml:lang="es">Voltaje operativo lógico</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#volumenImpresion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#volumenImpresion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Impresora3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Dimensiones máximas del área de trabajo admitidas por la máquina, expresadas en milímetros (ej. 220x220x250)</rdfs:comment>
        <rdfs:label xml:lang="es">Volumen de impresión</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#volumenMaximoEscaneo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#volumenMaximoEscaneo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Escaner3D"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Dimensiones físicas límite o área máxima de barrido que el sensor es capaz de procesar para generar una malla tridimensional cerrada, habitualmente expresado en milímetros</rdfs:comment>
        <rdfs:label xml:lang="es">Volumen máximo de escaneo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#AccesorioBrazoHerramientaRotativa -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#AccesorioBrazoHerramientaRotativa">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Otros"/>
        <rdfs:comment xml:lang="es">Brazos flexibles extensores y adaptadores para control espacial de profundidad</rdfs:comment>
        <rdfs:label xml:lang="es">Accesorio de brazo para herramienta rotativa</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#AcondicionamientoEstudio -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#AcondicionamientoEstudio">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Streaming"/>
        <rdfs:comment xml:lang="es">Estructuras pasivas para el aislamiento y modificación del entorno visual</rdfs:comment>
        <rdfs:label xml:lang="es">Acondicionamiento de estudio</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#AdaptadoresPrensa -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#AdaptadoresPrensa">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CorteEstampadoVinilo"/>
        <rdfs:comment xml:lang="es">Módulos térmicos intercambiables para intervención sobre superficies curvas y cerámicas</rdfs:comment>
        <rdfs:label xml:lang="es">Adaptadores de prensa</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Administradores -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Administradores">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Usuario"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#emiteAviso"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#IncidenciaTecnica"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Operadores con privilegios de administración, mantenimiento y control de inventario</rdfs:comment>
        <rdfs:label xml:lang="es">Administradores</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraFotografias -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraFotografias">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Fotografia"/>
        <rdfs:comment xml:lang="es">Cámaras de distintas tecnologías para tomar fotografía y vídeo</rdfs:comment>
        <rdfs:label xml:lang="es">Cámara de fotografías</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraWeb -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraWeb">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoVideo"/>
        <rdfs:comment xml:lang="es">Dispositivos de captura de imagen en alta resolución y tasa de fotogramas</rdfs:comment>
        <rdfs:label xml:lang="es">Cámara web</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#ComunidadUniversitaria -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#ComunidadUniversitaria">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Usuario"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#solicitaPrestamo"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EventoPrestamo"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#superaTaller"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#TallerFormativo"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Usuarios finales vinculados institucionalmente con capacidades de uso, reserva y préstamo</rdfs:comment>
        <rdfs:label xml:lang="es">Comunidad universitaria</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Consumible -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Consumible">
        <rdfs:comment xml:lang="es">Materiales fungibles y sustratos de transformación sujetos a desgaste, alteración física y reposición periódica</rdfs:comment>
        <rdfs:label xml:lang="es">Consumible</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#ControladorRealizacion -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#ControladorRealizacion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PerifericoVideo"/>
        <rdfs:comment xml:lang="es">Superficies de macros y atajos, como el Stream Deck</rdfs:comment>
        <rdfs:label xml:lang="es">Controlador de realización</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#CortadoraVinilo -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#CortadoraVinilo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CorteEstampadoVinilo"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#seOperaMediante"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorEstacionTrabajo"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#seccionaVinilo"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ViniloCorte"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Plotters vectoriales para alteración geométrica de sustratos flexibles</rdfs:comment>
        <rdfs:label xml:lang="es">Cortadora de vinilo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#CorteEstampadoVinilo -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#CorteEstampadoVinilo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:comment xml:lang="es">Sistemas de seccionado vectorial en vinilo transferible</rdfs:comment>
        <rdfs:label xml:lang="es">Corte y estampado de vinilo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#CorteLaser -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#CorteLaser">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#seOperaMediante"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorEstacionTrabajo"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#seccionaPlancha"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#PlanchaRigida"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Sistemas de seccionado y grabado por haz de luz concentrada. Se recomienda encarecidamente el uso de gafas de protección durante el uso de este equipo.</rdfs:comment>
        <rdfs:label xml:lang="es">Corte láser</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Digitalizacion -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Digitalizacion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:comment xml:lang="es">Sistemas de captura, escaneo y preservación de formatos</rdfs:comment>
        <rdfs:label xml:lang="es">Digitalización</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizacionAnalogica -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizacionAnalogica">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Digitalizacion"/>
        <rdfs:comment xml:lang="es">Unidades de transcodificación de soportes obsoletos</rdfs:comment>
        <rdfs:label xml:lang="es">Digitalización analógica</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorAudio -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorAudio">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizacionAnalogica"/>
        <rdfs:comment xml:lang="es">Equipos de ingesta de señales sonoras analógicas</rdfs:comment>
        <rdfs:label xml:lang="es">Digitalizador de audio</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorFotografico -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorFotografico">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizacionAnalogica"/>
        <rdfs:comment xml:lang="es">Escáneres de luz transmitida para material fotosensible</rdfs:comment>
        <rdfs:label xml:lang="es">Digitalizador fotográfico</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorVideo -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizadorVideo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#DigitalizacionAnalogica"/>
        <rdfs:comment xml:lang="es">Sistemas de captura de imagen en movimiento sobre soporte magnético</rdfs:comment>
        <rdfs:label xml:lang="es">Digitalizador de vídeo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#DocenteInvestigador -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#DocenteInvestigador">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#ComunidadUniversitaria"/>
        <rdfs:comment xml:lang="es">Personal docente e investigador de la Universidad</rdfs:comment>
        <rdfs:label xml:lang="es">Docente investigador</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Dron -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Dron">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#CamaraFotografias"/>
        <rdfs:comment xml:lang="es">Vehículos aéreos no tripulados para captura audiovisual y fotogrametría</rdfs:comment>
        <rdfs:label xml:lang="es">Dron</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Encuadernacion -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Encuadernacion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento"/>
        <rdfs:comment xml:lang="es">Maquinaria manual para el postprocesado, ajuste y consolidación física de proyectos impresos</rdfs:comment>
        <rdfs:label xml:lang="es">Encuadernación</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Equipamiento">
        <rdfs:comment xml:lang="es">Infraestructura tecnológica, hardware e instrumental del centro</rdfs:comment>
        <rdfs:label xml:lang="es">Equipamiento</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Escaner3D -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Escaner3D">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Digitalizacion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#seOperaMediante"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#OrdenadorEstacionTrabajo"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Dispositivos de captura volumétrica y mallas poligonales</rdfs:comment>
        <rdfs:label xml:lang="es">Escáner 3D</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerCenital -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerCenital">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerDocumental"/>
        <rdfs:comment xml:lang="es">Sistemas de captura aérea para libros y volúmenes históricos</rdfs:comment>
        <rdfs:label xml:lang="es">Escáner cenital</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerDiapositivas -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerDiapositivas">
