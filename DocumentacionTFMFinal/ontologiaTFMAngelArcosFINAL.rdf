        <rdfs:comment xml:lang="es">Sistemas ópticos adaptados para soportes fotográficos positivos enmarcados</rdfs:comment>
        <rdfs:label xml:lang="es">Escáner de diapositivas</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerDocumental -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerDocumental">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Digitalizacion"/>
        <rdfs:comment xml:lang="es">Sistemas de digitalización bidimensional para soportes impresos físicos</rdfs:comment>
        <rdfs:label xml:lang="es">Escáner documental</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerRodillo -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerRodillo">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#EscanerDocumental"/>
        <rdfs:comment xml:lang="es">Escáneres de alimentación continua para alto volumen de folios</rdfs:comment>
        <rdfs:label xml:lang="es">Escáner de rodillo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#EstacionSoldadura -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#EstacionSoldadura">
