        <rdfs:label xml:lang="es">Estación de soldadura</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Estudiante -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Estudiante">
