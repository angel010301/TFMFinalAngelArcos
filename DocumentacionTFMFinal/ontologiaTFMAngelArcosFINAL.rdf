        <rdfs:label xml:lang="es">Gafas VR</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Gestion -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Gestion">
        <rdfs:label xml:lang="es">Gestión</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#Guillotina -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#Guillotina">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/bibliomaker#Encuadernacion"/>
        <rdfs:comment xml:lang="es">Sistemas mecánicos de cizallado por palanca para el seccionado preciso y escuadrado de bloques de papel</rdfs:comment>
        <rdfs:label xml:lang="es">Guillotina</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2026/bibliomaker#HerramientaRotativa -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/bibliomaker#HerramientaRotativa">
